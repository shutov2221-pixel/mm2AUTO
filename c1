-- 1. СКАН ДАННЫХ В REPLICATEDSTORAGE / PLAYERS / WORKSPACE
-- =====================================================================
local function RunDataScan()
    AddLog("=== НАЧАЛО СКАНИРОВАНИЯ ДАННЫХ ИГРЫ ===", "INFO")

    local foundCount = 0

    -- 1. Поиск по ReplicatedStorage
    AddLog("1. Поиск объектов Assassin в ReplicatedStorage...", "INFO")
    for _, item in ipairs(ReplicatedStorage:GetDescendants()) do
        local lowerName = string.lower(item.Name)
        if string.find(lowerName, "target") or string.find(lowerName, "assassin") or string.find(lowerName, "round") or string.find(lowerName, "role") then
            foundCount = foundCount + 1
            local valInfo = ""
            if item:IsA("ValueBase") then
                valInfo = " = " .. tostring((item :: any).Value)
            end
            AddLog(string.format("RS -> %s (%s)%s", item.Name, item.ClassName, valInfo), "DATA")
        end
    end

    -- 2. Поиск атрибутов у игроков
    AddLog("2. Проверка атрибутов игроков...", "INFO")
    local myAttrs = LocalPlayer:GetAttributes()
    local myAttrList = {}
    for k, v in pairs(myAttrs) do
        table.insert(myAttrList, string.format("%s=%s", tostring(k), tostring(v)))
    end
    if #myAttrList > 0 then
        AddLog("Мои атрибуты: " .. table.concat(myAttrList, ", "), "OK")
    else
        AddLog("У LocalPlayer нет активных атрибутов", "WARN")
    end

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            local pAttrs = plr:GetAttributes()
            for k, v in pairs(pAttrs) do
                local kLower = string.lower(tostring(k))
                if string.find(kLower, "target") or string.find(kLower, "assassin") or string.find(kLower, "role") then
                    AddLog(string.format("Атрибут %s: %s=%s", plr.DisplayName, tostring(k), tostring(v)), "OK")
                    foundCount = foundCount + 1
                end
            end
        end
    end

    AddLog(string.format("=== СКАН ЗАВЕРШЕН. Найдено записей: %d ===", foundCount), "SUCCESS")
end

BtnScanData.MouseButton1Click:Connect(RunDataScan)

