-- 3. АНАЛИЗ СКРИПТОВ, ИЗМЕНЯЮЩИХ TARGETNAME (UPVALUES & CONNECTIONS)
-- =====================================================================
local function RunScriptAnalysis()
    AddLog("=== АНАЛИЗ КЛИЕНТСКИХ СКРИПТОВ ASSASSIN ===", "INFO")

    local pGui = LocalPlayer:FindFirstChildOfClass("PlayerGui") or LocalPlayer:FindFirstChild("PlayerGui")
    if not pGui then
        AddLog("PlayerGui не найден!", "ERROR")
        return
    end

    local targetLabel = pGui:FindFirstChild("TargetName", true)
    if not targetLabel or not targetLabel:IsA("TextLabel") then
        AddLog("TargetName не найден в PlayerGui!", "WARN")
        return
    end

    AddLog("Найден элемент: " .. targetLabel:GetFullName(), "OK")
    AddLog(string.format("Статус: Text='%s', Visible=%s, Parent.Visible=%s", 
        targetLabel.Text, 
        tostring(targetLabel.Visible), 
        tostring(targetLabel.Parent and (targetLabel.Parent :: any).Visible)), "DATA")

    -- Проверка подключений к событию смены текста
    local getconns = getconnections or (debug and (debug :: any).getconnections)
    if not getconns then
        AddLog("Функция getconnections не поддерживается вашим инжектором.", "WARN")
    else
        local conns = getconns(targetLabel:GetPropertyChangedSignal("Text"))
        AddLog(string.format("Подключений к TextChanged: %d", #conns), "INFO")

        for idx, c in ipairs(conns) do
            local fn = c.Function
            AddLog(string.format("Соединение #%d: %s", idx, tostring(fn)), "OK")

            local getups = getupvalues or (debug and (debug :: any).getupvalues)
            if getups and fn then
                local success, ups = pcall(function() return getups(fn) end)
                if success and ups then
                    AddLog("Внутренние переменные функции (Upvalues):", "DATA")
                    for uKey, uVal in pairs(ups) do
                        AddLog(string.format("  -> [%s] (%s) = %s", tostring(uKey), type(uVal), FormatArgument(uVal)), "DATA")
                    end
                end
            end
        end
    end

    -- Сканирование скриптов внутри MainGUI.Game
    local mGui = pGui:FindFirstChild("MainGUI")
    local gameFolder = mGui and mGui:FindFirstChild("Game")
    if gameFolder then
        AddLog("Скрипты внутри MainGUI.Game:", "INFO")
        for _, sc in ipairs(gameFolder:GetDescendants()) do
            if sc:IsA("LocalScript") or sc:IsA("ModuleScript") then
                AddLog(string.format("  * %s (%s)", sc.Name, sc.ClassName), "OK")
            end
        end
    end

    AddLog("=== АНАЛИЗ СКРИПТОВ ЗАВЕРШЕН ===", "SUCCESS")
end

BtnInspectScript.MouseButton1Click:Connect(RunScriptAnalysis)

