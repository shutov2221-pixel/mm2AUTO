local function Terminate()
    if isTerminated then return end
    isTerminated = true

    StopSniffer()

    for _, conn in ipairs(generalConnections) do
        if conn and conn.Connected then pcall(function() conn:Disconnect() end) end
    end
    table.clear(generalConnections)

    if ScreenGui and ScreenGui.Parent then
        ScreenGui:Destroy()
    end
    print("[MM2 SPY SCAN1] Завершено.")
end

