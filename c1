-- 2. СНИФФЕР СЕТИ (REMOTE EVENTS & REMOTE FUNCTIONS)
-- =====================================================================
local isSniffing = false

local function StopSniffer()
    isSniffing = false
    for _, conn in ipairs(remoteConnections) do
        if conn and conn.Connected then pcall(function() conn:Disconnect() end) end
    end
    table.clear(remoteConnections)
    BtnSniffRemotes.Text = "📡 2. СНИФФЕР [ВЫКЛ]"
    BtnSniffRemotes.BackgroundColor3 = Color3.fromRGB(150, 45, 45)
    AddLog("Сниффер пакетов остановлен", "WARN")
end

local function StartSniffer()
    if isSniffing then
        StopSniffer()
        return
    end

    isSniffing = true
    BtnSniffRemotes.Text = "📡 2. СНИФФЕР [АКТИВЕН]"
    BtnSniffRemotes.BackgroundColor3 = Color3.fromRGB(40, 180, 80)
    AddLog("Установка перехватов на RemoteEvents в ReplicatedStorage...", "INFO")

    local hooksInstalled = 0
    for _, obj in ipairs(ReplicatedStorage:GetDescendants()) do
        if obj:IsA("RemoteEvent") then
            local rName = string.lower(obj.Name)
            -- Перехватываем всё, что может быть связано с игрой, раундом, ролями, таргетами
            if string.find(rName, "game") or string.find(rName, "round") or string.find(rName, "target") 
               or string.find(rName, "role") or string.find(rName, "player") or string.find(rName, "event") 
               or string.find(rName, "kill") or string.find(rName, "match") or string.find(rName, "assassin") then
                
                hooksInstalled = hooksInstalled + 1
                local conn = obj.OnClientEvent:Connect(function(...)
                    local args = {...}
                    local formattedArgs = {}
                    for i, arg in ipairs(args) do
                        table.insert(formattedArgs, string.format("#%d: %s", i, FormatArgument(arg)))
                    end
                    local fullMsg = string.format("RE [%s] -> %s", obj.Name, table.concat(formattedArgs, " | "))
                    AddLog(fullMsg, "PACKET")
                end)
                table.insert(remoteConnections, conn)
            end
        end
    end

    AddLog(string.format("Сниффер активен! Установлено ловушек: %d. Ждём события раунда...", hooksInstalled), "SUCCESS")
end

BtnSniffRemotes.MouseButton1Click:Connect(StartSniffer)

