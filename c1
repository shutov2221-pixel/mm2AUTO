-- Хелпер для дампа таблиц
local function DumpTableRecursive(tbl: { [any]: any }, depth: number, maxDepth: number, visited: { [any]: boolean }): string
    if depth > maxDepth then return "{...}" end
    if visited[tbl] then return "{circular...}" end
    visited[tbl] = true

    local parts = {}
    for k, v in pairs(tbl) do
        local keyStr = tostring(k)
        local valStr = ""
        if type(v) == "table" then
            valStr = DumpTableRecursive(v, depth + 1, maxDepth, visited)
        elseif type(v) == "string" then
            valStr = string.format("%q", v)
        else
            valStr = tostring(v)
        end
        table.insert(parts, string.format("%s: %s", keyStr, valStr))
    end
    return "{" .. table.concat(parts, ", ") .. "}"
end

local function FormatArgument(arg: any): string
    if type(arg) == "table" then
        return DumpTableRecursive(arg, 1, 3, {})
    elseif type(arg) == "string" then
        return string.format("%q", arg)
    else
        return tostring(arg)
    end
end

