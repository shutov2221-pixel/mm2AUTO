local function AddLog(msg: string, msgType: string?)
    if isTerminated then return end
    logCount = logCount + 1

    local color = Color3.fromRGB(210, 210, 210)
    local prefix = "[INFO]"

    if msgType == "SUCCESS" or msgType == "OK" then
        color = Color3.fromRGB(100, 255, 130)
        prefix = "[OK]"
    elseif msgType == "ERROR" or msgType == "ERR" then
        color = Color3.fromRGB(255, 80, 80)
        prefix = "[ERR]"
    elseif msgType == "WARN" then
        color = Color3.fromRGB(255, 185, 60)
        prefix = "[WARN]"
    elseif msgType == "PACKET" then
        color = Color3.fromRGB(255, 110, 220)
        prefix = "[PACKET]"
    elseif msgType == "DATA" then
        color = Color3.fromRGB(80, 200, 255)
        prefix = "[DATA]"
    end

    local timeStr = os.date("%H:%M:%S")
    local lineText = string.format("%s %s %s", timeStr, prefix, msg)
    logStringBuffer = logStringBuffer .. lineText .. "\n"

    local lbl = Instance.new("TextLabel", LogContainer)
    lbl.Size = UDim2.new(1, -8, 0, 0)
    lbl.AutomaticSize = Enum.AutomaticSize.Y
    lbl.BackgroundTransparency = 1
    lbl.Text = lineText
    lbl.TextColor3 = color
    lbl.Font = Enum.Font.Code
    lbl.TextSize = 10
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.TextWrapped = true
    lbl.LayoutOrder = logCount

    task.defer(function()
        if LogContainer and LogContainer.Parent then
            LogContainer.CanvasSize = UDim2.new(0, 0, 0, LogLayout.AbsoluteContentSize.Y + 10)
            LogContainer.CanvasPosition = Vector2.new(0, 999999)
        end
    end)
end

