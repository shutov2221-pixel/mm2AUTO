-- === РЕАКТИВНАЯ ПРОВЕРКА МОНЕТЫ (НА ОСНОВЕ BENCHMARK-ПОБЕДИТЕЛЕЙ) ===
-- Опирается только на два быстрейших события сервера:
-- 1. Удаление монеты из CoinContainer (CoinContainer.ChildRemoved)
-- 2. Удаление TouchTransmitter из самой монеты (TouchTransmitter Removed)
local function isCoinCollectedByServer(coin)
    if not coin then return true end
    if not rt or not rt.coinContainer then return true end
    if coin.Parent ~= rt.coinContainer then return true end
    if not coin:FindFirstChildWhichIsA("TouchTransmitter") then return true end
    return false
end

-- === ПЕРЕДВИЖЕНИЕ И РЕАКТИВНЫЙ СБОР МОНЕТ (0 МС ЗАДЕРЖКИ) ===
local function moveToPositionPhysically(targetPosition, targetCoin, bv, bg)
    local char = rt:Character()
    if not char or not char.PrimaryPart then return false end

    local hrp = char.PrimaryPart
    local underfloorOffset = SETTINGS.UnderfloorOffset or 3.8
    local finalPosition = targetPosition - Vector3.new(0, underfloorOffset, 0)

    local startPos = hrp.Position
    local lookAtPos = Vector3.new(finalPosition.X, startPos.Y, finalPosition.Z)
    if (lookAtPos - startPos).Magnitude > 0.1 then
        bg.CFrame = CFrame.new(startPos, lookAtPos) * CFrame.Angles(math.rad(-90), 0, 0)
    end

    local flyStart = tick()

    while not IsTerminated and SETTINGS.AutoFarmEnabled and char and char.PrimaryPart and CurrentState == State.Action do
        if tick() - flyStart > 6 then break end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum and hum.Health <= 0 then break end

        -- Если монету забрал другой игрок/читер во время полёта — мгновенный сброс цели (0 мс)
        if isCoinCollectedByServer(targetCoin) then
            break
        end

        local currentPos = hrp.Position
        local distance = (finalPosition - currentPos).Magnitude

        if distance < 1.5 then
            bv.Velocity = Vector3.zero

            local collected = isCoinCollectedByServer(targetCoin)

            if not collected then
                local thread = coroutine.running()
                local connTT = nil
                local connCoin = nil
                local timeoutTask = nil

                local function onServerConfirmed()
                    if connTT then connTT:Disconnect(); connTT = nil end
                    if connCoin then connCoin:Disconnect(); connCoin = nil end
                    collected = true
                    if coroutine.status(thread) == "suspended" then
                        task.spawn(thread)
                    end
                end

                -- 1. Реактивный слушатель: удаление TouchTransmitter (Победитель бенчмарка #1)
                local tt = targetCoin:FindFirstChildWhichIsA("TouchTransmitter")
                if tt then
                    connTT = tt.AncestryChanged:Connect(function(_, parent)
                        if parent == nil or parent ~= targetCoin then
                            onServerConfirmed()
                        end
                    end)
                end

                -- 2. Реактивный слушатель: удаление из CoinContainer (Победитель бенчмарка #2)
                connCoin = targetCoin.AncestryChanged:Connect(function(_, parent)
                    if parent == nil or (rt.coinContainer and parent ~= rt.coinContainer) then
                        onServerConfirmed()
                    end
                end)

                -- Мгновенный импульс касания хитбокса
                local touchFn = firetouchtransmitter or firetouchinterest or (syn and syn.firetouchinterest)
                if touchFn then
                    local touchPart = char:FindFirstChild("Head") or hrp
                    pcall(function()
                        touchFn(touchPart, targetCoin, 0)
                        touchFn(touchPart, targetCoin, 1)
                        if touchPart ~= hrp then
                            touchFn(hrp, targetCoin, 0)
                            touchFn(hrp, targetCoin, 1)
                        end
                    end)
                end

                -- Защитный тайм-аут (максимум 0.35 сек вместо старых 1.5 сек с циклами task.wait)
                timeoutTask = task.delay(0.35, function()
                    if connTT then connTT:Disconnect(); connTT = nil end
                    if connCoin then connCoin:Disconnect(); connCoin = nil end
                    if coroutine.status(thread) == "suspended" then
                        task.spawn(thread)
                    end
                end)

                -- Засыпаем до момента репликации пакета от сервера
                coroutine.yield()

                if connTT then connTT:Disconnect() end
                if connCoin then connCoin:Disconnect() end
                if not collected then
                    collected = isCoinCollectedByServer(targetCoin)
                end
            end

            return collected
        end

        local direction = (finalPosition - currentPos).Unit
        bv.Velocity = direction * SETTINGS.Speed

        RunService.Heartbeat:Wait()
    end
    return false
end

-- === ЛОГИКА СБОРА МОНЕТ ===
local function ChangeState(newState) CurrentState = newState end

local function CollectCoins()
    Working = true
    CurrentRoundCoins = 0
    BagIsFull = false

    local map = rt:Map()
    if map then
        rt.coinContainer = map:FindFirstChild("CoinContainer")
        PopulateCoins()

        if rt.coinContainer then
            if rt.ancestryConn then
                rt.ancestryConn:Disconnect()
                rt.ancestryConn = nil
            end
            rt.ancestryConn = rt.coinContainer.AncestryChanged:Connect(function(_, parent)
                if not parent then
                    rt.coinContainer = nil
                    if rt.ancestryConn then
                        rt.ancestryConn:Disconnect()
                        rt.ancestryConn = nil
                    end
                end
            end)
        end
    end

    local char = rt:Character()
    local hrp = char and char.PrimaryPart
    local hum = char and char:FindFirstChild("Humanoid")

    if not char or not hrp then return end
    
    updateBodyPartsCache() 
    
    if hum then hum.PlatformStand = true end

    local bv = hrp:FindFirstChild("FarmVelocity") or Instance.new("BodyVelocity")
    bv.Name = "FarmVelocity"
    bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
    bv.Velocity = Vector3.zero
    bv.Parent = hrp

    local bg = hrp:FindFirstChild("FarmGyro") or Instance.new("BodyGyro")
    bg.Name = "FarmGyro"
    bg.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
    bg.P = 3000
    bg.Parent = hrp

    while not IsTerminated and CurrentState == State.Action and SETTINGS.AutoFarmEnabled and not BagIsFull and rt:CheckIfPlayerWasInARound() do
        char = rt:Character()
        if not char or not char.PrimaryPart then break end

        -- Если контейнер монет потерян/пересоздан во время раунда, переподключаем его
        if not rt.coinContainer or not rt.coinContainer.Parent then
            local currentMap = rt:Map()
            if currentMap then
                rt.coinContainer = currentMap:FindFirstChild("CoinContainer")
                if rt.coinContainer then PopulateCoins() end
            end
        end

        local targetCoin = GetNearestCoin()

        if targetCoin then
            UpdateStatus("Фарм: Лечу к монете", Color3.fromRGB(150, 255, 150))

            markCoinAsPending(targetCoin)

            local pickedUp = moveToPositionPhysically(targetCoin.Position, targetCoin, bv, bg)
            if not SETTINGS.AutoFarmEnabled or IsTerminated then break end

            if pickedUp and rt.touchedCoins[targetCoin] == "pending" then
                rt.touchedCoins[targetCoin] = "collected"

                if IsBagFull() then
                    UpdateStatus("Фарм: Сохранение последней монеты...", Color3.fromRGB(255, 200, 50))
                    task.wait(math.random(6, 12) / 10)
                    break
                end
            end
        else
            UpdateStatus("Фарм: Поиск монет...", Color3.fromRGB(200, 200, 100))
            bv.Velocity = Vector3.zero
            task.wait(0.1)
        end
    end

    if bv and bv.Parent then bv:Destroy() end
    if bg and bg.Parent then bg:Destroy() end
    if hrp then
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
    end
    if hum then hum.PlatformStand = false end

    AutoFarmCleanUp()
end

-- === ОСНОВНОЕ ДЕЙСТВИЕ В РАУНДЕ (ЗАЧИСТКА -> ФАРМ -> ОБРАБОТКА СУМКИ) ===
local function ActionState()
    -- 1. Предварительная зачистка (только в режиме Assassin)
    if SETTINGS.GameType == "Assassin" and SETTINGS.AutoFarmEnabled and not IsTerminated and RoundInProgress() and rt:CheckIfPlayerWasInARound() then
        PreRoundKillChain()
    end

    if not SETTINGS.AutoFarmEnabled or IsTerminated then return end

    -- 2. Затем начинаем сбор монет (если раунд ещё продолжается и персонаж жив)
    if RoundInProgress() and rt:CheckIfPlayerWasInARound() then
        CollectCoins()
    end

    if not SETTINGS.AutoFarmEnabled or IsTerminated then return end

    -- 3. Действия при наполнении сумки или завершении раунда
    if BagIsFull then
        -- В Classic при любой роли всегда делаем Reset. KillAll доступен только в Assassin.
        if SETTINGS.GameType == "Assassin" and SETTINGS.BagFullMode == "KillAll" then
            -- Режим Kill All (только в Assassin): достаём нож и через TurboKill добиваем оставшуюся цель, забирая победу
            KillFinalTarget()
            task.wait(0.5)
            BagIsFull = false
            ChangeState(State.WaitingForRoundEnd)
        else
            -- В Classic (или в Assassin при BagFullMode == "Reset"): сброс персонажа при любой роли
            UpdateStatus("Сумка полна: Сброс персонажа", Color3.fromRGB(200, 200, 200))
            ChangeState(State.WaitingForRoundEnd)
            local char = rt:Character()
            if char then
                local hum = char:FindFirstChild("Humanoid")
                if hum then
                    hum.Health = 0
                    hum:ChangeState(Enum.HumanoidStateType.Dead)
                end
                pcall(function() char:BreakJoints() end)
            end
        end
    elseif not RoundInProgress() then
        ChangeState(State.WaitingForRound)
    else
        ChangeState(State.WaitingForRoundEnd)
    end
end

local function WaitingForRound()
    Working = false
    BagIsFull = false
    UpdateStatus("Фарм: Ожидание начала раунда", Color3.fromRGB(150, 150, 150))

    repeat
        task.wait(0.25)
    until (RoundInProgress() and rt:CheckIfPlayerWasInARound()) or not SETTINGS.AutoFarmEnabled or IsTerminated

    if not SETTINGS.AutoFarmEnabled or IsTerminated then return end
    ChangeState(State.Action)
end

local function waitForRoundEnd()
    Working = false
    BagIsFull = false
    UpdateStatus("Фарм: Ожидание конца игры", Color3.fromRGB(255, 150, 50))
    repeat
        task.wait(0.5)
        -- Если раунд уже начался заново (выдан атрибут Alive), сразу переходим к действию
        if rt:CheckIfPlayerWasInARound() then break end
    until not RoundInProgress() or not SETTINGS.AutoFarmEnabled or IsTerminated

    if not SETTINGS.AutoFarmEnabled or IsTerminated then return end
    ChangeState(State.WaitingForRound)
end

