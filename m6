local function AutoFarmCleanUp()
    table.clear(rt.touchedCoins)
    table.clear(rt.cachedCoins)
    if rt.Added then
        rt.Added:Disconnect()
        rt.Added = nil
    end
    if rt.coinRemovedConn then
        rt.coinRemovedConn:Disconnect()
        rt.coinRemovedConn = nil
    end
    if rt.ancestryConn then
        rt.ancestryConn:Disconnect()
        rt.ancestryConn = nil
    end

    -- Очищаем ссылку на старый контейнер карты
    rt.coinContainer = nil

    -- Безопасная очистка отключенных соединений из таблицы ActiveConnections
    for i = #ActiveConnections, 1, -1 do
        local conn = ActiveConnections[i]
        if not conn or not conn.Connected then
            table.remove(ActiveConnections, i)
        end
    end
end

