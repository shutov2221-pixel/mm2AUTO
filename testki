-- СИСТЕМА ОБНАРУЖЕНИЯ ЦЕЛИ (ASSASSIN TARGET SCRAPER)
-- =====================================================================
local function FindTargetLabel(): (TextLabel?, string)
    local pGui = LocalPlayer:FindFirstChildOfClass("PlayerGui") or LocalPlayer:FindFirstChild("PlayerGui")
    if not pGui then return nil, "PlayerGui не найден!" end

    -- 1. Точный путь
    local mGui = pGui:FindFirstChild("MainGUI")
    if mGui then
        local gameObj = mGui:FindFirstChild("Game")
        if gameObj then
            local targetFrame = gameObj:FindFirstChild("AssassinTarget")
            if targetFrame then
                local label = targetFrame:FindFirstChild("TargetName")
                if label and label:IsA("TextLabel") then
                    return label, "MainGUI.Game.AssassinTarget.TargetName"
                end
            end
        end
    end

    -- 2. Резервный поиск
    local altFrame = pGui:FindFirstChild("AssassinTarget", true)
    if altFrame then
        local label = altFrame:FindFirstChild("TargetName")
        if label and label:IsA("TextLabel") then
            return label, altFrame:GetFullName() .. ".TargetName"
        end
    end

    local anyLabel = pGui:FindFirstChild("TargetName", true)
    if anyLabel and anyLabel:IsA("TextLabel") then
        return anyLabel, anyLabel:GetFullName()
    end

    return nil, "TargetName не найден"
end

local function CleanNickname(raw: string): string
    if not raw then return "" end
    local cleaned = raw
    cleaned = string.gsub(cleaned, "%[", "")
    cleaned = string.gsub(cleaned, "%]", "")
    cleaned = string.gsub(cleaned, "[\"\'%(%)]", "")
    cleaned = string.gsub(cleaned, "^%s*[Tt]arget[:%s]*", "")
    cleaned = string.gsub(cleaned, "^%s*[Ee]liminate[:%s]*", "")
    cleaned = string.gsub(cleaned, "^%s*@?", "")
    cleaned = string.gsub(cleaned, "^%s*(.-)%s*$", "%1")
    return cleaned
end

local function FindPlayerByName(cleanName: string): (Player?, string)
    if cleanName == "" or cleanName == "Label" or cleanName == "None" then
        return nil, "Имя пусто"
    end

    local exact = Players:FindFirstChild(cleanName)
    if exact then return exact, "Точное совпадение Name" end

    local lowerClean = string.lower(cleanName)
    for _, pl in ipairs(Players:GetPlayers()) do
        if pl ~= LocalPlayer then
            if string.lower(pl.Name) == lowerClean then return pl, "lower(Name)" end
            if string.lower(pl.DisplayName) == lowerClean then return pl, "lower(DisplayName)" end
        end
    end

    for _, pl in ipairs(Players:GetPlayers()) do
        if pl ~= LocalPlayer then
            if string.find(string.lower(pl.Name), lowerClean, 1, true) then return pl, "Частичное Name" end
            if string.find(string.lower(pl.DisplayName), lowerClean, 1, true) then return pl, "Частичное DisplayName" end
        end
    end

    return nil, "Не найден онлайн"
end

local function RunTargetScan()
    Log("--- СКАН ТАРГЕТА ASSASSIN ---", "TARGET")
    local label, pathInfo = FindTargetLabel()
    if not label then
        Log("ОШИБКА: " .. pathInfo, "ERROR")
        UpdateStatus("TargetName не найден", Color3.fromRGB(255, 80, 80))
        return nil
    end

    local rawText = label.Text
    local cleaned = CleanNickname(rawText)
    Log(string.format("UI текст: '%s' -> Цель: '%s'", rawText, cleaned), "TARGET")

    if cleaned == "" or cleaned == "Label" or cleaned == "None" then
        Log("Цель отсутствует в UI (раунд не начался или цель меняется)", "WARN")
        UpdateStatus("Цель отсутствует", Color3.fromRGB(255, 180, 50))
        return nil
    end

    local player, match = FindPlayerByName(cleaned)
    if not player then
        Log("Игрок не найден: " .. match, "ERROR")
        UpdateStatus("Игрок не найден", Color3.fromRGB(255, 100, 100))
        return nil
    end

    local char = player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local hp = hum and hum.Health or 0
    Log(string.format("НАЙДЕН ТАРГЕТ: %s (@%s) [HP: %d]", player.DisplayName, player.Name, math.floor(hp)), "SUCCESS")
    UpdateStatus("Таргет: " .. player.DisplayName .. " (HP: " .. math.floor(hp) .. ")", Color3.fromRGB(100, 255, 100))
    return player
end

