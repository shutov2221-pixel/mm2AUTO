local function BindClick(btn: TextButton, callback: () -> ())
    local debounce = false
    local function fire()
        if debounce or isTerminated then return end
        debounce = true
        task.spawn(callback)
        task.wait(0.12)
        debounce = false
    end
    btn.Activated:Connect(fire)
    btn.MouseButton1Click:Connect(fire)
end

