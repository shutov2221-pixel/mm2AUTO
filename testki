BindClick(BtnKill, StartKillLoop)
BindClick(BtnBatch, RunBatchKillAll)
BindClick(BtnClear, ClearLogs)
BindClick(ToggleBtn, function() SetLogsCollapsed(not isLogsCollapsed) end)
BindClick(BtnToggleLogs, function() SetLogsCollapsed(not isLogsCollapsed) end)

local function Terminate()
    if isTerminated then return end
    isTerminated = true
    isRunning = false

    for _, conn in ipairs(activeConnections) do
        if conn and conn.Connected then pcall(function() conn:Disconnect() end) end
    end
    table.clear(activeConnections)

    if LocalPlayer.Character then
        local hrp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart") or LocalPlayer.Character.PrimaryPart
        DisableFlight(hrp)
    end

    if ScreenGui and ScreenGui.Parent then ScreenGui:Destroy() end
    print("[MM2 ASSASSIN] Скрипт выгружен.")
end

