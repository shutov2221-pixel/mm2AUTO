local function InspectAssassinData()
    Log("--- СНИФФЕР ДАННЫХ ASSASSIN ---", "TARGET")
    local foundData = false

    -- 1. Проверка атрибутов LocalPlayer
    local myAttrs = LocalPlayer:GetAttributes()
    local attrList = {}
    for k, v in pairs(myAttrs) do
        table.insert(attrList, string.format("%s = %s", tostring(k), tostring(v)))
    end
    if #attrList > 0 then
        Log("Атрибуты LocalPlayer: " .. table.concat(attrList, ", "), "INFO")
        foundData = true
    end

    -- 2. Проверка атрибутов остальных игроков (может там виден их Target?)
    local targetAttrFound = false
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            local pAttrs = plr:GetAttributes()
            for k, v in pairs(pAttrs) do
                if string.find(string.lower(tostring(k)), "target") or string.find(string.lower(tostring(k)), "assassin") then
                    Log(string.format("🔥 НАЙДЕН АТРИБУТ У %s: %s = %s", plr.Name, tostring(k), tostring(v)), "SUCCESS")
                    targetAttrFound = true
                end
            end
        end
    end
    if not targetAttrFound then
        Log("Атрибуты Target у других игроков закрыты сервером.", "WARN")
    end

    -- 3. Проверка ReplicatedStorage
    local repAssassin = ReplicatedStorage:FindFirstChild("Assassin") or ReplicatedStorage:FindFirstChild("Game") or ReplicatedStorage:FindFirstChild("Remotes")
    if repAssassin then
        local children = {}
        for _, c in ipairs(repAssassin:GetChildren()) do table.insert(children, c.Name) end
        Log("Объекты в ReplicatedStorage: " .. table.concat(children, ", "), "INFO")
    end

    UpdateStatus("Сниффер завершен (см. консоль)", Color3.fromRGB(180, 220, 255))
end

