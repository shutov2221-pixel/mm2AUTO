-- АВТО-ЦЕПОЧКА ВЫБИВАНИЯ ТАРГЕТОВ (БЕЗ ФРИЗОВ И БЕСКОНЕЧНЫХ ЦИКЛОВ)
-- =====================================================================
local function StopKillLoop()
    isRunning = false
    BtnKill.Text = "⚡ ЦЕПОЧКА (AUTO-CHAIN)"
    BtnKill.BackgroundColor3 = Color3.fromRGB(200, 45, 45)
    UpdateStatus("Цепочка остановлена", Color3.fromRGB(200, 200, 200))
    Log("Авто-цепочка остановлена пользователем", "INFO")
end

local function StartKillLoop()
    if isRunning then
        StopKillLoop()
        return
    end

    isRunning = true
    BtnKill.Text = "⚡ ОСТАНОВИТЬ"
    BtnKill.BackgroundColor3 = Color3.fromRGB(40, 180, 50)
    UpdateStatus("Авто-цепочка активна...", Color3.fromRGB(100, 255, 100))
    Log("--- СТАРТ АВТО-ЦЕПОЧКИ КИЛЛОВ ---", "KILL")

    task.spawn(function()
        InspectAndEquipKnife()
        local noTargetCounter = 0

        while isRunning and not isTerminated do
            -- Гарантированный yield в начале каждого шага для исключения фриза
            task.wait(0.05)

            local myChar = LocalPlayer.Character
            local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")
            if not myChar or not myHum or myHum.Health <= 0 then
                Log("Персонаж погиб — остановка цепочки", "ERROR")
                break
            end

            -- Считываем таргет
            local label = FindTargetLabel()
            local targetPlayer: Player? = nil

            if label then
                local cleanName = CleanNickname(label.Text)
                if cleanName ~= "" and cleanName ~= "Label" and cleanName ~= "None" then
                    targetPlayer = FindPlayerByName(cleanName)
                end
            end

            -- Проверяем, жива ли цель
            local isTargetAlive = false
            if targetPlayer and targetPlayer.Character then
                local hum = targetPlayer.Character:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 then
                    isTargetAlive = true
                end
            end

            if isTargetAlive and targetPlayer then
                noTargetCounter = 0
                InstantKillTarget(targetPlayer)
                -- Пауза после удара, чтобы сервер успел зарегистрировать смерть и передать новый таргет
                task.wait(0.12)
            else
                -- Цель мертва или UI еще обновляется
                noTargetCounter = noTargetCounter + 1
                UpdateStatus(string.format("Ожидание нового таргета (%d/15)", noTargetCounter), Color3.fromRGB(255, 180, 50))

                -- Ждем смены текста в UI до 0.25с
                local textChanged = false
                local conn: RBXScriptConnection? = nil
                if label then
                    conn = label:GetPropertyChangedSignal("Text"):Connect(function() textChanged = true end)
                end

                local waitStart = tick()
                while tick() - waitStart < 0.25 and not textChanged and isRunning do
                    task.wait(0.04)
                end
                if conn then conn:Disconnect() end

                -- Если цели нет более 4 секунд — раунд выигран/завершен
                if noTargetCounter >= 15 then
                    Log("Таргеты закончились! Все цели в раунде устранены.", "SUCCESS")
                    UpdateStatus("Раунд завершен! Победа.", Color3.fromRGB(100, 255, 100))
                    break
                end
            end
        end

        StopKillLoop()
    end)
end

