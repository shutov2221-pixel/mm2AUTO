-- ЭКИПИРОВКА И ПРОВЕРКА НОЖА
-- =====================================================================
local function InspectAndEquipKnife(): Tool?
    local char = LocalPlayer.Character
    if not char then return nil end

    -- 1. Уже в руках?
    for _, item in ipairs(char:GetChildren()) do
        if item:IsA("Tool") and (item.Name == "Knife" or string.find(string.lower(item.Name), "knife")) then
            return item
        end
    end

    -- 2. В рюкзаке?
    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack") or LocalPlayer:FindFirstChild("Backpack")
    if not backpack then return nil end

    local knife: Tool? = nil
    for _, item in ipairs(backpack:GetChildren()) do
        if item:IsA("Tool") and (item.Name == "Knife" or string.find(string.lower(item.Name), "knife")) then
            knife = item
            break
        end
    end
    if not knife then knife = backpack:FindFirstChildOfClass("Tool") end
    if not knife then return nil end

    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then pcall(function() hum:EquipTool(knife) end) end
    if knife.Parent ~= char then pcall(function() knife.Parent = char end) end

    task.wait(0.03)
    return knife
end

-- Полет для телепорт-режима
local function EnableFlight(hrp: BasePart)
    if not hrp or not hrp.Parent then return end
    local bv = hrp:FindFirstChild("KillVelocity") :: BodyVelocity?
    if not bv then
        bv = Instance.new("BodyVelocity")
        bv.Name = "KillVelocity"
        bv.Parent = hrp
    end
    bv.MaxForce = Vector3.new(1e5, 1e5, 1e5)
    bv.Velocity = Vector3.zero
    pcall(function()
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
    end)
end

local function DisableFlight(hrp: BasePart?)
    if not hrp then return end
    local bv = hrp:FindFirstChild("KillVelocity")
    if bv then pcall(function() bv:Destroy() end) end
end

local function EmulateAttackClick(tool: Tool?)
    if tool and tool:IsA("Tool") then pcall(function() tool:Activate() end) end
    if VirtualInputManager then
        pcall(function()
            local cam = Workspace.CurrentCamera
            local center = cam and (cam.ViewportSize / 2) or Vector2.new(400, 300)
            VirtualInputManager:SendMouseButtonEvent(center.X, center.Y, 0, true, game, 0)
            task.wait(0.015)
            VirtualInputManager:SendMouseButtonEvent(center.X, center.Y, 0, false, game, 0)
        end)
    end
end

-- =====================================================================
-- МОМЕНТАЛЬНЫЙ КИЛЛ ЧЕРЕЗ FIRETOUCHINTEREST (INSTANT KILL)
-- =====================================================================
local function FireTouchKill(targetPlayer: Player, knife: Tool): boolean
    local targetChar = targetPlayer.Character
    if not targetChar then return false end

    local targetHRP = targetChar:FindFirstChild("HumanoidRootPart") or targetChar:FindFirstChild("Torso") :: BasePart?
    local targetHum = targetChar:FindFirstChildOfClass("Humanoid")
    local handle = knife:FindFirstChild("Handle") :: BasePart?

    if not targetHRP or not targetHum or targetHum.Health <= 0 or not handle then
        return false
    end

    -- Активируем нож, чтобы сервер включил окно урона (canKill = true)
    pcall(function() knife:Activate() end)

    -- Посылаем физический пакет касания
    if firetouchinterest then
        pcall(function()
            firetouchinterest(targetHRP, handle, 0)
            task.wait(0.015)
            firetouchinterest(targetHRP, handle, 1)
        end)
        return true
    else
        return false
    end
end

-- =====================================================================
-- ОСНОВНОЙ БОЕВОЙ МЕТОД: УБИЙСТВО ТАРГЕТА (FIRETOUCH / TELEPORT)
-- =====================================================================
local function KillTarget(targetPlayer: Player)
    if not targetPlayer or not targetPlayer.Character then return end

    local myChar = LocalPlayer.Character
    if not myChar then return end

    local targetChar = targetPlayer.Character
    local targetHRP = targetChar:FindFirstChild("HumanoidRootPart") or targetChar:FindFirstChild("Torso") :: BasePart?
    local targetHum = targetChar:FindFirstChildOfClass("Humanoid")
    if not targetHRP or not targetHum or targetHum.Health <= 0 then return end

    local knife = InspectAndEquipKnife()
    if not knife then
        Log("Ошибка: Нож отсутствует в руках/рюкзаке!", "ERROR")
        return
    end

    local startTime = tick()
    Log(string.format("Атака цели: %s (@%s) [Режим: %s]", targetPlayer.DisplayName, targetPlayer.Name, killMode), "KILL")
    UpdateStatus("Атака: " .. targetPlayer.DisplayName, Color3.fromRGB(255, 80, 80))

    -- -------------------------------------------------------------
    -- 1. РЕЖИМ FIRETOUCH (МГНОВЕННЫЙ УДАР БЕЗ ТЕЛЕПОРТАЦИИ)
    -- -------------------------------------------------------------
    if killMode == "FIRETOUCH" and firetouchinterest then
        for pulse = 1, 4 do
            if not isRunning or isTerminated then break end
            if not targetHum or targetHum.Health <= 0 then break end

            FireTouchKill(targetPlayer, knife)
            task.wait(0.035)

            -- Проверяем, не сменилась ли цель в UI
            local label = FindTargetLabel()
            if label then
                local currentClean = CleanNickname(label.Text)
                if currentClean ~= "" and string.lower(currentClean) ~= string.lower(targetPlayer.Name) and string.lower(currentClean) ~= string.lower(targetPlayer.DisplayName) then
                    Log("Таргет сменился на '" .. currentClean .. "' — цель засчитана!", "SUCCESS")
                    return
                end
            end
        end

        if not targetHum or targetHum.Health <= 0 then
            local ms = math.floor((tick() - startTime) * 1000)
            Log(string.format("⚡ ЦЕЛЬ УНИЧТОЖЕНА ЗА %d мс! (%s)", ms, targetPlayer.DisplayName), "SUCCESS")
            return
        end
        Log("FireTouch не добил цель, пробую телепорт...", "WARN")
    end

    -- -------------------------------------------------------------
    -- 2. РЕЗЕРВНЫЙ / КЛАССИЧЕСКИЙ РЕЖИМ ТЕЛЕПОРТА ЗА СПИНУ
    -- -------------------------------------------------------------
    local myHRP = myChar:FindFirstChild("HumanoidRootPart") or myChar.PrimaryPart
    if myHRP then EnableFlight(myHRP) end

    local attackStart = tick()
    while isRunning and not isTerminated do
        if tick() - attackStart > 2.5 then
            Log("Таймаут атаки (2.5с) на " .. targetPlayer.Name, "WARN")
            break
        end

        targetHum = targetChar:FindFirstChildOfClass("Humanoid")
        targetHRP = targetChar:FindFirstChild("HumanoidRootPart") or targetChar:FindFirstChild("Torso") :: BasePart?
        if not targetHum or targetHum.Health <= 0 or not targetHRP then
            Log("ЦЕЛЬ УНИЧТОЖЕНА: " .. targetPlayer.DisplayName, "SUCCESS")
            break
        end

        -- Проверка смены в UI
        local label = FindTargetLabel()
        if label then
            local currentClean = CleanNickname(label.Text)
            if currentClean ~= "" and string.lower(currentClean) ~= string.lower(targetPlayer.Name) and string.lower(currentClean) ~= string.lower(targetPlayer.DisplayName) then
                Log("Цель в UI сменилась — переключаюсь!", "INFO")
                break
            end
        end

        -- Телепорт строго за спину
        if myHRP and targetHRP then
            local loopCF = targetHRP.CFrame * CFrame.new(0, 0.3, 2.0)
            pcall(function()
                myHRP.CFrame = loopCF
                myHRP.AssemblyLinearVelocity = Vector3.zero
            end)
        end

        EmulateAttackClick(knife)
        task.wait(0.06)
    end
end

-- =====================================================================
-- ЦИКЛ АВТО-УБИЙСТВА ВСЕХ ТАРГЕТОВ (KILL TARGET LOOP)
-- =====================================================================
local function StopKillLoop()
    isRunning = false
    BtnKill.Text = "⚡ KILL TARGET: СТАРТ"
    BtnKill.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
    UpdateStatus("Kill All остановлен", Color3.fromRGB(200, 200, 200))
    Log("Цикл Kill All остановлен", "INFO")

    if LocalPlayer.Character then
        local hrp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart") or LocalPlayer.Character.PrimaryPart
        DisableFlight(hrp)
    end
end

local function StartKillLoop()
    if isRunning then
        StopKillLoop()
        return
    end

    isRunning = true
    BtnKill.Text = "⚡ KILL TARGET: СТОП"
    BtnKill.BackgroundColor3 = Color3.fromRGB(40, 180, 50)
    UpdateStatus("Kill All запущен [" .. killMode .. "]", Color3.fromRGB(100, 255, 100))
    Log("--- СТАРТ ЦИКЛА KILL ALL [РЕЖИМ: " .. killMode .. "] ---", "KILL")

    task.spawn(function()
        InspectAndEquipKnife()
        local noTargetCounter = 0

        while isRunning and not isTerminated do
            local myChar = LocalPlayer.Character
            local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")
            if not myChar or not myHum or myHum.Health <= 0 then
                Log("Персонаж погиб — остановка Kill All", "ERROR")
                break
            end

            -- Считываем таргет из UI
            local label = FindTargetLabel()
            local targetPlayer: Player? = nil

            if label then
                local cleanName = CleanNickname(label.Text)
                if cleanName ~= "" and cleanName ~= "Label" and cleanName ~= "None" then
                    targetPlayer = FindPlayerByName(cleanName)
                end
            end

            if targetPlayer and targetPlayer.Character then
                local hum = targetPlayer.Character:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 then
                    noTargetCounter = 0
                    KillTarget(targetPlayer)
                    task.wait(0.05)
                else
                    targetPlayer = nil
                end
            end

            if not targetPlayer then
                noTargetCounter = noTargetCounter + 1
                UpdateStatus("Ожидание нового таргета (" .. noTargetCounter .. "/10)", Color3.fromRGB(255, 180, 50))

                -- Ждем обновления текста в UI до 0.4с
                local textChanged = false
                local conn: RBXScriptConnection? = nil
                if label then
                    conn = label:GetPropertyChangedSignal("Text"):Connect(function() textChanged = true end)
                end

                local waitStart = tick()
                while tick() - waitStart < 0.4 and not textChanged and isRunning do
                    task.wait(0.04)
                end
                if conn then conn:Disconnect() end

                if noTargetCounter >= 10 then
                    Log("Таргеты закончились! Раунд выигран / завершен.", "SUCCESS")
                    UpdateStatus("Раунд завершен", Color3.fromRGB(100, 255, 100))
                    break
                end
            end
        end

        StopKillLoop()
    end)
end

-- =====================================================================
-- BATCH ALL KILL: МАССОВЫЙ ВЫКОС ВСЕХ В РАУНДЕ (КАК У ЧИТЕРА)
-- =====================================================================
local function RunBatchKillAll()
    Log("--- ЗАПУСК BATCH ALL (МАССОВАЯ АУРА) ---", "KILL")
    UpdateStatus("Выполняю Batch Kill по всем...", Color3.fromRGB(255, 140, 40))

    local knife = InspectAndEquipKnife()
    if not knife or not knife:FindFirstChild("Handle") then
        Log("Ошибка: Нож не готов в инвентаре!", "ERROR")
        UpdateStatus("Ошибка: Нет ножа", Color3.fromRGB(255, 80, 80))
        return
    end
    local handle = knife:FindFirstChild("Handle") :: BasePart

    -- Ищем всех участников раунда (атрибут Alive или наличие Knife)
    local targets: { Player } = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
            local hum = plr.Character:FindFirstChildOfClass("Humanoid")
            local isAlive = (hum and hum.Health > 0)
            local hasKnife = plr.Character:FindFirstChild("Knife") or (plr:FindFirstChild("Backpack") and plr.Backpack:FindFirstChild("Knife"))
            local isRoundAttr = (plr:GetAttribute("Alive") == true)

            if isAlive and (hasKnife or isRoundAttr) then
                table.insert(targets, plr)
            end
        end
    end

    -- Если атрибуты не настроены — берем всех живых на сервере
    if #targets == 0 then
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
                local hum = plr.Character:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 then table.insert(targets, plr) end
            end
        end
    end

    Log(string.format("Найдено целей в раунде: %d", #targets), "INFO")
    if #targets == 0 then
        Log("Живые игроки не найдены!", "WARN")
        return
    end

    pcall(function() knife:Activate() end)

    -- Посылаем 3 быстрые волны касаний по всем игрокам
    local startTime = tick()
    for wave = 1, 3 do
        for _, plr in ipairs(targets) do
            if plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
                local hrp = plr.Character.HumanoidRootPart
                if firetouchinterest then
                    pcall(function()
                        firetouchinterest(hrp, handle, 0)
                        firetouchinterest(hrp, handle, 1)
                    end)
                end
            end
        end
        task.wait(0.02)
    end

    local ms = math.floor((tick() - startTime) * 1000)
    Log(string.format("💥 Волны FireTouch разосланы по %d целям за %d мс!", #targets, ms), "SUCCESS")
    UpdateStatus("Batch Kill завершен", Color3.fromRGB(100, 255, 120))
end

