-- ПОИСК И ЭКИПИРОВКА НОЖА
-- =====================================================================
local function InspectAndEquipKnife(): Tool?
    local char = LocalPlayer.Character
    if not char then return nil end

    for _, item in ipairs(char:GetChildren()) do
        if item:IsA("Tool") and (item.Name == "Knife" or string.find(string.lower(item.Name), "knife")) then
            return item
        end
    end

    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack") or LocalPlayer:FindFirstChild("Backpack")
    if not backpack then return nil end

    local knife: Tool? = nil
    for _, item in ipairs(backpack:GetChildren()) do
        if item:IsA("Tool") and (item.Name == "Knife" or string.find(string.lower(item.Name), "knife")) then
            knife = item
            break
        end
    end
    if not knife then knife = backpack:FindFirstChildOfClass("Tool") end
    if not knife then return nil end

    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then pcall(function() hum:EquipTool(knife) end) end
    if knife.Parent ~= char then pcall(function() knife.Parent = char end) end

    task.wait(0.02)
    return knife
end

-- =====================================================================
-- ЧИСТЫЙ МГНОВЕННЫЙ КИЛЛ ЧЕРЕЗ FIRETOUCHINTEREST (БЕЗ ТЕЛЕПОРТОВ!)
-- =====================================================================
local function InstantKillTarget(targetPlayer: Player): boolean
    local targetChar = targetPlayer.Character
    if not targetChar then return false end

    local targetHRP = targetChar:FindFirstChild("HumanoidRootPart") or targetChar:FindFirstChild("Torso") :: BasePart?
    local targetHum = targetChar:FindFirstChildOfClass("Humanoid")
    if not targetHRP or not targetHum or targetHum.Health <= 0 then return false end

    local knife = InspectAndEquipKnife()
    if not knife then
        Log("Ошибка: Нож не найден в инвентаре!", "ERROR")
        return false
    end

    local handle = knife:FindFirstChild("Handle") :: BasePart?
    if not handle then
        Log("Ошибка: Handle ножа не найден!", "ERROR")
        return false
    end

    local startTime = tick()
    Log(string.format("⚡ FireTouch удар по: %s (@%s)", targetPlayer.DisplayName, targetPlayer.Name), "KILL")
    UpdateStatus("Удар: " .. targetPlayer.DisplayName, Color3.fromRGB(255, 80, 80))

    -- Активируем нож (открывает окно урона на сервере)
    pcall(function() knife:Activate() end)

    if firetouchinterest then
        for pulse = 1, 4 do
            if not isRunning or isTerminated then break end
            if not targetHum or targetHum.Health <= 0 then break end

            pcall(function()
                firetouchinterest(targetHRP, handle, 0)
                firetouchinterest(targetHRP, handle, 1)
            end)
            task.wait(0.025)

            -- Проверяем, сменился ли таргет в UI
            local label = FindTargetLabel()
            if label then
                local currentClean = CleanNickname(label.Text)
                if currentClean ~= "" and string.lower(currentClean) ~= string.lower(targetPlayer.Name) and string.lower(currentClean) ~= string.lower(targetPlayer.DisplayName) then
                    local ms = math.floor((tick() - startTime) * 1000)
                    Log(string.format("⚡ ЦЕЛЬ УНИЧТОЖЕНА ЗА %d мс! След. таргет: %s", ms, currentClean), "SUCCESS")
                    return true
                end
            end
        end
    else
        Log("ОШИБКА: firetouchinterest не поддерживается вашим инжектором!", "ERROR")
        return false
    end

    local ms = math.floor((tick() - startTime) * 1000)
    Log(string.format("⚡ ЦЕЛЬ УНИЧТОЖЕНА ЗА %d мс! (%s)", ms, targetPlayer.DisplayName), "SUCCESS")
    return true
end

-- =====================================================================
-- ЦИКЛ МГНОВЕННОГО ВЫБИВАНИЯ ТАРГЕТОВ (INSTA-CHAIN LOOP)
-- =====================================================================
local function StopKillLoop()
    isRunning = false
    BtnKill.Text = "⚡ KILL TARGET (ЦЕПОЧКА)"
    BtnKill.BackgroundColor3 = Color3.fromRGB(200, 45, 45)
    UpdateStatus("Kill Target остановлен", Color3.fromRGB(200, 200, 200))
    Log("Цикл выбивания целей остановлен", "INFO")
end

local function StartKillLoop()
    if isRunning then
        StopKillLoop()
        return
    end

    isRunning = true
    BtnKill.Text = "⚡ ОСТАНОВИТЬ"
    BtnKill.BackgroundColor3 = Color3.fromRGB(40, 180, 50)
    UpdateStatus("Авто-выбивание таргетов активно", Color3.fromRGB(100, 255, 100))
    Log("--- СТАРТ INSTA-CHAIN KILL ---", "KILL")

    task.spawn(function()
        InspectAndEquipKnife()
        local noTargetCounter = 0

        while isRunning and not isTerminated do
            local myChar = LocalPlayer.Character
            local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")
            if not myChar or not myHum or myHum.Health <= 0 then
                Log("Персонаж погиб — остановка", "ERROR")
                break
            end

            -- Считываем текущую цель из UI
            local label = FindTargetLabel()
            local targetPlayer: Player? = nil

            if label then
                local cleanName = CleanNickname(label.Text)
                if cleanName ~= "" and cleanName ~= "Label" and cleanName ~= "None" then
                    targetPlayer = FindPlayerByName(cleanName)
                end
            end

            if targetPlayer and targetPlayer.Character then
                local hum = targetPlayer.Character:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 then
                    noTargetCounter = 0
                    InstantKillTarget(targetPlayer)
                    task.wait(0.04) -- Минимальная пауза перед следующей целью
                else
                    targetPlayer = nil
                end
            end

            if not targetPlayer then
                noTargetCounter = noTargetCounter + 1
                UpdateStatus("Ожидание нового таргета (" .. noTargetCounter .. "/10)", Color3.fromRGB(255, 180, 50))

                -- Ждем моментального обновления UI текста
                local textChanged = false
                local conn: RBXScriptConnection? = nil
                if label then
                    conn = label:GetPropertyChangedSignal("Text"):Connect(function() textChanged = true end)
                end

                local waitStart = tick()
                while tick() - waitStart < 0.35 and not textChanged and isRunning do
                    task.wait(0.03)
                end
                if conn then conn:Disconnect() end

                if noTargetCounter >= 10 then
                    Log("Таргеты закончились! Все цели устранены.", "SUCCESS")
                    UpdateStatus("Раунд завершен! Победа.", Color3.fromRGB(100, 255, 100))
                    break
                end
            end
        end

        StopKillLoop()
    end)
end

