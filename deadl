    local rawText = string.format("[%s] %s\n%s", timeStr, header, message)
    table.insert(rawLogs, rawText)
    if #rawLogs > 150 then table.remove(rawLogs, 1) end

    local box = Instance.new("Frame")
    box.Size = UDim2.new(1, -6, 0, 0)
    box.AutomaticSize = Enum.AutomaticSize.Y
    box.BackgroundColor3 = Color3.fromRGB(26, 26, 34)
