    local rawText = string.format("[%s] %s\n%s", timeStr, header, message)
    table.insert(rawLogs, rawText)
    if #rawLogs > 100 then table.remove(rawLogs, 1) end

    local box = Instance.new("Frame")
    box.Size = UDim2.new(1, -6, 0, 0)
    box.AutomaticSize = Enum.AutomaticSize.Y
    box.BackgroundColor3 = Color3.fromRGB(26, 26, 34)
    box.Parent = Scroll
    Instance.new("UICorner", box).CornerRadius = UDim.new(0, 6)

    local stroke = Instance.new("UIStroke", box)
    stroke.Color = color or Color3.fromRGB(65, 65, 80)
    stroke.Thickness = 1

    local hLbl = Instance.new("TextLabel")
    hLbl.Size = UDim2.new(1, -10, 0, 16)
    hLbl.Position = UDim2.new(0, 6, 0, 4)
