local targetHighlight: Highlight? = nil
local targetBillboard: BillboardGui? = nil

local function RemoveEsp()
    if targetHighlight then pcall(function() targetHighlight:Destroy() end); targetHighlight = nil end
    if targetBillboard then pcall(function() targetBillboard:Destroy() end); targetBillboard = nil end
end

local function UpdateEsp(targetPlayer: Player?)
    if not isEspEnabled or not targetPlayer or not targetPlayer.Character then
        RemoveEsp()
        return
    end

    local char = targetPlayer.Character
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    if not targetHighlight or targetHighlight.Parent ~= char then
        RemoveEsp()
        targetHighlight = Instance.new("Highlight")
        targetHighlight.Name = "SpyHighlight"
        targetHighlight.FillColor = Color3.fromRGB(255, 50, 50)
        targetHighlight.FillTransparency = 0.5
        targetHighlight.OutlineColor = Color3.fromRGB(255, 255, 255)
        targetHighlight.OutlineTransparency = 0
        targetHighlight.Adornee = char
        targetHighlight.Parent = char
    end

    if not targetBillboard or targetBillboard.Parent ~= hrp then
        targetBillboard = Instance.new("BillboardGui")
        targetBillboard.Name = "SpyBillboard"
        targetBillboard.Size = UDim2.new(0, 160, 0, 45)
        targetBillboard.AlwaysOnTop = true
        targetBillboard.StudsOffset = Vector3.new(0, 3, 0)
        targetBillboard.Adornee = hrp
        targetBillboard.Parent = hrp

        local txt = Instance.new("TextLabel", targetBillboard)
        txt.Name = "Info"
        txt.Size = UDim2.new(1, 0, 1, 0)
        txt.BackgroundTransparency = 1
        txt.TextColor3 = Color3.fromRGB(255, 80, 80)
        txt.Font = Enum.Font.GothamBold
        txt.TextSize = 11
        txt.TextStrokeTransparency = 0.2
    end
end

