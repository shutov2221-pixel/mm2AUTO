Workspace.ChildAdded:Connect(function(child)
    local cName = string.lower(child.Name)
    if cName:find("knife") or cName:find("blade") or cName:find("throw") or cName:find("stuck") then
        local objPos: Vector3? = nil
        if child:IsA("BasePart") then
            objPos = child.Position
        elseif child:IsA("Model") then
            local p = child.PrimaryPart or child:FindFirstChildWhichIsA("BasePart")
            if p then objPos = p.Position end
        end

        local distText = "N/A"
        local target = FindTarget()
        if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") and objPos then
            local dist = math.floor((objPos - target.Character.HumanoidRootPart.Position).Magnitude)
            distText = tostring(dist) .. " studs"
        end

        AddLog(
            "🚀 СНАРЯД В WORKSPACE",
            string.format("Объект: %s (%s)\nДистанция от %s: %s", child.Name, child.ClassName, TARGET_NAME, distText),
            Color3.fromRGB(255, 150, 50)
        )
    end
end)

-- =====================================================================
-- МОНИТОРИНГ BATCH KILL (ОДНОВРЕМЕННЫЙ МАССОВЫЙ КИЛЛ ИЗ ПУСТОТЫ)
-- =====================================================================
local deathQueue: { name: string, time: number, distToLunar: number } = {}
local batchTimerRunning = false

local function ProcessBatchDeaths()
    task.wait(0.35)
    batchTimerRunning = false

    local count = #deathQueue
    if count == 0 then return end

    local target = FindTarget()
    local targetPos = Vector3.zero
    local targetInVoid = false
    local targetY = 0

    if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
        targetPos = target.Character.HumanoidRootPart.Position
        targetY = math.floor(targetPos.Y)
        if targetY < -30 or targetY > 300 or targetPos.Magnitude > 2500 then
            targetInVoid = true
        end
    end

    if count >= 2 then
        local namesList = {}
        local avgDist = 0
        for _, d in ipairs(deathQueue) do
            table.insert(namesList, d.name)
            avgDist = avgDist + d.distToLunar
        end
        avgDist = math.floor(avgDist / count)

        AddLog(
            "🚨 МАССОВЫЙ INSTA-KILL (FIRETOUCH AURA)",
            string.format(
                "⚡ %d игроков погибли в одну миллисекунду!\n" ..
                "• Жертвы: %s\n" ..
                "• %s в пустоте: Y = %d (дистанция ~%d studs)\n" ..
                "• ВЕРДИКТ: 100%% эксплойт firetouchinterest в цикле for!\n" ..
                "Читер не бросал ножи и не летал. Пакет касания отправлен сервере напрямую из пустоты.",
                count, table.concat(namesList, ", "),
                TARGET_NAME, targetY, avgDist
            ),
            Color3.fromRGB(255, 40, 40)
        )
    else
        local single = deathQueue[1]
        AddLog(
            "💀 СМЕРТЬ: " .. single.name,
            string.format(
                "Дистанция до %s: %d studs (Y: %d)\nСтатус убийцы: %s",
                TARGET_NAME, single.distToLunar, targetY,
                targetInVoid and "В пустоте / над картой" or "На карте"
            ),
            Color3.fromRGB(200, 200, 210)
        )
    end

    table.clear(deathQueue)
end

local function RegisterDeath(victimName: string, victimChar: Instance)
    local target = FindTarget()
    local dist = 0
    if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") and victimChar:FindFirstChild("HumanoidRootPart") then
        dist = math.floor((victimChar.HumanoidRootPart.Position - target.Character.HumanoidRootPart.Position).Magnitude)
    end

    table.insert(deathQueue, {
        name = victimName,
        time = os.clock(),
        distToLunar = dist
    })

    if not batchTimerRunning then
        batchTimerRunning = true
        task.spawn(ProcessBatchDeaths)
    end
end

local function HookPlayer(plr: Player)
    if plr == LocalPlayer then return end

    local function setup(char: Instance)
        local hum = char:WaitForChild("Humanoid", 5) :: Humanoid?
        if hum then
            hum.Died:Connect(function()
                RegisterDeath(plr.DisplayName, char)
            end)
        end
    end

    if plr.Character then setup(plr.Character) end
    plr.CharacterAdded:Connect(setup)
end

for _, p in ipairs(Players:GetPlayers()) do HookPlayer(p) end
Players.PlayerAdded:Connect(HookPlayer)

