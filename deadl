-- =====================================================================
-- МОНИТОРИНГ ЖЕРТВ НА СЕРВЕРЕ (КТО И КАК ПОГИБ)
-- =====================================================================
local victimLastTouches: { [Player]: { partName: string, fromWho: string, dist: number, time: number } } = {}

local function HookPlayerTouches(plr: Player)
    if plr == LocalPlayer then return end

    local function setupChar(char: Instance)
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                part.Touched:Connect(function(hit)
                    if not hit or not hit.Parent or hit:IsDescendantOf(char) then return end
                    local parentPlayer = Players:GetPlayerFromCharacter(hit.Parent) or Players:GetPlayerFromCharacter(hit.Parent.Parent)
                    local killerName = parentPlayer and parentPlayer.Name or hit.Parent.Name
                    
                    local hitDist = 0
                    if char:FindFirstChild("HumanoidRootPart") and hit:IsA("BasePart") then
                        hitDist = math.floor((hit.Position - char.HumanoidRootPart.Position).Magnitude)
                    end

                    victimLastTouches[plr] = {
                        partName = hit.Name,
                        fromWho = killerName,
                        dist = hitDist,
                        time = os.clock()
                    }
                end)
            end
        end

        local hum = char:WaitForChild("Humanoid", 5) :: Humanoid?
        if hum then
            hum.Died:Connect(function()
                local deathTime = os.clock()
                local target = FindTarget()
                local targetPos = Vector3.zero
                local targetInVoid = false
                local distToTarget = -1
                local targetEquipped = "Ничего"
                local targetVel = 0

                if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
                    local tHrp = target.Character.HumanoidRootPart
                    targetPos = tHrp.Position
                    targetVel = math.floor(tHrp.AssemblyLinearVelocity.Magnitude)
                    if char:FindFirstChild("HumanoidRootPart") then
                        distToTarget = math.floor((char.HumanoidRootPart.Position - targetPos).Magnitude)
                    end
                    if targetPos.Y < -30 or targetPos.Magnitude > 2000 then
                        targetInVoid = true
                    end
                    local tool = target.Character:FindFirstChildOfClass("Tool")
                    if tool then targetEquipped = tool.Name end
                end

                local lastTouch = victimLastTouches[plr]
                local touchDetails = "Касаний не зафиксировано"
                local isLunarTouch = false

                if lastTouch and (deathTime - lastTouch.time) < 1.5 then
                    touchDetails = string.format("Деталь: %s (Владелец: %s, Дист. детали: %d)", lastTouch.partName, lastTouch.fromWho, lastTouch.dist)
                    if string.lower(lastTouch.fromWho) == string.lower(TARGET_NAME) or string.lower(lastTouch.partName):find("knife") then
                        isLunarTouch = true
                    end
                end

                -- Определение метода
                local header = "💀 СМЕРТЬ: " .. plr.DisplayName
                local alertColor = Color3.fromRGB(200, 200, 200)
                local verdict = ""

                if distToTarget > 100 and targetInVoid then
                    header = "🚨 КИЛЛ ИЗ ПУСТОТЫ: " .. plr.DisplayName
                    alertColor = Color3.fromRGB(255, 40, 40)
                    verdict = string.format(
                        "💥 ВЕРДИКТ: Читер убил игрока на расстоянии %d studs!\n" ..
                        "• Читер в пустоте: Y = %d (Скорость читера: %d)\n" ..
                        "• Оружие в руках читера: %s\n" ..
                        "• Последнее касание: %s\n" ..
                        "• Метод: %s",
                        distToTarget, math.floor(targetPos.Y), targetVel, targetEquipped, touchDetails,
                        (isLunarTouch or targetEquipped == "Ничего") and "FIRETOUCHINTEREST (Пакет фантомного касания ножом)" or "Скрытый Tool / Remote"
                    )
                else
                    verdict = string.format(
                        "Дистанция до %s: %d studs\nЧитер: Y = %d (В руках: %s)\nКасание: %s",
                        TARGET_NAME, distToTarget, math.floor(targetPos.Y), targetEquipped, touchDetails
                    )
                end

                AddLog(header, verdict, alertColor)
            end)
        end
    end

    if plr.Character then setupChar(plr.Character) end
    plr.CharacterAdded:Connect(setupChar)
end

for _, p in ipairs(Players:GetPlayers()) do
    HookPlayerTouches(p)
end
Players.PlayerAdded:Connect(HookPlayerTouches)

-- =====================================================================
-- ПОСТОЯННАЯ СЛЕЖКА ЗА ЧИТЕРОМ (LUNAR TRACKER ENGINE)
-- =====================================================================
local lastKnownParent = nil
local lastToolSeenTime = 0

RunService.Heartbeat:Connect(function()
    local target = FindTarget()
    if not target then
        TelemetryLabel.Text = string.format(
            "❌ Игрок '%s' НЕ на сервере!\nОжидание подключения...\nИгроков онлайн: %d",
            TARGET_NAME, #Players:GetPlayers()
        )
        TelemetryLabel.TextColor3 = Color3.fromRGB(255, 120, 120)
        return
    end

    local char = target.Character
    if not char then
        TelemetryLabel.Text = string.format("⏳ %s возрождается (нет персонажа)", target.Name)
        return
    end

    local hrp = char:FindFirstChild("HumanoidRootPart") :: BasePart?
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then
        TelemetryLabel.Text = string.format("⚠️ Персонаж %s загружается...", target.Name)
        return
    end

    local pos = hrp.Position
    local vel = math.floor(hrp.AssemblyLinearVelocity.Magnitude)
    local distToMe = math.floor((pos - (LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") and LocalPlayer.Character.HumanoidRootPart.Position or Vector3.zero)).Magnitude)

    -- Поиск экипированного инструмента
    local equippedTool = char:FindFirstChildOfClass("Tool")
    local toolName = equippedTool and equippedTool.Name or "Нет"

    -- Проверка: не оторвана ли деталь ножа (Desync Check)
    local isDesyncedHandle = false
    local handleDistance = 0
    if equippedTool then
        local handle = equippedTool:FindFirstChild("Handle") :: BasePart?
        if handle then
            handleDistance = math.floor((handle.Position - pos).Magnitude)
            if handleDistance > 25 then
                isDesyncedHandle = true
            end
        end
    end

    -- Формирование статуса
    local inVoid = (pos.Y < -30 or pos.Magnitude > 2500)
    local statusColor = inVoid and Color3.fromRGB(255, 80, 80) or Color3.fromRGB(100, 255, 120)
    local locationText = inVoid and "🚨 В ПУСТОТЕ ПОД КАРТОЙ!" or "На карте"

    TelemetryLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    TelemetryLabel.Text = string.format(
        "👤 Цель: %s | %s\n" ..
        "📍 Координаты: X: %d, Y: %d, Z: %d (Дист. до меня: %d)\n" ..
        "⚡ Скорость: %d studs/s | HP: %d\n" ..
        "🗡️ В руках: %s %s",
        target.Name, locationText,
        math.floor(pos.X), math.floor(pos.Y), math.floor(pos.Z), distToMe,
        vel, math.floor(hum.Health),
        toolName,
        isDesyncedHandle and string.format("⚠️ [DESYNC НОЖА! Handle на %d studs от тела!]", handleDistance) or ""
    )

    -- Обновление ESP
    if isEspEnabled then
        UpdateEsp(target)
        if targetBillboard and targetBillboard:FindFirstChild("Info") then
            local infoLbl = targetBillboard.Info :: TextLabel
            infoLbl.Text = string.format("%s\n%d studs | Y: %d\nTool: %s", target.Name, distToMe, math.floor(pos.Y), toolName)
        end
    end

    -- Логирование смены экипировки (даже если достал нож на 0.05 сек)
    if equippedTool and os.clock() - lastToolSeenTime > 1.2 then
        lastToolSeenTime = os.clock()
        AddLog(
            "🗡️ ОБНАРУЖЕН ПРЕДМЕТ В РУКАХ",
            string.format("Читер достал: '%s' на высоте Y: %d (Дистанция: %d)", toolName, math.floor(pos.Y), distToMe),
            Color3.fromRGB(255, 200, 50)
        )
    end
end)

AddLog("СИСТЕМА", "Скрипт слежки активен! Цель: " .. TARGET_NAME .. "\nСледит за координатами, пустотой, desync-ножами и смертями.", Color3.fromRGB(80, 220, 120))
