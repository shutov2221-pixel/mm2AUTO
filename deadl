RunService.Heartbeat:Connect(function()
    local target = FindTarget()
    if not target then
        TelemetryLabel.Text = string.format("❌ Игрок '%s' не в сети!\nОнлайн: %d", TARGET_NAME, #Players:GetPlayers())
        TelemetryLabel.TextColor3 = Color3.fromRGB(255, 120, 120)
        return
    end

    local char = target.Character
    if not char then
        TelemetryLabel.Text = string.format("⏳ %s возрождается...", target.Name)
        return
    end

    local hrp = char:FindFirstChild("HumanoidRootPart") :: BasePart?
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end

    local pos = hrp.Position
    local vel = math.floor(hrp.AssemblyLinearVelocity.Magnitude)
    local myPos = (LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")) and LocalPlayer.Character.HumanoidRootPart.Position or Vector3.zero
    local distToMe = math.floor((pos - myPos).Magnitude)

    local equippedTool = char:FindFirstChildOfClass("Tool")
    local toolName = equippedTool and equippedTool.Name or "Ничего"

    local inVoid = (pos.Y < -30 or pos.Y > 300 or pos.Magnitude > 2500)
    local locStr = inVoid and "🚨 В ПУСТОТЕ/НЕБЕ" or "На карте"

    TelemetryLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    TelemetryLabel.Text = string.format(
        "👤 %s | %s\n" ..
        "📍 Позиция: X: %d, Y: %d, Z: %d (До меня: %d)\n" ..
        "⚡ Скорость: %d studs/s | HP: %d\n" ..
        "🗡️ В руках: %s",
        target.Name, locStr,
        math.floor(pos.X), math.floor(pos.Y), math.floor(pos.Z), distToMe,
        vel, math.floor(hum.Health), toolName
    )

    if isEspEnabled then
        UpdateEsp(target)
    end
end)

