local function FindTarget(): Player?
    for _, plr in ipairs(Players:GetPlayers()) do
        if string.lower(plr.Name) == string.lower(TARGET_NAME) or string.lower(plr.DisplayName) == string.lower(TARGET_NAME) then
            return plr
        end
    end
    return nil
end

