-- Настройка: интервал перезахода (секунды)
local REJOIN_TIME = 7200

local TeleportService = game:GetService("TeleportService")
local Players = game:GetService("Players")

-- Ключ: после телепортации попросите Delta автоматически перезапустить этот скрипт
-- Замените URL на сырую ссылку вашего файла на GitHub
local SCRIPT_URL = "https://raw.githubusercontent.com/ваш_аккаунт/ваш_репозиторий/main/rejoin.lua"
if queue_on_teleport then
    queue_on_teleport(string.format('loadstring(game:HttpGet("%s"))()', SCRIPT_URL))
end

-- Ждём указанное время
task.wait(REJOIN_TIME)

-- Выполняем перезаход
local ok, err = pcall(function()
    TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, Players.LocalPlayer)
end)

-- Если pcall не сработал, возможно, блокировка телепортации всё ещё включена, но ошибку вы не увидите
-- Поэтому обязательно проверьте настройки Delta
