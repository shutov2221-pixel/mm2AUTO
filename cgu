-- ───────────── 2. Логи ─────────────
local Logs = {}
local MAX_LOGS = 500
local destroyed = false

local function addEntry(kind, text)
    if destroyed then return end
    if not ScrollFrame or not ScrollFrame.Parent then return end

    local color = Color3.fromRGB(220, 220, 220)
    local prefix = ""
    if kind == "warn" then
        color = Color3.fromRGB(255, 200, 80)
        prefix = "[WARN] "
    elseif kind == "error" then
        color = Color3.fromRGB(255, 90, 90)
        prefix = "[ERR] "
    end

    local entry = Instance.new("TextLabel")
    entry.Size = UDim2.new(1, 0, 0, 0)
    entry.AutomaticSize = Enum.AutomaticSize.Y
    entry.BackgroundTransparency = 1
    entry.Text = "[" .. os.date("%H:%M:%S") .. "] " .. prefix .. text
    entry.TextColor3 = color
    entry.Font = Enum.Font.Code
    entry.TextSize = 12
    entry.TextXAlignment = Enum.TextXAlignment.Left
    entry.TextYAlignment = Enum.TextYAlignment.Top
    entry.TextWrapped = true
    entry.Parent = ScrollFrame

    task.defer(function()
        if ScrollFrame and ScrollFrame.Parent then
            ScrollFrame.CanvasPosition = Vector2.new(0, 1e6)  -- скролл в низ
        end
    end)
end

local function addLog(kind, msg)
    table.insert(Logs, { kind = kind, msg = msg, time = os.date("%H:%M:%S") })

    -- Удалить самый старый, если переполнено
    if #Logs > MAX_LOGS then
        table.remove(Logs, 1)
        for _, child in ipairs(ScrollFrame:GetChildren()) do
            if child:IsA("TextLabel") then
                child:Destroy()
                break
            end
        end
    end

    addEntry(kind, msg)
end

-- ───────────── 3. Хук ─────────────
local oldPrint = print
local oldWarn  = warn
local oldError = error

local function stringify(...)
    local args = { ... }
    local parts = {}
    for i = 1, #args do
        parts[i] = tostring(args[i])
    end
    return table.concat(parts, " ")
end

genv.print = function(...)
    addLog("info", stringify(...))
    return oldPrint(...)
end

genv.warn = function(...)
    addLog("warn", stringify(...))
    return oldWarn(...)
end

genv.error = function(msg, level)
    addLog("error", tostring(msg))
    return oldError(msg, level)
end

-- ───────────── 4. Кнопки ─────────────
CopyBtn.MouseButton1Click:Connect(function()
    local lines = {}
    for _, e in ipairs(Logs) do
        table.insert(lines, "[" .. e.time .. "] [" .. string.upper(e.kind) .. "] " .. e.msg)
    end
    local fullText = table.concat(lines, "\n")
    local setclip = setclipboard or toclipboard or (syn and syn.setclipboard)
    if setclip then
        pcall(setclip, fullText)
    end
end)

ClearBtn.MouseButton1Click:Connect(function()
    table.clear(Logs)
    for _, child in ipairs(ScrollFrame:GetChildren()) do
        if child:IsA("TextLabel") then
            child:Destroy()
        end
    end
end)

-- Функция очистки — используется и кнопкой, и при повторном запуске скрипта
local function cleanup()
    if destroyed then return end
    destroyed = true
    genv.print = oldPrint
    genv.warn  = oldWarn
    genv.error = oldError
    genv._LogMirrorCleanup = nil
    if ScreenGui and ScreenGui.Parent then
        ScreenGui:Destroy()
    end
end

genv._LogMirrorCleanup = cleanup
CloseBtn.MouseButton1Click:Connect(cleanup)

-- ───────────── 5. Перетаскивание ─────────────
local dragging = false
local dragStart, startPos

TitleBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = Main.Position
    end
end)

TitleBar.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        Main.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
    end
end)

print("[LogMirror] Активен. Все print/warn/error теперь зеркалятся в окно.")
