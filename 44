-- 8. PlayerDataChanged: Глобальная серверная таблица (Монеты ВСЕХ игроков, роли, статус жизни)
-- Это ключевой ответ на вопрос «как скрипт видит чужие монеты»:
-- MM2 рассылает ВСЕМ клиентам сводную таблицу игроков, где есть поле .Coins, .Dead, .Role!
RegisterRemoteHook("PlayerDataChanged", function(data: any)
    if typeof(data) ~= "table" then
        Log("[PlayerDataChanged] Получены данные не-табличного типа: " .. tostring(data), "DATA")
        return
    end

    local countPlayers = 0
    local coinDeltas = {}
    local roleDeltas = {}
    local deathDeltas = {}

    for pName, pInfo in pairs(data) do
        countPlayers = countPlayers + 1
        local playerName = tostring(pName)

        if typeof(pInfo) == "table" then
            -- Монеты
            if pInfo.Coins ~= nil then
                local currentCoins = tonumber(pInfo.Coins) or 0
                local prevCoins = PlayerCoinsCache[playerName]
                if prevCoins ~= nil and currentCoins ~= prevCoins then
                    local diff = currentCoins - prevCoins
                    table.insert(coinDeltas, string.format("%s (%+d -> %d)", playerName, diff, currentCoins))
                end
                PlayerCoinsCache[playerName] = currentCoins
            end

            -- Роли
            if pInfo.Role ~= nil then
                local r = tostring(pInfo.Role)
                local prevR = PlayerRolesCache[playerName]
                if prevR ~= nil and r ~= prevR then
                    table.insert(roleDeltas, string.format("%s: %s -> %s", playerName, prevR, r))
                end
                PlayerRolesCache[playerName] = r
            end

            -- Смерти (Dead)
            if pInfo.Dead ~= nil then
                local isDead = (pInfo.Dead == true)
                local prevDead = PlayerAliveCache[playerName]
                if prevDead ~= nil and isDead ~= prevDead then
                    table.insert(deathDeltas, string.format("%s: %s", playerName, isDead and "МЁРТВ" or "ЖИВ"))
                end
                PlayerAliveCache[playerName] = isDead
            end
        end
    end

    if #coinDeltas > 0 then
        Log("🪙 [PlayerData: МОНЕТЫ] " .. table.concat(coinDeltas, ", "), "COIN")
    end
    if #roleDeltas > 0 then
        Log("🎭 [PlayerData: РОЛИ] " .. table.concat(roleDeltas, ", "), "DATA")
    end
    if #deathDeltas > 0 then
        Log("⚰️ [PlayerData: СТАТУС] " .. table.concat(deathDeltas, ", "), "DATA")
    end

    -- Если пришёл пустой словарь {} — это сброс состояния между раундами!
    if countPlayers == 0 then
        Log("🔄 [PlayerDataChanged] Таблица игроков ОЧИЩЕНА сервером (Сброс между раундами)", "DATA")
        table.clear(PlayerCoinsCache)
        table.clear(PlayerRolesCache)
        table.clear(PlayerAliveCache)
    end
end)

-- =====================================================================
-- ТРЕКЕР КАРТЫ И МОНЕТ В WORKSPACE
-- =====================================================================
local CurrentMapInstance: Instance? = nil
local CurrentCoinContainer: Instance? = nil
local coinSpawnTracked = false
local mapSpawnTick = 0

local function CheckCoinContainerCoins(container: Instance): number
    local count = 0
    for _, desc in ipairs(container:GetDescendants()) do
        if desc:IsA("TouchTransmitter") and desc.Parent and desc.Parent:IsA("BasePart") then
            count = count + 1
        end
    end
    return count
end

local function HookCoinContainer(coinContainer: Instance)
    CurrentCoinContainer = coinContainer
    local initialCount = CheckCoinContainerCoins(coinContainer)
    LblCoinsInfo.Text = string.format("Монеты: %d на карте", initialCount)

    local spawnDelta = (mapSpawnTick > 0) and string.format("(через %.2fc после карты)", tick() - mapSpawnTick) or ""
    Log(string.format("🟡 [CoinContainer] Обнаружен! Стартовое число монет: %d %s", initialCount, spawnDelta), "COIN")

    -- Отслеживаем добавление монет
    local addConn = coinContainer.DescendantAdded:Connect(function(desc)
        if desc:IsA("TouchTransmitter") then
            if not coinSpawnTracked then
                coinSpawnTracked = true
                local d = (mapSpawnTick > 0) and string.format("(через %.2fc после спавна карты)", tick() - mapSpawnTick) or ""
                Log(string.format("✨ [МОНЕТЫ] НАЧАЛСЯ СПАВН МОНЕТ на карте! %s", d), "COIN")
            end
            local cur = CheckCoinContainerCoins(coinContainer)
            LblCoinsInfo.Text = string.format("Монеты: %d на карте", cur)
        end
    end)
    table.insert(activeConnections, addConn)

    -- Отслеживаем удаление монет (подбор)
    local remConn = coinContainer.ChildRemoved:Connect(function()
        task.defer(function()
            if coinContainer and coinContainer.Parent then
                local cur = CheckCoinContainerCoins(coinContainer)
                LblCoinsInfo.Text = string.format("Монеты: %d на карте", cur)
            end
        end)
    end)
    table.insert(activeConnections, remConn)

    -- Отслеживаем уничтожение контейнера
    local ancConn = coinContainer.AncestryChanged:Connect(function(_, parent)
        if not parent then
            Log("❌ [CoinContainer] УДАЛЁН из Workspace!", "COIN")
            CurrentCoinContainer = nil
            coinSpawnTracked = false
            LblCoinsInfo.Text = "Монеты: 0 (контейнер удален)"
        end
    end)
    table.insert(activeConnections, ancConn)
end

local function InspectMapCandidate(child: Instance)
    -- Исключаем служебные папки и игроков
    if child == LocalPlayer.Character or Players:GetPlayerFromCharacter(child) then return end
    if child.Name == "Lobby" or child.Name == "Terrain" or child.Name == "Camera" then return end

    local container = child:FindFirstChild("CoinContainer")
    local spawns = child:FindFirstChild("Spawns")

    if container or spawns then
        CurrentMapInstance = child
        mapSpawnTick = tick()
        coinSpawnTracked = false
        LblCurrentMap.Text = "Карта: " .. child.Name
        LblCurrentMap.TextColor3 = Color3.fromRGB(100, 255, 150)
        Log(string.format("🗺️ [КАРТА] СПАВН КАРТЫ: '%s' (Класс: %s, Spawns=%s, CoinContainer=%s)", 
            child.Name, child.ClassName, tostring(spawns ~= nil), tostring(container ~= nil)), "MAP")

        if container then
            HookCoinContainer(container)
        else
            -- Ждем появления CoinContainer, если он загружается следом
            local ccConn: RBXScriptConnection? = nil
            ccConn = child.ChildAdded:Connect(function(newChild)
                if newChild.Name == "CoinContainer" then
                    if ccConn then ccConn:Disconnect() end
                    HookCoinContainer(newChild)
                end
            end)
            if ccConn then table.insert(activeConnections, ccConn) end
        end

        local remConn = child.AncestryChanged:Connect(function(_, parent)
            if not parent then
                local lifetime = (mapSpawnTick > 0) and string.format("(жила %.1fc)", tick() - mapSpawnTick) or ""
                Log(string.format("🧹 [КАРТА] ОЧИСТКА КАРТЫ: '%s' удалена из Workspace %s", child.Name, lifetime), "MAP")
                if CurrentMapInstance == child then
                    CurrentMapInstance = nil
                    CurrentCoinContainer = nil
                    LblCurrentMap.Text = "Карта: (нет)"
                    LblCurrentMap.TextColor3 = Color3.fromRGB(180, 180, 180)
                end
            end
        end)
        table.insert(activeConnections, remConn)
    end
end

-- Сканируем уже существующие карты в Workspace при запуске
for _, ch in ipairs(Workspace:GetChildren()) do
    InspectMapCandidate(ch)
end

-- Слушаем появление новых карт
local wsAddConn = Workspace.ChildAdded:Connect(function(child)
    if isTerminated then return end
    task.defer(function()
        InspectMapCandidate(child)
    end)
end)
table.insert(activeConnections, wsAddConn)

-- =====================================================================
-- ТРЕКЕР ГОЛОСОВАНИЯ (LOBBY VOTEPADS)
-- =====================================================================
local isVotingActive = false
local lastVoteOptions = ""

local function CheckVotingState()
    local lobby = Workspace:FindFirstChild("Lobby")
    local votePadsFolder = lobby and lobby:FindFirstChild("VotePads")

    if not votePadsFolder then
        if isVotingActive then
            isVotingActive = false
            lastVoteOptions = ""
            Log("🗳️ [ГОЛОСОВАНИЕ] VotePads исчезли — голосование окончено", "VOTE")
            LblVoteStatus.Text = "Голосование: Окончено"
            LblVoteStatus.TextColor3 = Color3.fromRGB(150, 150, 150)
        end
        return
    end

    local currentMapNames = {}
    local totalVotes = 0

    for _, pad in ipairs(votePadsFolder:GetChildren()) do
        if pad:IsA("BasePart") or pad:IsA("Model") then
            local infoGui = pad:FindFirstChild("VoteInfoGui", true)
            if infoGui then
                local mapName = nil
                local votes = 0
                for _, txt in ipairs(infoGui:GetDescendants()) do
                    if txt:IsA("TextLabel") and txt.Text ~= "" and txt.Text ~= "Label" then
                        local t = string.lower(txt.Text)
                        if string.find(t, "votes:") then
                            votes = tonumber(string.match(txt.Text, "%d+")) or 0
                        else
                            mapName = string.gsub(txt.Text, "^%s*(.-)%s*$", "%1")
                        end
                    end
                end
                if mapName and mapName ~= "" then
                    table.insert(currentMapNames, string.format("%s (%d гол.)", mapName, votes))
                    totalVotes = totalVotes + votes
                end
            end
        end
    end

    if #currentMapNames > 0 then
        table.sort(currentMapNames)
        local optionsStr = table.concat(currentMapNames, " | ")

        if not isVotingActive or optionsStr ~= lastVoteOptions then
            if not isVotingActive then
                Log(string.format("🗳️ [ГОЛОСОВАНИЕ] НАЧАЛОСЬ ГОЛОСОВАНИЕ ЗА КАРТЫ! Варианты: %s", optionsStr), "VOTE")
            else
                Log(string.format("🗳️ [ГОЛОСОВАНИЕ: ОБНОВЛЕНИЕ] %s (Всего голосов: %d)", optionsStr, totalVotes), "VOTE")
            end
            isVotingActive = true
            lastVoteOptions = optionsStr
            LblVoteStatus.Text = "Голосование: ИДЁТ (" .. #currentMapNames .. " карт)"
            LblVoteStatus.TextColor3 = Color3.fromRGB(180, 120, 255)
        end
    else
        if isVotingActive then
            isVotingActive = false
            Log(string.format("🏁 [ГОЛОСОВАНИЕ] ГОЛОСОВАНИЕ ЗАВЕРШЕНО! Панели скрыты сервером. Выбор карты...", lastVoteOptions), "VOTE")
            lastVoteOptions = ""
            LblVoteStatus.Text = "Голосование: Выбор завершен!"
            LblVoteStatus.TextColor3 = Color3.fromRGB(100, 255, 120)
        end
    end
end

-- Поллинг голосования раз в 0.5с (нагрузка 0%)
task.spawn(function()
    while not isTerminated do
        task.wait(0.5)
        CheckVotingState()
    end
end)

