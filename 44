local function UpdateLocalPlayerDisplay()
    local isAlive = LocalPlayer:GetAttribute("Alive") == true
    local isElite = LocalPlayer:GetAttribute("Elite") == true
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local hp = hum and math.floor(hum.Health) or 0
    local myRole = PlayerRolesCache[LocalPlayer.Name] or "None"

    LblLocalPlayerStatus.Text = string.format("Игрок: Alive=%s | Elite=%s | HP=%d | Роль: %s", 
        tostring(isAlive), tostring(isElite), hp, myRole)
end

local attrConn = LocalPlayer.AttributeChanged:Connect(function(attrName)
    local val = LocalPlayer:GetAttribute(attrName)
    Log(string.format("👤 [ИГРОК: АТРИБУТ] LocalPlayer изменил атрибут '%s' = %s", attrName, tostring(val)), "PLAYER")
    UpdateLocalPlayerDisplay()
end)
