local PlayerCoinsCache: { [string]: number } = {}
local PlayerRolesCache: { [string]: string } = {}
local PlayerAliveCache: { [string]: boolean } = {}

local function RegisterRemoteHook(name: string, callback: (...any) -> ())
    local re = FindRemoteEvent(name)
    if re then
        local conn = re.OnClientEvent:Connect(function(...)
            if isTerminated then return end
            callback(...)
        end)
        table.insert(activeConnections, conn)
        Log(string.format("📡 Перехватчик [%s] успешно подключен", name), "INFO")
    else
        Log(string.format("⚠️ RemoteEvent [%s] не найден в ReplicatedStorage", name), "WARN")
    end
end

