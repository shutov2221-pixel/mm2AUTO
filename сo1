type DetectionRecord = {
    CoinName: string,
    TouchTime: number?,
    Events: { [string]: number },
    FirstEventTime: number?,
    Order: { { Name: string, Time: number, DiffMs: number } },
    CardCreated: boolean
}

-- Общий счетчик побед каждого детекта
local WinStats = {
    ["TouchTransmitter Removed"] = 0,
    ["Coin.Parent == nil"] = 0,
    ["CoinContainer.ChildRemoved"] = 0,
    ["Transparency == 1"] = 0,
    ["Bag UI Text Count +1"] = 0
}

local TotalCoinsTested = 0
local ActiveCoinRecords: { [Instance]: DetectionRecord } = {}
local RecentCoinsByTime: { { Time: number, Record: DetectionRecord } } = {}

local function UpdateSummaryDisplay(mapName: string, activeCoinsCount: number)
    local lines = {}
    table.insert(lines, string.format("Карта: %s | Активных монет: %d | Протестировано: %d", mapName ~= "" and mapName or "Не найдена", activeCoinsCount, TotalCoinsTested))
    table.insert(lines, "Рейтинг скорости (кто сработал ПЕРВЫМ):")

    -- Сортировка по количеству побед
    local sorted = {}
    for name, wins in pairs(WinStats) do
        table.insert(sorted, { Name = name, Wins = wins })
    end
    table.sort(sorted, function(a, b) return a.Wins > b.Wins end)

    local parts = {}
    for i, item in ipairs(sorted) do
        local medal = (i == 1 and "🥇" or (i == 2 and "🥈" or (i == 3 and "🥉" or "  ")))
        table.insert(parts, string.format("%s %-25s : %d", medal, item.Name, item.Wins))
    end

    table.insert(lines, table.concat(parts, "  |  "))
    SummaryText.Text = table.concat(lines, "\n")
end

-- Добавление карточки монеты в скролл-лог
local function AddLogCard(rec: DetectionRecord)
    if rec.CardCreated then return end
    rec.CardCreated = true

    local Card = Instance.new("Frame", ScrollContainer)
    Card.Size = UDim2.new(1, 0, 0, 0)
    Card.AutomaticSize = Enum.AutomaticSize.Y
    Card.BackgroundColor3 = Color3.fromRGB(24, 25, 33)
    Instance.new("UICorner", Card).CornerRadius = UDim.new(0, 4)

    local CardPadding = Instance.new("UIPadding", Card)
    CardPadding.PaddingTop = UDim.new(0, 5)
    CardPadding.PaddingBottom = UDim.new(0, 5)
    CardPadding.PaddingLeft = UDim.new(0, 6)
    CardPadding.PaddingRight = UDim.new(0, 6)

    local Layout = Instance.new("UIListLayout", Card)
    Layout.SortOrder = Enum.SortOrder.LayoutOrder
    Layout.Padding = UDim.new(0, 2)

    local Header = Instance.new("TextLabel", Card)
    Header.Size = UDim2.new(1, 0, 0, 16)
    Header.BackgroundTransparency = 1
    Header.Font = Enum.Font.GothamBold
    Header.TextSize = 11
    Header.TextXAlignment = Enum.TextXAlignment.Left

    local winner = rec.Order[1]
    local winnerName = winner and winner.Name or "Нет данных"
    Header.Text = string.format("🪙 Монета #%d (%s) — Победитель: %s", TotalCoinsTested, rec.CoinName, winnerName)
    Header.TextColor3 = Color3.fromRGB(255, 215, 0)

    for i, ev in ipairs(rec.Order) do
        local line = Instance.new("TextLabel", Card)
        line.Size = UDim2.new(1, 0, 0, 14)
        line.BackgroundTransparency = 1
        line.Font = Enum.Font.Gotham
        line.TextSize = 10
        line.TextXAlignment = Enum.TextXAlignment.Left

        local medal = (i == 1 and "🥇 1-е место:" or (i == 2 and "🥈 2-е место:" or (i == 3 and "🥉 3-е место:" or string.format("   %d-е место:", i))))
        local delayStr = (i == 1) and "+0.00 ms (БЫСТРЕЙШИЙ)" or string.format("+%.2f ms", ev.DiffMs)

        if i == 1 then
            line.TextColor3 = Color3.fromRGB(100, 255, 120)
        else
            line.TextColor3 = Color3.fromRGB(200, 200, 210)
        end

        line.Text = string.format("%s %-26s [%s]", medal, ev.Name, delayStr)
    end

    -- Авто-скролл вниз к новым событиям
    task.defer(function()
        ScrollContainer.CanvasPosition = Vector2.new(0, 999999)
    end)
end

-- Обработка завершения замера по конкретной монете
local function FinalizeCoinRecord(coin: Instance, rec: DetectionRecord)
    if rec.CardCreated then return end

    -- Собираем и сортируем все события этой монеты по времени
    local list = {}
    for name, t in pairs(rec.Events) do
        table.insert(list, { Name = name, Time = t })
    end
    table.sort(list, function(a, b) return a.Time < b.Time end)

    if #list == 0 then return end

    local baseTime = list[1].Time
    for _, item in ipairs(list) do
        item.DiffMs = (item.Time - baseTime) * 1000
    end

    rec.Order = list
    TotalCoinsTested = TotalCoinsTested + 1

    -- Засчитываем победу
    local winner = list[1].Name
    if WinStats[winner] ~= nil then
        WinStats[winner] = WinStats[winner] + 1
    end

    AddLogCard(rec)
    ActiveCoinRecords[coin] = nil
end

local function RecordCoinEvent(coin: Instance, eventName: string)
    local now = os.clock()
    local rec = ActiveCoinRecords[coin]
    if not rec then
        rec = {
            CoinName = coin.Name,
            Events = {},
            Order = {},
            CardCreated = false
        }
        ActiveCoinRecords[coin] = rec
        table.insert(RecentCoinsByTime, { Time = now, Record = rec })
    end

    if not rec.Events[eventName] then
        rec.Events[eventName] = now
    end

    -- Тайм-аут на сбор остальных возможных событий этой же монеты (0.25 сек)
    task.delay(0.25, function()
        if not IsTerminated and not rec.CardCreated then
            FinalizeCoinRecord(coin, rec)
        end
    end)
end

