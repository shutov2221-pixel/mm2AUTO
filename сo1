-- СЛЕДИМ ЗА GUI СУМКИ (ДЕТЕКТ "Bag UI Text Count +1")
-- =====================================================================
local function SetupBagWatcher()
    task.spawn(function()
        local playerGui = LocalPlayer:WaitForChild("PlayerGui", 15)
        if not playerGui then return end

        local function hookCoinsLabel(label: TextLabel)
            RegisterConnection(label:GetPropertyChangedSignal("Text"):Connect(function()
                if IsTerminated then return end
                local now = os.clock()

                -- Находим самую недавнюю монету, которая сейчас фиксирует события
                for i = #RecentCoinsByTime, 1, -1 do
                    local entry = RecentCoinsByTime[i]
                    if (now - entry.Time) < 1.0 and not entry.Record.CardCreated then
                        if not entry.Record.Events["Bag UI Text Count +1"] then
                            entry.Record.Events["Bag UI Text Count +1"] = now
                        end
                        break
                    end
                end
            end))
        end

        local function scanGui(gui: Instance)
            for _, desc in ipairs(gui:GetDescendants()) do
                if desc:IsA("TextLabel") and desc.Name == "Coins" and desc.Parent and desc.Parent.Name == "Icon" then
                    hookCoinsLabel(desc)
                end
            end
            RegisterConnection(gui.DescendantAdded:Connect(function(desc)
                if desc:IsA("TextLabel") and desc.Name == "Coins" and desc.Parent and desc.Parent.Name == "Icon" then
                    hookCoinsLabel(desc)
                end
            end))
        end

        local mainGui = playerGui:FindFirstChild("MainGUI")
        if mainGui then scanGui(mainGui) end
        RegisterConnection(playerGui.ChildAdded:Connect(function(c)
            if c.Name == "MainGUI" then scanGui(c) end
        end))
    end)
end

SetupBagWatcher()

-- =====================================================================
-- ПОИСК КАРТЫ И ПОДКЛЮЧЕНИЕ СЛУШАТЕЛЕЙ К МОНЕТАМ
-- =====================================================================
local function FindCurrentMap(): Instance?
    for _, v in ipairs(Workspace:GetChildren()) do
        if v:FindFirstChild("CoinContainer") then
            return v
        end
    end
    return nil
end

local ActiveCoinTransmitters: { [Instance]: RBXScriptConnection } = {}

local function HookCoin(coinPart: BasePart, container: Instance)
    if not coinPart or not coinPart:IsA("BasePart") then return end

    -- 1. Детект: Изменение Transparency
    RegisterConnection(coinPart:GetPropertyChangedSignal("Transparency"):Connect(function()
        if IsTerminated then return end
        if coinPart.Transparency >= 0.99 then
            RecordCoinEvent(coinPart, "Transparency == 1")
        end
    end))

    -- 2. Детект: Coin.Parent == nil / сменился родитель
    RegisterConnection(coinPart.AncestryChanged:Connect(function(_, parent)
        if IsTerminated then return end
        if parent == nil or not coinPart:IsDescendantOf(Workspace) then
            RecordCoinEvent(coinPart, "Coin.Parent == nil")
        end
    end))

    -- 3. Детект: Удаление TouchTransmitter из монеты
    local tt = coinPart:FindFirstChildWhichIsA("TouchTransmitter")
    if tt then
        RegisterConnection(tt.AncestryChanged:Connect(function(_, parent)
            if IsTerminated then return end
            if parent == nil or parent ~= coinPart then
                RecordCoinEvent(coinPart, "TouchTransmitter Removed")
            end
        end))
    end

    RegisterConnection(coinPart.ChildRemoved:Connect(function(child)
        if IsTerminated then return end
        if child:IsA("TouchTransmitter") or child.Name == "TouchInterest" then
            RecordCoinEvent(coinPart, "TouchTransmitter Removed")
        end
    end))

    -- 4. Фиксация физического касания нашим персонажем (для сравнения задержки сервера)
    RegisterConnection(coinPart.Touched:Connect(function(hit)
        if IsTerminated then return end
        local myChar = LocalPlayer.Character
        if myChar and hit:IsDescendantOf(myChar) then
            local rec = ActiveCoinRecords[coinPart]
            if not rec then
                RecordCoinEvent(coinPart, "Character Touched (Local)")
            end
        end
    end))
end

-- Основной цикл отслеживания карты и монет
task.spawn(function()
    local lastMap: Instance? = nil
    local containerConn: RBXScriptConnection? = nil

    while not IsTerminated do
        local map = FindCurrentMap()
        local container = map and map:FindFirstChild("CoinContainer")

        if map and container then
            local mapName = map.Name

            -- Подключаем CoinContainer.ChildRemoved (Детект #3)
            if map ~= lastMap then
                lastMap = map
                if containerConn then containerConn:Disconnect() end

                containerConn = container.ChildRemoved:Connect(function(child)
                    if IsTerminated then return end
                    local target = child:IsA("BasePart") and child or (child:FindFirstChildWhichIsA("BasePart"))
                    if target then
                        RecordCoinEvent(target, "CoinContainer.ChildRemoved")
                    end
                end)
                RegisterConnection(containerConn)

                StatusLabel.Text = "Карта активна: " .. mapName .. " | Мониторинг готов"
                StatusLabel.TextColor3 = Color3.fromRGB(100, 255, 120)
            end

            -- Подключаем слушатели ко всем монетам
            local coinsCount = 0
            for _, desc in ipairs(container:GetDescendants()) do
                if desc:IsA("TouchTransmitter") and desc.Parent and desc.Parent:IsA("BasePart") then
                    coinsCount = coinsCount + 1
                    local part = desc.Parent
                    if not ActiveCoinTransmitters[part] then
                        ActiveCoinTransmitters[part] = desc.AncestryChanged
                        HookCoin(part, container)
                    end
                end
            end

            UpdateSummaryDisplay(mapName, coinsCount)
        else
            lastMap = nil
            StatusLabel.Text = "Ожидание карты / раунда..."
            StatusLabel.TextColor3 = Color3.fromRGB(255, 180, 50)
            UpdateSummaryDisplay("Нет", 0)
        end

        task.wait(0.5)
    end
end)

