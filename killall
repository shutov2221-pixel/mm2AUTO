-- Функция добавления лога
local function Log(msg: string, msgType: string?)
    if isTerminated then return end
    logCount = logCount + 1

    local timeStr = os.date("%X")
    local typeColor = Color3.fromRGB(210, 210, 210)
    local prefix = "[INFO]"

    if msgType == "SUCCESS" then
        typeColor = Color3.fromRGB(100, 255, 120)
        prefix = "[OK]"
    elseif msgType == "WARN" then
        typeColor = Color3.fromRGB(255, 200, 50)
        prefix = "[WARN]"
    elseif msgType == "ERROR" then
        typeColor = Color3.fromRGB(255, 80, 80)
        prefix = "[ERR]"
    elseif msgType == "TARGET" then
        typeColor = Color3.fromRGB(80, 220, 255)
        prefix = "[TARGET]"
    elseif msgType == "KILL" then
        typeColor = Color3.fromRGB(255, 100, 255)
        prefix = "[KILL]"
    end

    local fullText = string.format("[%s] %s %s", timeStr, prefix, msg)
    print("[MM2 DEBUG] " .. fullText)

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -5, 0, 0)
    lbl.AutomaticSize = Enum.AutomaticSize.Y
    lbl.BackgroundTransparency = 1
    lbl.Text = fullText
    lbl.TextColor3 = typeColor
    lbl.Font = Enum.Font.Code
    lbl.TextSize = 11
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.TextWrapped = true
    lbl.LayoutOrder = logCount
    lbl.Parent = LogScroll

    -- Ограничение количества строк
    local children = LogScroll:GetChildren()
    if #children > MAX_LOGS then
        for i = 1, #children - MAX_LOGS do
            if children[i]:IsA("TextLabel") then
                children[i]:Destroy()
            end
        end
    end

    -- Авто-скролл вниз
    task.defer(function()
        LogScroll.CanvasPosition = Vector2.new(0, LogLayout.AbsoluteContentSize.Y)
    end)
end

local function ClearLogs()
    for _, child in ipairs(LogScroll:GetChildren()) do
        if child:IsA("TextLabel") then
            child:Destroy()
        end
    end
    logCount = 0
    Log("Логи очищены", "INFO")
end

