    BtnKill.Text = "⚡ KILL ALL: СТАРТ"
    BtnKill.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
    UpdateStatus("Kill All остановлен", Color3.fromRGB(200, 200, 200))
    Log("Цикл Kill All остановлен", "INFO")
end

local function KillTarget(targetPlayer: Player)
    if not targetPlayer or not targetPlayer.Character then return end

    local myChar = LocalPlayer.Character
    if not myChar then return end

    local myHRP = myChar:FindFirstChild("HumanoidRootPart") or myChar:FindFirstChild("Torso") or myChar.PrimaryPart
    local myHum = myChar:FindFirstChildOfClass("Humanoid")
    if not myHRP or not myHum or myHum.Health <= 0 then return end

    local targetChar = targetPlayer.Character
    local targetHRP = targetChar:FindFirstChild("HumanoidRootPart") or targetChar:FindFirstChild("Torso") or targetChar.PrimaryPart
    local targetHum = targetChar:FindFirstChildOfClass("Humanoid")
    if not targetHRP or not targetHum or targetHum.Health <= 0 then return end

    Log(string.format("Телепорт к цели: %s (@%s)", targetPlayer.DisplayName, targetPlayer.Name), "KILL")
    UpdateStatus("Атака: " .. targetPlayer.DisplayName, Color3.fromRGB(255, 80, 80))

    -- Убеждаемся что нож в руке
    local tool = myChar:FindFirstChildOfClass("Tool")
    if not tool then
        tool = InspectAndEquipKnife()
    end

    local attackStart = tick()

    while isRunning and not isTerminated do
        -- Таймаут 4 секунды на цель (чтобы не зависать)
        if tick() - attackStart > 4 then
            Log("Таймаут атаки (4с) на " .. targetPlayer.Name, "WARN")
            break
        end

        -- Проверка нашего персонажа
        myChar = LocalPlayer.Character
        myHRP = myChar and (myChar:FindFirstChild("HumanoidRootPart") or myChar:FindFirstChild("Torso") or myChar.PrimaryPart)
        myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")
        if not myChar or not myHRP or not myHum or myHum.Health <= 0 then
            Log("Наш персонаж погиб во время атаки!", "ERROR")
            break
        end

        -- Проверка персонажа цели: жива ли?
        if not targetPlayer.Parent or not targetChar.Parent then
            Log("Цель покинула игру", "SUCCESS")
            break
        end

        targetHum = targetChar:FindFirstChildOfClass("Humanoid")
        targetHRP = targetChar:FindFirstChild("HumanoidRootPart") or targetChar:FindFirstChild("Torso") or targetChar.PrimaryPart
        if not targetHum or targetHum.Health <= 0 or not targetHRP then
            Log("ЦЕЛЬ УНИЧТОЖЕНА: " .. targetPlayer.DisplayName, "SUCCESS")
            break
        end

        -- Проверка: не сменился ли таргет в UI
        local label = FindTargetLabel()
        if label then
            local currentClean = CleanNickname(label.Text)
            if currentClean ~= "" and string.lower(currentClean) ~= string.lower(targetPlayer.Name) and string.lower(currentClean) ~= string.lower(targetPlayer.DisplayName) then
                Log("Цель в UI сменилась на '" .. currentClean .. "' — переключаюсь!", "INFO")
                break
            end
        end

        -- 1. Безопасная телепортация прямо к игроку (с отступом 1.2 studs спереди)
        pcall(function()
            local targetCF = targetHRP.CFrame * CFrame.new(0, 0, -1.2)
            myHRP.CFrame = targetCF
            myHRP.AssemblyLinearVelocity = Vector3.zero
        end)

        -- 2. Взмах ножом (только чистый нативный Tool:Activate(), БЕЗ крашащих функций)
        tool = myChar:FindFirstChildOfClass("Tool")
        if not tool then
            tool = InspectAndEquipKnife()
        end

        if tool then
            pcall(function() tool:Activate() end)
        end

        task.wait(0.08)
    end
end

local function StartKillLoop()
    if isRunning then
        StopKillLoop()
        return
    end

    isRunning = true
    BtnKill.Text = "⚡ KILL ALL: СТОП"
    BtnKill.BackgroundColor3 = Color3.fromRGB(40, 180, 50)
    UpdateStatus("Kill All запущен", Color3.fromRGB(100, 255, 100))
    Log("--- СТАРТ ЦИКЛА KILL ALL ---", "KILL")

    task.spawn(function()
        -- Сразу достаём нож в руку
        InspectAndEquipKnife()

        local noTargetCounter = 0

        while isRunning and not isTerminated do
            local myChar = LocalPlayer.Character
            local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")
            if not myChar or not myHum or myHum.Health <= 0 then
                Log("Персонаж погиб — остановка Kill All", "ERROR")
                break
            end

            -- Быстрый поиск цели (без лишнего спама в лог)
            local label = FindTargetLabel()
            local targetPlayer: Player? = nil

            if label then
                local cleanName = CleanNickname(label.Text)
                if cleanName ~= "" and cleanName ~= "Label" and cleanName ~= "None" then
                    targetPlayer = FindPlayerByName(cleanName)
                end
            end

            if targetPlayer and targetPlayer.Character then
                local hum = targetPlayer.Character:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 then
                    noTargetCounter = 0
                    KillTarget(targetPlayer)
                    task.wait(0.1)
                else
                    targetPlayer = nil
                end
            end

            if not targetPlayer then
                noTargetCounter = noTargetCounter + 1
                UpdateStatus("Ожидание цели (" .. noTargetCounter .. "/10)", Color3.fromRGB(255, 180, 50))

                -- Ждём смены текста в лейбле до 0.5с
                local textChanged = false
                local conn: RBXScriptConnection? = nil
                if label then
                    conn = label:GetPropertyChangedSignal("Text"):Connect(function()
                        textChanged = true
                    end)
                end

                local waitStart = tick()
                while tick() - waitStart < 0.5 and not textChanged and isRunning do
                    task.wait(0.05)
                end

                if conn then conn:Disconnect() end

                -- Если цели нет более 5 секунд — раунд завершен
                if noTargetCounter >= 10 then
                    Log("Таргеты закончились / Раунд завершен", "SUCCESS")
                    UpdateStatus("Раунд завершен", Color3.fromRGB(100, 255, 100))
                    break
                end
            end
        end

        StopKillLoop()
    end)
