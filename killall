-- ПОИСК ЭЛЕМЕНТА ТАРГЕТА В ИНТЕРФЕЙСЕ (СКАНЕР)
-- =====================================================================
local function FindTargetLabel(): (TextLabel?, string)
    local pGui = LocalPlayer:FindFirstChildOfClass("PlayerGui") or LocalPlayer:FindFirstChild("PlayerGui")
    if not pGui then
        return nil, "PlayerGui не найден!"
    end

    -- 1. Проверяем точный путь: MainGUI.Game.AssassinTarget.TargetName
    local mGui = pGui:FindFirstChild("MainGUI")
    if mGui then
        local gameObj = mGui:FindFirstChild("Game")
        if gameObj then
            local targetFrame = gameObj:FindFirstChild("AssassinTarget")
            if targetFrame then
                local label = targetFrame:FindFirstChild("TargetName")
                if label and label:IsA("TextLabel") then
                    return label, "MainGUI.Game.AssassinTarget.TargetName (Точный путь)"
                end
            end
        end
    end

    -- 2. Резервный поиск: AssassinTarget в любом месте PlayerGui
    local altFrame = pGui:FindFirstChild("AssassinTarget", true)
    if altFrame then
        local label = altFrame:FindFirstChild("TargetName")
        if label and label:IsA("TextLabel") then
            return label, altFrame:GetFullName() .. ".TargetName (Поиск по AssassinTarget)"
        end
    end

    -- 3. Резервный поиск: любой TextLabel с именем TargetName
    local anyLabel = pGui:FindFirstChild("TargetName", true)
    if anyLabel and anyLabel:IsA("TextLabel") then
        return anyLabel, anyLabel:GetFullName() .. " (Поиск по TargetName)"
    end

    return nil, "Элемент не найден в дереве PlayerGui"
end

-- Очистка текста от скобок [], кавычек, префиксов
local function CleanNickname(raw: string): string
    if not raw then return "" end
    local cleaned = raw
    -- Удаляем квадратные скобки [ ], кавычки, круглые скобки
    cleaned = string.gsub(cleaned, "[%[%]%<%>%(%)\"\'%{催]", "")
    -- Удаляем префиксы "Target:", "Eliminate:", "@"
    cleaned = string.gsub(cleaned, "^%s*[Tt]arget[:%s]*", "")
    cleaned = string.gsub(cleaned, "^%s*[Ee]liminate[:%s]*", "")
    cleaned = string.gsub(cleaned, "^%s*@?", "")
    -- Удаляем пробелы по краям
    cleaned = string.gsub(cleaned, "^%s*(.-)%s*$", "%1")
    return cleaned
end

-- Поиск игрока в списке Players
local function FindPlayerByName(cleanName: string): (Player?, string)
    if cleanName == "" or cleanName == "Label" or cleanName == "None" then
        return nil, "Имя пусто или заглушка ('" .. tostring(cleanName) .. "')"
    end

    -- 1. Точный поиск по Username
    local exact = Players:FindFirstChild(cleanName)
    if exact then
        return exact, "Точное совпадение по Name"
    end

    -- 2. Регистронезависимый поиск по Name и DisplayName
    local lowerClean = string.lower(cleanName)
    for _, pl in ipairs(Players:GetPlayers()) do
        if pl ~= LocalPlayer then
            if string.lower(pl.Name) == lowerClean then
                return pl, "Совпадение по lower(Name)"
            end
            if string.lower(pl.DisplayName) == lowerClean then
                return pl, "Совпадение по lower(DisplayName)"
            end
        end
    end

    -- 3. Частичный поиск (если ник урезан)
    for _, pl in ipairs(Players:GetPlayers()) do
        if pl ~= LocalPlayer then
            if string.find(string.lower(pl.Name), lowerClean, 1, true) then
                return pl, "Частичное совпадение с Name: " .. pl.Name
            end
            if string.find(string.lower(pl.DisplayName), lowerClean, 1, true) then
                return pl, "Частичное совпадение с DisplayName: " .. pl.DisplayName
            end
        end
    end

    return nil, "Игрок '" .. cleanName .. "' не найден среди " .. #Players:GetPlayers() .. " игроков"
end

-- Полный диагностический скан таргета
local function RunTargetScan()
    Log("--- ЗАПУСК СКАНА ТАРГЕТА ---", "TARGET")

    local label, pathInfo = FindTargetLabel()
    if not label then
        Log("ОШИБКА: " .. pathInfo, "ERROR")
        UpdateStatus("Скан: TargetName не найден в UI", Color3.fromRGB(255, 80, 80))
        return nil
    end

    Log("Найден UI элемент: " .. pathInfo, "SUCCESS")
    Log(string.format("Параметры лейбла: Visible=%s, Parent.Visible=%s", tostring(label.Visible), tostring(label.Parent and label.Parent.Visible)), "INFO")

    local rawText = label.Text
    Log(string.format("Исходный текст (.Text): '%s'", tostring(rawText)), "TARGET")

    local cleaned = CleanNickname(rawText)
    Log(string.format("После очистки от скобок/префиксов: '%s'", cleaned), "TARGET")

    if cleaned == "" or cleaned == "Label" or cleaned == "None" then
        Log("Внимание: цель в лейбле отсутствует (раунд не начался или цель сменилась)", "WARN")
        UpdateStatus("Скан: Цель отсутствует в UI", Color3.fromRGB(255, 200, 50))
        return nil
    end

    local player, matchReason = FindPlayerByName(cleaned)
    if not player then
        Log("ОШИБКА ПОИСКА: " .. matchReason, "ERROR")
        -- Выводим всех текущих игроков для наглядности
        local list = {}
        for _, p in ipairs(Players:GetPlayers()) do
            table.insert(list, p.Name .. " (" .. p.DisplayName .. ")")
        end
        Log("Игроки на сервере: " .. table.concat(list, ", "), "INFO")
        UpdateStatus("Скан: Игрок не найден на сервере", Color3.fromRGB(255, 100, 100))
        return nil
    end

    Log(string.format("ИГРОК НАЙДЕН: %s (@%s) [%s]", player.DisplayName, player.Name, matchReason), "SUCCESS")

    local char = player.Character
    if not char then
        Log("Предупреждение: Персонаж игрока не загружен (Character == nil)", "WARN")
        UpdateStatus("Скан: Персонаж не загружен", Color3.fromRGB(255, 200, 50))
        return nil
    end

    local hum = char:FindFirstChildOfClass("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso") or char.PrimaryPart

    local hp = hum and hum.Health or 0
    local isAlive = hp > 0
    Log(string.format("Статус цели: Здоровье=%.1f, Жив=%s, Корень=%s", hp, tostring(isAlive), hrp and hrp.Name or "НЕТ"), isAlive and "SUCCESS" or "WARN")

    if hrp and LocalPlayer.Character and LocalPlayer.Character.PrimaryPart then
        local dist = (hrp.Position - LocalPlayer.Character.PrimaryPart.Position).Magnitude
        Log(string.format("Дистанция до цели: %.1f studs", dist), "INFO")
    end

    UpdateStatus("Скан: Цель " .. player.DisplayName .. " (HP: " .. math.floor(hp) .. ")", Color3.fromRGB(100, 255, 100))
    return player
end

-- =====================================================================
-- ТЕСТИРОВАНИЕ И ЭКИПИРОВКА НОЖА
-- =====================================================================
local function InspectAndEquipKnife(): Tool?
    Log("--- ПРОВЕРКА ИНВЕНТАРЯ И ЭКИПИРОВКА НОЖА ---", "INFO")

    local char = LocalPlayer.Character
    if not char then
        Log("Ошибка: Персонаж игрока не найден!", "ERROR")
        return nil
    end

    -- 1. Проверяем, держим ли нож прямо сейчас
    for _, item in ipairs(char:GetChildren()) do
        if item:IsA("Tool") then
            Log(string.format("Нож уже в руках: '%s' (Class: %s)", item.Name, item.ClassName), "SUCCESS")
            UpdateStatus("Нож в руке: " .. item.Name, Color3.fromRGB(100, 255, 100))
            return item
        end
    end

    -- 2. Инспектируем рюкзак (Backpack)
    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack") or LocalPlayer:FindFirstChild("Backpack")
    if not backpack then
        Log("Ошибка: Backpack не найден у LocalPlayer!", "ERROR")
        return nil
    end

    local allTools = {}
    for _, item in ipairs(backpack:GetChildren()) do
        table.insert(allTools, string.format("'%s' (%s)", item.Name, item.ClassName))
    end
    Log("Содержимое Backpack: " .. (#allTools > 0 and table.concat(allTools, ", ") or "ПУСТО"), "INFO")

    -- 3. Ищем Tool ножа
    local knife: Tool? = nil
    knife = backpack:FindFirstChild("Knife") :: Tool?

    if not knife then
        for _, item in ipairs(backpack:GetChildren()) do
            if item:IsA("Tool") and (item.Name == "Knife" or string.find(string.lower(item.Name), "knife")) then
                knife = item
                break
            end
        end
    end

    -- Резерв: любой доступный Tool в рюкзаке
    if not knife then
        knife = backpack:FindFirstChildOfClass("Tool")
    end

    if not knife then
        Log("НОЖ НЕ НАЙДЕН: В Backpack нет инструментов (возможно вы не убийца/ассасин)", "WARN")
        UpdateStatus("Нож не найден в инвентаре", Color3.fromRGB(255, 150, 50))
        return nil
    end

    Log(string.format("Найден предмет ножа: '%s'. Пробую экипировать...", knife.Name), "INFO")

    -- Пробуем официальный Humanoid:EquipTool
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then
        local equipOk, equipErr = pcall(function() hum:EquipTool(knife) end)
        if equipOk then
            Log("Вызов Humanoid:EquipTool выполнен", "INFO")
        else
            Log("Humanoid:EquipTool вернул ошибку: " .. tostring(equipErr), "WARN")
        end
    end

    task.wait(0.05)

    -- Если всё ещё не в персонаже — форсируем Parent
    if knife.Parent ~= char then
        Log("Форсирую перенос: knife.Parent = Character...", "INFO")
        pcall(function() knife.Parent = char end)
    end

    task.wait(0.05)

    if char:FindFirstChild(knife.Name) or char:FindFirstChildOfClass("Tool") then
        Log("УСПЕХ: Нож успешно взят в руку!", "SUCCESS")
        UpdateStatus("Нож взят: " .. knife.Name, Color3.fromRGB(100, 255, 100))
        return knife
    else
        Log("ОШИБКА: Не удалось переместить нож в персонажа!", "ERROR")
        UpdateStatus("Ошибка взятия ножа", Color3.fromRGB(255, 80, 80))
        return nil
    end
end

