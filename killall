local function BindClick(btn, callback)
    local debounce = false
    local function fire()
        if debounce or isTerminated then return end
        debounce = true
        task.spawn(callback)
        task.wait(0.15)
        debounce = false
    end
    btn.Activated:Connect(fire)
    btn.MouseButton1Click:Connect(fire)
end

BindClick(BtnScan, RunTargetScan)
BindClick(BtnEquip, InspectAndEquipKnife)
BindClick(BtnKill, StartKillLoop)
BindClick(BtnClear, ClearLogs)

-- Закрытие скрипта
local function Terminate()
    if isTerminated then return end
    isTerminated = true
    isRunning = false

    for _, conn in ipairs(activeConnections) do
        if conn and conn.Connected then
            pcall(function() conn:Disconnect() end)
        end
    end
    table.clear(activeConnections)

    if ScreenGui and ScreenGui.Parent then
        ScreenGui:Destroy()
    end
    print("[MM2 DEBUG] Скрипт диагностики выгружен.")
end

BindClick(CloseBtn, Terminate)

