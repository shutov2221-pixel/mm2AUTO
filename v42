local function InspectAndEquipKnife(): Tool?
    local char = LocalPlayer.Character
    if not char then return nil end

    for _, item in ipairs(char:GetChildren()) do
        if item:IsA("Tool") and (item.Name == "Knife" or string.find(string.lower(item.Name), "knife")) then
            return item
        end
    end

    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack") or LocalPlayer:FindFirstChild("Backpack")
    if not backpack then return nil end

    local knife: Tool? = nil
    for _, item in ipairs(backpack:GetChildren()) do
        if item:IsA("Tool") and (item.Name == "Knife" or string.find(string.lower(item.Name), "knife")) then
            knife = item
            break
        end
    end
    if not knife then knife = backpack:FindFirstChildOfClass("Tool") end
    if not knife then return nil end

    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then pcall(function() hum:EquipTool(knife) end) end
    if knife.Parent ~= char then pcall(function() knife.Parent = char end) end

    task.wait(0.01)
    return knife
end

-- =====================================================================
-- НАДЕЖНЫЙ ТУРБО-УДАР (DOUBLE-PULSE FIRETOUCH)
-- =====================================================================
local function TurboKill(targetPlayer: Player, knife: Tool): boolean
    local targetChar = targetPlayer.Character
    if not targetChar then return false end

    local targetHRP = targetChar:FindFirstChild("HumanoidRootPart") or targetChar:FindFirstChild("Torso") :: BasePart?
    local targetHum = targetChar:FindFirstChildOfClass("Humanoid")
    local handle = knife:FindFirstChild("Handle") :: BasePart?

    if not targetHRP or not targetHum or targetHum.Health <= 0 or not handle then
        return false
    end

    pcall(function() knife:Activate() end)

    if firetouchinterest then
        -- Двойной импульс касания для 100% срабатывания физики сервера
        pcall(function()
            firetouchinterest(targetHRP, handle, 0)
            firetouchinterest(targetHRP, handle, 1)
            firetouchinterest(targetHRP, handle, 0)
            firetouchinterest(targetHRP, handle, 1)
        end)
        return true
    end
    return false
end

-- Одиночный удар
local function RunSingleTargetKill()
    local knife = InspectAndEquipKnife()
    if not knife then
        Log("Нож не найден в инвентаре!", "ERROR")
        return
    end

    local target = RunTargetScan()
    if not target then
        Log("Цель не найдена в UI!", "WARN")
        return
    end

    local startTime = tick()
    local ok = TurboKill(target, knife)
    if ok then
        local ms = math.floor((tick() - startTime) * 1000)
        Log(string.format("🎯 1-Shot нанесён по %s за %d мс!", target.DisplayName, ms), "SUCCESS")
        UpdateStatus("Ликвидирован: " .. target.DisplayName, Color3.fromRGB(100, 255, 120))
    end
end

-- =====================================================================
-- СЕТЕВОЙ ГИБРИД: ПАКЕТНЫЙ ПЕРЕХВАТ (ChangeTarget) + РЕЗЕРВНЫЙ UI WATCHDOG
-- =====================================================================
local function FindRemoteEvent(name: string): RemoteEvent?
    local direct = ReplicatedStorage:FindFirstChild(name)
    if direct and direct:IsA("RemoteEvent") then return direct end
    local deep = ReplicatedStorage:FindFirstChild(name, true)
    if deep and deep:IsA("RemoteEvent") then return deep end
    for _, item in ipairs(ReplicatedStorage:GetDescendants()) do
        if item:IsA("RemoteEvent") and item.Name == name then
            return item
        end
    end
    return nil
end

local networkTargetConn: RBXScriptConnection? = nil
local roundEndConn: RBXScriptConnection? = nil
local chainConnection: RBXScriptConnection? = nil
local activeTargetPlayer: Player? = nil
local activeTargetName = ""
local killAttemptsForTarget = 0

local function StopKillLoop()
    isRunning = false
    activeTargetPlayer = nil
    activeTargetName = ""
    killAttemptsForTarget = 0

    if networkTargetConn then
        networkTargetConn:Disconnect()
        networkTargetConn = nil
    end
    if roundEndConn then
        roundEndConn:Disconnect()
        roundEndConn = nil
    end
    if chainConnection then
        chainConnection:Disconnect()
        chainConnection = nil
    end

    BtnKill.Text = "⚡ ТУРБО-ЦЕПОЧКА"
    BtnKill.BackgroundColor3 = Color3.fromRGB(200, 45, 45)
    UpdateStatus("Турбо-цепочка остановлена", Color3.fromRGB(200, 200, 200))
    Log("Турбо-цепочка остановлена", "INFO")
end

-- Прямой удар по объекту игрока (вызывается из сети и из UI)
local function AttackTargetPlayer(targetPlayer: Player, knife: Tool): boolean
    if not targetPlayer or not targetPlayer.Character then return false end

    local hum = targetPlayer.Character:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end

    -- Если пришел новый таргет — сбрасываем счетчик попыток
    if targetPlayer.Name ~= activeTargetName then
        activeTargetName = targetPlayer.Name
        killAttemptsForTarget = 0
    end

    killAttemptsForTarget = killAttemptsForTarget + 1
    local tStart = tick()
    local ok = TurboKill(targetPlayer, knife)
    local ms = math.floor((tick() - tStart) * 1000)

    if killAttemptsForTarget == 1 then
        Log(string.format("⚡ [%d мс] Атака цели: %s (@%s)", ms, targetPlayer.DisplayName, targetPlayer.Name), "KILL")
        UpdateStatus("Атака: " .. targetPlayer.DisplayName, Color3.fromRGB(255, 80, 80))
    elseif killAttemptsForTarget % 3 == 0 then
        Log(string.format("🔄 Добивание: %s (Попытка %d)", targetPlayer.DisplayName, killAttemptsForTarget), "WARN")
    end
    return ok
end

-- Функция нанесения удара по текущей цели из UI (резерв)
local function AttackTargetFromLabel(label: TextLabel, knife: Tool)
    if not IsTargetVisible(label) then return end

    local rawText = label.Text
    local cleanName = CleanNickname(rawText)
    if cleanName == "" or cleanName == "Label" or cleanName == "None" then return end

    local targetPlayer = FindPlayerByName(cleanName)
    if not targetPlayer or not targetPlayer.Character then return end

    activeTargetPlayer = targetPlayer
    AttackTargetPlayer(targetPlayer, knife)
end

local function StartKillLoop()
    if isRunning then
        StopKillLoop()
        return
    end

    isRunning = true
    activeTargetPlayer = nil
    activeTargetName = ""
    killAttemptsForTarget = 0

    BtnKill.Text = "⚡ СТОП ТУРБО"
    BtnKill.BackgroundColor3 = Color3.fromRGB(40, 180, 50)
    UpdateStatus("Сетевой Турбо-режим АКТИВЕН", Color3.fromRGB(100, 255, 100))
    Log("--- СТАРТ СЕТЕВОЙ ТУРБО-ЦЕПОЧКИ v5.0 ---", "KILL")

    task.spawn(function()
        local knife = InspectAndEquipKnife()
        if not knife then
            Log("Ошибка: Нож не найден!", "ERROR")
            StopKillLoop()
            return
        end

        -- 1. СЕТЕВОЙ ПЕРЕХВАТ: Слушаем ChangeTarget RemoteEvent (0 мс задержки)
        local changeTargetEvent = FindRemoteEvent("ChangeTarget")
        if changeTargetEvent then
            if networkTargetConn then networkTargetConn:Disconnect() end
            networkTargetConn = changeTargetEvent.OnClientEvent:Connect(function(targetName: any, _, _, targetUserId: any)
                if not isRunning or isTerminated then return end

                local targetPlr: Player? = nil
                if typeof(targetUserId) == "number" and targetUserId > 0 then
                    targetPlr = Players:GetPlayerByUserId(targetUserId)
                end
                if not targetPlr and typeof(targetName) == "string" and targetName ~= "" then
                    targetPlr = Players:FindFirstChild(targetName)
                end

                if targetPlr then
                    activeTargetPlayer = targetPlr
                    Log(string.format("📡 [СЕТЬ 0мс] Новый таргет: %s (@%s)", targetPlr.DisplayName, targetPlr.Name), "TARGET")

                    local myChar = LocalPlayer.Character
                    if knife.Parent ~= myChar then
                        knife = InspectAndEquipKnife() or knife
                    end
                    AttackTargetPlayer(targetPlr, knife)
                end
            end)
            Log("📡 Сетевой перехват [ChangeTarget] подключен (" .. changeTargetEvent.Name .. ")", "SUCCESS")
        else
            Log("Предупреждение: ChangeTarget не найден, работаем через UI", "WARN")
        end

        -- 2. СЕТЕВОЙ ПЕРЕХВАТ ОКОНЧАНИЯ РАУНДА (RoundEndFade)
        local roundEndEvent = FindRemoteEvent("RoundEndFade")
        if roundEndEvent then
            if roundEndConn then roundEndConn:Disconnect() end
            roundEndConn = roundEndEvent.OnClientEvent:Connect(function()
                if isRunning then
                    Log("🏁 [СЕТЬ] Раунд окончен (пакет RoundEndFade)", "SUCCESS")
                    UpdateStatus("РАУНД ВЫИГРАН! Победа.", Color3.fromRGB(100, 255, 120))
                    StopKillLoop()
                end
            end)
        end

        -- 3. Резервный старт: сразу бьем цель из UI (если раунд уже начался до включения кнопки)
        local initialLabel = FindTargetLabel()
        if initialLabel and IsTargetVisible(initialLabel) then
            AttackTargetFromLabel(initialLabel, knife)
        end

        -- 4. Резервный слушатель UI (GetPropertyChangedSignal)
        if initialLabel then
            if chainConnection then chainConnection:Disconnect() end
            chainConnection = initialLabel:GetPropertyChangedSignal("Text"):Connect(function()
                if not isRunning or isTerminated then return end
                AttackTargetFromLabel(initialLabel, knife)
            end)
        end

        -- 5. Watchdog-цикл (гарантия добивания каждые 0.05с + проверка окончания)
        local emptyCounter = 0
        while isRunning and not isTerminated do
            task.wait(0.05)

            local myChar = LocalPlayer.Character
            local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")
            if not myChar or not myHum or myHum.Health <= 0 then
                Log("Персонаж погиб — остановка", "ERROR")
                break
            end

            -- Убеждаемся что нож наготове
            if knife.Parent ~= myChar then
                knife = InspectAndEquipKnife() or knife
            end

            -- Авто-добивание: если цель еще жива, повторяем импульс
            if activeTargetPlayer and activeTargetPlayer.Character then
                local hum = activeTargetPlayer.Character:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 then
                    AttackTargetPlayer(activeTargetPlayer, knife)
                end
            end

            -- Проверяем UI на скрытие окна и окончание раунда
            local currentLabel = FindTargetLabel()
            local isVisible = IsTargetVisible(currentLabel)
            local raw = currentLabel and currentLabel.Text or ""
            local clean = CleanNickname(raw)

            local hasTarget = isVisible and clean ~= "" and clean ~= "Label" and clean ~= "None"

            if not hasTarget then
                emptyCounter = emptyCounter + 1
                -- Если окно таргета скрыто или цель отсутствует ~0.5 сек (10 тиков по 0.05с) — раунд окончен
                if emptyCounter >= 10 then
                    Log("Окно таргетов скрыто! Все игроки устранены.", "SUCCESS")
                    UpdateStatus("РАУНД ВЫИГРАН! Победа.", Color3.fromRGB(100, 255, 120))
                    break
                end
            else
                emptyCounter = 0
                -- Если цель в UI есть, а сетевой таргет еще не привязан — атакуем по UI
                if (not activeTargetPlayer or not activeTargetPlayer.Character) and currentLabel then
                    AttackTargetFromLabel(currentLabel, knife)
                end
            end
        end

        StopKillLoop()
    end)
end

