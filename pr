-- === ВСТРОЕННЫЙ МОДУЛЬ OCTREE ===
local Octree = (function()
local MAX_SUB_REGIONS = 4
local DEFAULT_TOP_REGION_SIZE = 512

local function IsPointInBox(point, boxCenter, boxSize)
local half = boxSize / 2
return point.X >= boxCenter.X - half and point.X <= boxCenter.X + half
and point.Y >= boxCenter.Y - half and point.Y <= boxCenter.Y + half
and point.Z >= boxCenter.Z - half and point.Z <= boxCenter.Z + half
end

local function RoundTo(x, mult)
return math.round(x / mult) * mult
end

local function SwapRemove(tbl, index)
local n = #tbl
tbl[index] = tbl[n]
tbl[n] = nil
end

local function CountNodesInRegion(region)
local n = 0
if region.Nodes then return #region.Nodes else
for _, subRegion in ipairs(region.Regions) do n += CountNodesInRegion(subRegion) end
end
return n
end

local function GetTopRegion(octree, position, create)
local size = octree.Size
local origin = Vector3.new(RoundTo(position.X, size), RoundTo(position.Y, size), RoundTo(position.Z, size))
local region = octree.Regions[origin]
if not region and create then
region = { Regions = {}, Level = 1, Size = size, Radius = math.sqrt(size * size * 3), Center = origin }
table.freeze(region)
octree.Regions[origin] = region
end
return region
end

local function GetRegionsInRadius(octree, position, radius)
local regionsFound = {}
local function ScanRegions(regions)
for _, region in ipairs(regions) do
local distance = (position - region.Center).Magnitude
if distance < (radius + region.Radius) then
if region.Nodes then table.insert(regionsFound, region) else ScanRegions(region.Regions) end
end
end
end
local startRegions = {}
local size = octree.Size
local maxOffset = math.ceil(radius / size)

if radius < size then
    for i = 0, 26 do
        local x, y, z = i % 3 - 1, math.floor(i / 9) - 1, math.floor(i / 3) % 3 - 1
        local startRegion = GetTopRegion(octree, position + Vector3.new(x * radius, y * radius, z * radius), false)
        if startRegion and not startRegions[startRegion] then
            startRegions[startRegion] = true
            ScanRegions(startRegion.Regions)
        end
    end
elseif maxOffset <= 3 then
    for x = -maxOffset, maxOffset do
        for y = -maxOffset, maxOffset do
            for z = -maxOffset, maxOffset do
                local startRegion = GetTopRegion(octree, position + Vector3.new(x * size, y * size, z * size), false)
                if startRegion and not startRegions[startRegion] then
                    startRegions[startRegion] = true
                    ScanRegions(startRegion.Regions)
                end
            end
        end
    end
else
    for _, region in octree.Regions do
        if (position - region.Center).Magnitude < (radius + region.Radius) then ScanRegions(region.Regions) end
    end
end
return regionsFound


end

local OctreeClass = {}
OctreeClass.__index = OctreeClass

local function CreateOctree(topRegionSize)
local self = setmetatable({}, OctreeClass)
self.Size = topRegionSize or DEFAULT_TOP_REGION_SIZE
self.Regions = {}
return self
end

function OctreeClass:ClearAllNodes() table.clear(self.Regions) end

function OctreeClass:GetAllNodes()
local all = {}
local function GetNodes(regions)
for _, region in regions do
if region.Nodes then
table.move(region.Nodes, 1, #region.Nodes, #all + 1, all)
else GetNodes(region.Regions) end
end
end
GetNodes(self.Regions)
return all
end

function OctreeClass:CreateNode(position, object)
local region = self:_getRegion(MAX_SUB_REGIONS, position)
local node = { Region = region, Position = position, Object = object }
table.insert(region.Nodes, node)
return node
end

function OctreeClass:FindFirstNode(object)
for _, node in ipairs(self:GetAllNodes()) do
if node.Object == object then return node end
end
return nil
end

function OctreeClass:RemoveNode(node)
if not node.Region then return end
local nodes = node.Region.Nodes
local index = table.find(nodes, node)
if index then SwapRemove(nodes, index) end
node.Region = nil
end

function OctreeClass:SearchRadius(position, radius)
local nodes = {}
for _, region in ipairs(GetRegionsInRadius(self, position, radius)) do
if region.Nodes then
for _, node in ipairs(region.Nodes) do
if (node.Position - position).Magnitude < radius then table.insert(nodes, node) end
end
end
end
return nodes
end

function OctreeClass:GetNearest(position, radius, maxNodes)
local nodes = self:SearchRadius(position, radius)
table.sort(nodes, function(a, b) return (a.Position - position).Magnitude < (b.Position - position).Magnitude end)
if maxNodes and #nodes > maxNodes then
return table.move(nodes, 1, maxNodes, 1, table.create(maxNodes))
end
return nodes
end

function OctreeClass:_getRegion(maxLevel, position)
local function GetRegion(regionParent, regions, level)
local region = nil
for _, r in regions do
if IsPointInBox(position, r.Center, r.Size) then region = r; break end
end
if not region then
local size = self.Size / (2 ^ (level - 1))
local origin = regionParent and regionParent.Center or Vector3.new(RoundTo(position.X, size), RoundTo(position.Y, size), RoundTo(position.Z, size))
local center = origin
if regionParent then
center += Vector3.new(
position.X > origin.X and size / 2 or -size / 2,
position.Y > origin.Y and size / 2 or -size / 2,
position.Z > origin.Z and size / 2 or -size / 2
)
end
region = { Regions = {}, Level = level, Size = size, Radius = math.sqrt(size * size * 3), Center = center, Parent = regionParent, Nodes = level == MAX_SUB_REGIONS and {} or nil }
table.insert(regions, region)
end
return level == maxLevel and region or GetRegion(region, region.Regions, level + 1)
end
local startRegion = GetTopRegion(self, position, true)
return GetRegion(startRegion, startRegion.Regions, 2)
end

return { new = CreateOctree }
end)()

