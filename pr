function rt:CheckIfGameInProgress() return rt:Map() ~= nil end

function rt:GetAlivePlayers()
local aliveplrs = setmetatable({}, {__mode = "v"})
local OldPos = self:Character():GetPivot()
local pos = CFrame.new(-121.995, 134.462, 46.418)

if not rt:CheckIfGameInProgress() then return nil end
local isAlive = rt:CheckIfPlayerIsInARound()
if not isAlive then self:Character():PivotTo(pos) end

for _, v in pairs(rt.Players:GetPlayers()) do
if v.Character and v.Character.PrimaryPart then
local distance = (self:Character().PrimaryPart.Position - v.Character.PrimaryPart.Position).Magnitude
if isAlive and distance <= 500 then table.insert(aliveplrs, v)
elseif not isAlive and distance > 500 then table.insert(aliveplrs, v) end
end
end
if not isAlive then self:Character():PivotTo(OldPos) end
return aliveplrs
end

function rt:CheckIfPlayerWasInARound() return self.player:GetAttribute("Alive") == true end
function rt:IsElite() return self.player:GetAttribute("Elite") == true end

local function AutoFarmCleanUp()
for _, connection in pairs(rt.positionChangeConnections) do
if connection.Connected then connection:Disconnect() end
end
if rt.Added then rt.Added:Disconnect() end
if rt.Removing then rt.Removing:Disconnect() end
table.clear(rt.touchedCoins)
table.clear(rt.positionChangeConnections)
rt.octree:ClearAllNodes()
end

-- === УНИВЕРСАЛЬНЫЙ ПОИСК МОНЕТ В UI (ИСПРАВЛЕНО ДЛЯ ТЕЛЕФОНОВ) ===
local function GetCoinsFromUI()
if not PLAYER_GUI then return 0 end

local maxFound = 0
local isMaxStr = false

pcall(function()
    -- Ищем по всему PlayerGui, игнорируя иерархию, так как на телефоне она другая
    for _, v in pairs(PLAYER_GUI:GetDescendants()) do
        if v:IsA("TextLabel") and (v.Name == "Coins" or string.find(v.Name, "Coin")) then
            local txt = string.lower(v.Text)
            
            if txt == "max" or txt == "full" then
                isMaxStr = true
            else
                local num = tonumber(string.match(txt, "%d+"))
                if num and num > maxFound then
                    maxFound = num
                end
            end
        end
    end
end)

if isMaxStr then
    return rt:IsElite() and 50 or 40
end
return maxFound


end

local function IsBagFull()
return GetCoinsFromUI() >= (rt:IsElite() and 50 or 40)
end

local function isCoinTouched(coin) return rt.touchedCoins[coin] end

local function markCoinAsTouched(coin)
if not rt then return end
rt.touchedCoins[coin] = true

-- Полностью удаляем монету из памяти поиска, чтобы бот не "зависал", пытаясь найти её снова
local node = rt.octree:FindFirstNode(coin)
if node then
    rt.octree:RemoveNode(node)
end


end

local function setupPositionTracking(coin, LastPositonY)
local connection
connection = coin:GetPropertyChangedSignal("Position"):Connect(function()
if LastPositonY and LastPositonY ~= coin.Position.Y then
markCoinAsTouched(coin)
if connection.Connected then connection:Disconnect() end
end
end)
rt.positionChangeConnections[coin] = connection
end

-- ЛЕГКИЙ И БЕЗОПАСНЫЙ МЕТОД ПЕРЕДВИЖЕНИЯ
local function moveToPositionSlowly(targetPosition, duration)
local char = rt:Character()
if not char or not char.PrimaryPart then return end

local hrp = char.PrimaryPart
local startPosition = hrp.Position
local startTime = tick()

while true do
    local elapsedTime = tick() - startTime
    local alpha = math.min(elapsedTime / duration, 1)
    if not rt:Character() or not char.PrimaryPart then break end

    -- Простое линейное перемещение (самое легкое для процессора)
    char:PivotTo(CFrame.new(startPosition:Lerp(targetPosition, alpha)))
    
    -- Обнуляем физические силы, чтобы игра не пыталась вытолкнуть персонажа из стен или закрутить
    hrp.AssemblyLinearVelocity = Vector3.zero
    hrp.AssemblyAngularVelocity = Vector3.zero
    
    if alpha >= 1 then 
        break 
    end
    RunService.Heartbeat:Wait()
end


end

local function populateOctree()
rt.octree:ClearAllNodes()
if not rt.coinContainer then return end
for _, descendant in pairs(rt.coinContainer:GetDescendants()) do
if descendant:IsA("TouchTransmitter") then
local parentCoin = descendant.Parent
if not isCoinTouched(parentCoin) then
rt.octree:CreateNode(parentCoin.Position, parentCoin)
setupPositionTracking(parentCoin, parentCoin.Position.Y)
end
end
end

rt.Added = rt.coinContainer.DescendantAdded:Connect(function(descendant)
if descendant:IsA("TouchTransmitter") then
local parentCoin = descendant.Parent
if not isCoinTouched(parentCoin) then
rt.octree:CreateNode(parentCoin.Position, parentCoin)
setupPositionTracking(parentCoin, parentCoin.Position.Y)
end
end
end)
end

local function ChangeState(newState) CurrentState = newState end
local function CheckMurderer() return IsMurderer end

local function CollectCoins()
Working = true
local map = rt:Map()
if map then rt.coinContainer = map:FindFirstChild("CoinContainer") end
populateOctree()

while CurrentState == State.Action and SETTINGS.AutoFarmEnabled do
if IsBagFull() then
BagIsFull = true
break
end

local char = rt:Character()
if not char or not char.PrimaryPart then break end

local nearestNodes = rt.octree:GetNearest(char.PrimaryPart.Position, SETTINGS.Radius, 5)
local targetCoin = nil

for _, node in ipairs(nearestNodes) do
    if not isCoinTouched(node.Object) then
        targetCoin = node.Object
        break
    end
end

if targetCoin then
    local targetPosition = targetCoin.Position
    local distance = (char.PrimaryPart.Position - targetPosition).Magnitude
    local duration = distance / SETTINGS.Speed
    
    moveToPositionSlowly(targetPosition, duration)
    markCoinAsTouched(targetCoin)
    
    -- Микро-пауза для обмана античита. Сервер видит прерывистое движение и не кикает так быстро.
    task.wait(math.random(10, 25) / 100) 
else
    task.wait(0.5)
end


end
AutoFarmCleanUp()
end

local function StandStillWait()
rt:GetCharacterLoaded()
task.wait(2)
ChangeState(State.WaitingForRound)
end

local function ActionState()
LastPosition = nil
CollectCoins()

if BagIsFull or not RoundInProgress() then
BagIsFull, Working = false, false
if CheckMurderer() then rt.RoundInProgress = false end

-- Гарантированный ресет при заполнении
local char = rt:Character()
if char then
    local hum = char:FindFirstChild("Humanoid")
    if hum then
        hum.Health = 0
        hum:ChangeState(Enum.HumanoidStateType.Dead)
    end
    pcall(function() char:BreakJoints() end)
end

ChangeState(CheckMurderer() and State.WaitingForRound or State.WaitingForRoundEnd)


end
end

local function RespawnState()
rt:GetCharacterLoaded()
task.wait(1)
if LastPosition == nil then
local alive = rt:GetAlivePlayers()
if alive and #alive > 0 then LastPosition = alive[1] end
end
if rt:Character() and LastPosition then
rt:Character():PivotTo(LastPosition)
end
if not RoundInProgress() then
ChangeState(State.WaitingForRound)
return
end
ChangeState(State.Action)
end

local function WaitingForRound()
Working = false
repeat task.wait(0.5) until RoundInProgress() and rt:CheckIfPlayerWasInARound()
ChangeState(State.Action)
end

local function waitForRoundEnd()
Working = false
repeat task.wait(1) until not RoundInProgress()
ChangeState(State.WaitingForRound)
end

