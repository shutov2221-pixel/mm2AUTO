-- Обновление статистики
task.spawn(function()
while task.wait(1) do
if SETTINGS.AutoFarmEnabled and StatsData.StartTime > 0 then
local currentCoins = GetCoinsFromUI()

    if currentCoins > StatsData.LastRoundCoins then
        StatsData.CoinsCollected = StatsData.CoinsCollected + (currentCoins - StatsData.LastRoundCoins)
    end
    
    -- Если ресетнулся или обнулился (новый раунд)
    if currentCoins < 10 and StatsData.LastRoundCoins >= 40 then
        -- Сбрасываем последний показатель, чтобы статистика считала заново
    end
    StatsData.LastRoundCoins = currentCoins

    local timeElapsed = tick() - StatsData.StartTime
    local h = math.floor(timeElapsed / 3600)
    local m = math.floor((timeElapsed % 3600) / 60)
    local s = math.floor(timeElapsed % 60)
    
    local hoursFloat = timeElapsed / 3600
    local perHour = hoursFloat > 0 and math.floor(StatsData.CoinsCollected / hoursFloat) or 0
    
    StatsText.Text = string.format("Время: %02d:%02d:%02d\nМонет собрано: %d\nМонет в час: %d", h, m, s, StatsData.CoinsCollected, perHour)
end


end
end)

