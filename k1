local function Terminate()
    if isTerminated then return end
    isTerminated = true
    isRunning = false

    if chainConnection then chainConnection:Disconnect() end
    for _, conn in ipairs(activeConnections) do
        if conn and conn.Connected then pcall(function() conn:Disconnect() end) end
    end
    table.clear(activeConnections)

    -- Убираем нож в рюкзак
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum then pcall(function() hum:UnequipTools() end) end

    if ScreenGui and ScreenGui.Parent then ScreenGui:Destroy() end
    print("[MM2 ASSASSIN] Скрипт закрыт.")
end

