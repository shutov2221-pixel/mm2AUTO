-- Сериализатор аргументов ремоута
local function SerializeArg(v, depth)
    depth = depth or 0
    if depth > 2 then return "..." end
    local t = typeof(v)
    if t == "string" then
        return '"' .. tostring(v):sub(1, 80) .. '"'
    elseif t == "number" or t == "boolean" then
        return tostring(v)
    elseif t == "nil" then
        return "nil"
    elseif t == "Instance" then
        local ok, full = pcall(function() return v:GetFullName() end)
        return "[" .. v.ClassName .. "] " .. (ok and full or v.Name)
    elseif t == "table" then
        local parts = {}
        local i = 0
        for k, val in pairs(v) do
            i = i + 1
            if i > 6 then table.insert(parts, "..."); break end
            table.insert(parts, tostring(k) .. "=" .. SerializeArg(val, depth + 1))
        end
        return "{" .. table.concat(parts, ", ") .. "}"
    else
        return t .. "(" .. tostring(v):sub(1, 40) .. ")"
    end
end

local function SerializeArgs(...)
    local count = select("#", ...)
    if count == 0 then return "(нет аргументов)" end
    local parts = {}
    for i = 1, count do
        local v = select(i, ...)
        table.insert(parts, "[" .. i .. "] " .. SerializeArg(v))
    end
    return table.concat(parts, "  |  ")
end

-- Состояние снифера
local snifferActive = false
local snifferConns: { RBXScriptConnection } = {}
local snifferHooked: { [Instance]: boolean } = {}

local function StopSniffer()
    snifferActive = false
    for _, c in ipairs(snifferConns) do
        if c and c.Connected then pcall(function() c:Disconnect() end) end
    end
    table.clear(snifferConns)
    table.clear(snifferHooked)
    BtnRemoteSniffer.Text = "🔴 REMOTE SNIFFER"
    BtnRemoteSniffer.BackgroundColor3 = Color3.fromRGB(140, 40, 160)
    Log("=== SNIFFER ОСТАНОВЛЕН. Строк в логе: " .. #rawLogLines .. " ===", "WARN")
    UpdateStatus("Remote Sniffer остановлен", Color3.fromRGB(200, 200, 200))
end

local function HookRemote(remote)
    if snifferHooked[remote] then return end
    snifferHooked[remote] = true

    if remote:IsA("RemoteEvent") then
        local conn = remote.OnClientEvent:Connect(function(...)
            if not snifferActive then return end
            local ok, path = pcall(function() return remote:GetFullName() end)
            local name = ok and path or remote.Name
            Log(string.format("[RE->CLIENT] %s  >>  %s", name, SerializeArgs(...)), "REMOTE")
        end)
        table.insert(snifferConns, conn)

    elseif remote:IsA("RemoteFunction") then
        -- RemoteFunction: можно только залогировать факт существования
        -- (OnClientInvoke без замены оригинального обработчика не перехватывается)
        local ok, path = pcall(function() return remote:GetFullName() end)
        Log(string.format("[RF] %s (существует, пассивно)", ok and path or remote.Name), "REMOTE")
    end
end

local function StartSniffer()
    if snifferActive then
        StopSniffer()
        return
    end

    snifferActive = true
    BtnRemoteSniffer.Text = "🟢 SNIFFER: ON"
    BtnRemoteSniffer.BackgroundColor3 = Color3.fromRGB(40, 160, 60)
    Log("=== REMOTE SNIFFER ЗАПУЩЕН ===", "REMOTE")
    Log("Перехватываем ВСЕ RemoteEvent в ReplicatedStorage...", "REMOTE")

    -- Хукаем все существующие ремоуты
    local reCount, rfCount = 0, 0
    for _, v in ipairs(ReplicatedStorage:GetDescendants()) do
        if v:IsA("RemoteEvent") then
            HookRemote(v)
            reCount = reCount + 1
            Log("  [RE] " .. v:GetFullName(), "REMOTE")
        elseif v:IsA("RemoteFunction") then
            HookRemote(v)
            rfCount = rfCount + 1
        end
    end
    Log(string.format("Подключено: %d RemoteEvent, %d RemoteFunction", reCount, rfCount), "REMOTE")
    Log("Ожидаем события... (убей кого-нибудь или получи таргет)", "WARN")

    -- Хукаем новые ремоуты при появлении
    local addConn = ReplicatedStorage.DescendantAdded:Connect(function(v)
        if not snifferActive then return end
        if v:IsA("RemoteEvent") or v:IsA("RemoteFunction") then
            HookRemote(v)
            Log("[NEW REMOTE] " .. v:GetFullName(), "REMOTE")
        end
    end)
    table.insert(snifferConns, addConn)

    UpdateStatus("Remote Sniffer активен — жди убийства!", Color3.fromRGB(255, 140, 50))
end

-- Кнопка «COPY/SAVE LOG»: сохраняет все строки в файл + копирует в буфер
local function ExportLog()
    if #rawLogLines == 0 then
        Log("Лог пуст — нечего экспортировать", "WARN")
        return
    end

    local content = table.concat(rawLogLines, "\n")
    local fileName = "mm2_remote_log.txt"

    -- Пробуем writefile (Synapse / Krnl / Delta и т.д.)
    local wf = writefile or (syn and syn.writefile)
    if typeof(wf) == "function" then
        local ok, err = pcall(wf, fileName, content)
        if ok then
            Log("✅ Лог сохранён в: " .. fileName .. " (" .. #rawLogLines .. " строк)", "SUCCESS")
        else
            Log("❌ writefile ошибка: " .. tostring(err), "ERROR")
        end
    else
        Log("writefile недоступен в этом эксплойте", "WARN")
    end

    -- Пробуем setclipboard
    local sc = setclipboard or toclipboard or (syn and syn.write_clipboard)
    if typeof(sc) == "function" then
        local ok2 = pcall(sc, content)
        if ok2 then
            Log("✅ Лог скопирован в буфер обмена (" .. #rawLogLines .. " строк)", "SUCCESS")
        end
    else
        Log("setclipboard недоступен — только writefile", "WARN")
    end

    UpdateStatus("Лог экспортирован: " .. #rawLogLines .. " строк", Color3.fromRGB(100, 255, 120))
end

