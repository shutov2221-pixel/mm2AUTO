-- ПОИСК НОЖА (В РЮКЗАКЕ ИЛИ ПЕРСОНАЖЕ)
-- =====================================================================
local function FindKnifeTool(): Tool?
    -- 1. Сначала ищем в рюкзаке (Backpack)
    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack") or LocalPlayer:FindFirstChild("Backpack")
    if backpack then
        local knife = backpack:FindFirstChild("Knife") :: Tool?
        if knife and knife:IsA("Tool") then return knife end

        for _, item in ipairs(backpack:GetChildren()) do
            if item:IsA("Tool") and string.find(string.lower(item.Name), "knife") then
                return item
            end
        end
        local anyTool = backpack:FindFirstChildOfClass("Tool")
        if anyTool then return anyTool end
    end

    -- 2. Если уже в персонаже
    local char = LocalPlayer.Character
    if char then
        local knife = char:FindFirstChild("Knife") :: Tool?
        if knife and knife:IsA("Tool") then return knife end

        for _, item in ipairs(char:GetChildren()) do
            if item:IsA("Tool") and string.find(string.lower(item.Name), "knife") then
                return item
            end
        end
        local anyTool = char:FindFirstChildOfClass("Tool")
        if anyTool then return anyTool end
    end

    return nil
end

-- =====================================================================
-- СТЕЛС-УДАР: ПОСЛЕДОВАТЕЛЬНОЕ ТЕСТИРОВАНИЕ МЕТОДОВ С ЛОГИРОВАНИЕМ
-- =====================================================================
local function ExecuteStealthKill(targetPlayer: Player, knife: Tool): (boolean, string)
    local targetChar = targetPlayer.Character
    if not targetChar then return false, "NoTargetChar" end

    local targetHRP = targetChar:FindFirstChild("HumanoidRootPart") or targetChar:FindFirstChild("Torso") :: BasePart?
    local targetHum = targetChar:FindFirstChildOfClass("Humanoid")
    local handle = knife:FindFirstChild("Handle") :: BasePart?

    if not targetHRP or not targetHum or targetHum.Health <= 0 or not handle then
        return false, "InvalidParts"
    end

    if not firetouchinterest then
        return false, "NoFireTouch"
    end

    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack") or LocalPlayer:FindFirstChild("Backpack")

    -- -----------------------------------------------------------------
    -- ЭТАП 1: СПОСОБ 1 — УДАР ПРЯМО ИЗ BACKPACK (РУКИ ПОЛНОСТЬЮ ПУСТЫЕ)
    -- -----------------------------------------------------------------
    -- Нож вообще не трогается, лежит в рюкзаке
    pcall(function() knife:Activate() end)
    pcall(function()
        firetouchinterest(targetHRP, handle, 0)
        firetouchinterest(targetHRP, handle, 1)
        firetouchinterest(targetHRP, handle, 0)
        firetouchinterest(targetHRP, handle, 1)
    end)

    task.wait(0.02)
    if not targetHum or targetHum.Health <= 0 then
        return true, "СПОСОБ 1 (Прямой урон из Backpack)"
    end

    -- -----------------------------------------------------------------
    -- ЭТАП 2: СПОСОБ 2 — GHOST EQUIP (БЕЗОПАСНЫЙ СВОП НА 1 КАДР)
    -- -----------------------------------------------------------------
    -- Используем нативный hum:EquipTool (чтобы движок не зависал!), бьем и тут же убираем
    if hum and knife.Parent ~= char then
        pcall(function() hum:EquipTool(knife) end)
    end

    pcall(function() knife:Activate() end)
    pcall(function()
        firetouchinterest(targetHRP, handle, 0)
        firetouchinterest(targetHRP, handle, 1)
        firetouchinterest(targetHRP, handle, 0)
        firetouchinterest(targetHRP, handle, 1)
    end)

    -- Мгновенно прячем обратно в рюкзак через официальный API движка
    if hum then
        pcall(function() hum:UnequipTools() end)
    end

    task.wait(0.02)
    if not targetHum or targetHum.Health <= 0 then
        return true, "СПОСОБ 2 (Ghost Equip на 1 кадр)"
    end

    -- -----------------------------------------------------------------
    -- ЭТАП 3: РЕЗЕРВ — КЛАССИЧЕСКИЙ ЭКИП (ЕСЛИ СЕРВЕР ТРЕБУЕТ НОЖ В РУКАХ)
    -- -----------------------------------------------------------------
    if hum and knife.Parent ~= char then
        pcall(function() hum:EquipTool(knife) end)
    end

    pcall(function() knife:Activate() end)
    pcall(function()
        firetouchinterest(targetHRP, handle, 0)
        firetouchinterest(targetHRP, handle, 1)
    end)

    return true, "РЕЗЕРВ (С ножом в руке)"
end

-- Одиночный удар
local function RunSingleTargetKill()
    task.spawn(function()
        local knife = FindKnifeTool()
        if not knife then
            Log("Нож не найден в инвентаре/рюкзаке!", "ERROR")
            return
        end

        local target = RunTargetScan()
        if not target then
            Log("Цель не найдена в UI!", "WARN")
            return
        end

        local startTime = tick()
        local ok, method = ExecuteStealthKill(target, knife)
        if ok then
            local ms = math.floor((tick() - startTime) * 1000)
            Log(string.format("🎯 [%d мс] %s ликвидирован! -> %s", ms, target.DisplayName, method), "SUCCESS")
            UpdateStatus(target.DisplayName .. " -> " .. method, Color3.fromRGB(100, 255, 120))
        end
    end)
end

-- =====================================================================
-- ТУРБО-ЦЕПОЧКА С АВТО-ДОБИВАНИЕМ И ЛОГИРОВАНИЕМ МЕТОДА
-- =====================================================================
local chainConnection: RBXScriptConnection? = nil
local activeTargetName = ""
local killAttemptsForTarget = 0

local function StopKillLoop()
    isRunning = false
    if chainConnection then
        chainConnection:Disconnect()
        chainConnection = nil
    end

    -- Убираем нож в рюкзак при остановке
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum then pcall(function() hum:UnequipTools() end) end

    BtnKill.Text = "⚡ ТУРБО-ЦЕПОЧКА"
    BtnKill.BackgroundColor3 = Color3.fromRGB(200, 45, 45)
    UpdateStatus("Турбо-цепочка остановлена", Color3.fromRGB(200, 200, 200))
    Log("Турбо-цепочка остановлена", "INFO")
end

local function AttackTargetFromLabel(label: TextLabel, knife: Tool)
    local rawText = label.Text
    local cleanName = CleanNickname(rawText)
    if cleanName == "" or cleanName == "Label" or cleanName == "None" then return end

    if cleanName ~= activeTargetName then
        activeTargetName = cleanName
        killAttemptsForTarget = 0
    end

    local targetPlayer = FindPlayerByName(cleanName)
    if not targetPlayer or not targetPlayer.Character then return end

    local hum = targetPlayer.Character:FindFirstChildOfClass("Humanoid")
    if hum and hum.Health > 0 then
        killAttemptsForTarget = killAttemptsForTarget + 1
        local tStart = tick()
        local ok, method = ExecuteStealthKill(targetPlayer, knife)
        local ms = math.floor((tick() - tStart) * 1000)

        if killAttemptsForTarget == 1 then
            Log(string.format("⚡ [%d мс] %s -> %s", ms, targetPlayer.DisplayName, method), "KILL")
            UpdateStatus(targetPlayer.DisplayName .. " -> " .. method, Color3.fromRGB(255, 80, 80))
        elseif killAttemptsForTarget % 3 == 0 then
            Log(string.format("🔄 Добивание: %s (Попытка %d) [%s]", targetPlayer.DisplayName, killAttemptsForTarget, method), "WARN")
        end
    end
end

local function StartKillLoop()
    if isRunning then
        StopKillLoop()
        return
    end

    isRunning = true
    BtnKill.Text = "⚡ СТОП ТУРБО"
    BtnKill.BackgroundColor3 = Color3.fromRGB(40, 180, 50)
    UpdateStatus("Турбо-цепочка АКТИВНА", Color3.fromRGB(100, 255, 100))
    Log("--- СТАРТ СТЕЛС ТУРБО-ЦЕПОЧКИ v5.2 ---", "KILL")

    task.spawn(function()
        local knife = FindKnifeTool()
        if not knife then
            Log("Ошибка: Нож не найден в инвентаре/Backpack!", "ERROR")
            StopKillLoop()
            return
        end

        local label = FindTargetLabel()
        if not label then
            Log("Ошибка: TargetName не найден в UI!", "ERROR")
            StopKillLoop()
            return
        end

        activeTargetName = ""
        killAttemptsForTarget = 0

        -- 1. Первый удар сразу
        AttackTargetFromLabel(label, knife)

        -- 2. Реактивный перехват момента смены текста
        if chainConnection then chainConnection:Disconnect() end
        chainConnection = label:GetPropertyChangedSignal("Text"):Connect(function()
            if not isRunning or isTerminated then return end
            AttackTargetFromLabel(label, knife)
        end)

        -- 3. Watchdog-цикл добивания (0.06с)
        local emptyCounter = 0
        while isRunning and not isTerminated do
            task.wait(0.06)

            local myChar = LocalPlayer.Character
            local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")
            if not myChar or not myHum or myHum.Health <= 0 then
                Log("Персонаж погиб — остановка", "ERROR")
                break
            end

            -- Обновляем ссылку на нож
            if not knife or not knife.Parent then
                knife = FindKnifeTool() or knife
            end

            local currentLabel = FindTargetLabel()
            local raw = currentLabel and currentLabel.Text or ""
            local clean = CleanNickname(raw)

            if clean == "" or clean == "Label" or clean == "None" then
                emptyCounter = emptyCounter + 1
                if emptyCounter >= 18 then
                    Log("Таргеты закончились! Все игроки устранены.", "SUCCESS")
                    UpdateStatus("РАУНД ВЫИГРАН! Победа.", Color3.fromRGB(100, 255, 120))
                    break
                end
            else
                emptyCounter = 0
                if currentLabel and knife then
                    AttackTargetFromLabel(currentLabel, knife)
                end
            end
        end

        StopKillLoop()
    end)
end

