local function InspectAssassinData()
    task.spawn(function()
        Log("--- СНИФФЕР ДАННЫХ ASSASSIN ---", "TARGET")
        local myAttrs = LocalPlayer:GetAttributes()
        local attrList = {}
        for k, v in pairs(myAttrs) do table.insert(attrList, string.format("%s = %s", tostring(k), tostring(v))) end
        if #attrList > 0 then Log("Атрибуты LocalPlayer: " .. table.concat(attrList, ", "), "INFO") end

        local targetAttrFound = false
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer then
                local pAttrs = plr:GetAttributes()
                for k, v in pairs(pAttrs) do
                    if string.find(string.lower(tostring(k)), "target") or string.find(string.lower(tostring(k)), "assassin") then
                        Log(string.format("🔥 НАЙДЕН АТРИБУТ У %s: %s = %s", plr.Name, tostring(k), tostring(v)), "SUCCESS")
                        targetAttrFound = true
                    end
                end
            end
        end
        if not targetAttrFound then Log("Атрибуты Target у других игроков скрыты сервером.", "WARN") end
        UpdateStatus("Сниффер завершен", Color3.fromRGB(180, 220, 255))
    end)
end

