local function FindRemoteFunction(name: string): RemoteFunction?
    local direct = ReplicatedStorage:FindFirstChild(name)
    if direct and direct:IsA("RemoteFunction") then return direct end
    local deep = ReplicatedStorage:FindFirstChild(name, true)
    if deep and deep:IsA("RemoteFunction") then return deep end
    for _, item in ipairs(ReplicatedStorage:GetDescendants()) do
        if item:IsA("RemoteFunction") and item.Name == name then
            return item
        end
    end
    return nil
end

local function RunTestEliminate()
    Log("--- ТЕСТ REMOTEFUNCTION: EliminatePlayer ---", "KILL")
    local rf = FindRemoteFunction("EliminatePlayer")
    if not rf then
        Log("❌ RemoteFunction 'EliminatePlayer' не найден в ReplicatedStorage!", "ERROR")
        UpdateStatus("EliminatePlayer не найден", Color3.fromRGB(255, 80, 80))
        return
    end

    Log("✓ Найден RF: " .. rf:GetFullName(), "SUCCESS")

    -- Проверяем статус ножа (в руке или в инвентаре)
    local char = LocalPlayer.Character
    local hasKnifeInHand = false
    if char then
        for _, item in ipairs(char:GetChildren()) do
            if item:IsA("Tool") and (item.Name == "Knife" or string.find(string.lower(item.Name), "knife")) then
                hasKnifeInHand = true
                break
            end
        end
    end
    Log("Статус ножа: " .. (hasKnifeInHand and "В РУКЕ" or "В РЮКЗАКЕ / НЕ ЭКИПИРОВАН"), "INFO")

    -- Ищем цель
    local target = RunTargetScan()
    if not target then
        for _, pl in ipairs(Players:GetPlayers()) do
            if pl ~= LocalPlayer and pl.Character and pl.Character:FindFirstChildOfClass("Humanoid") and pl.Character:FindFirstChildOfClass("Humanoid").Health > 0 then
                target = pl
                break
            end
        end
        if target then
            Log("Цель взята из списка игроков: " .. target.DisplayName, "WARN")
        end
    end

    if not target then
        Log("❌ Живая цель не найдена для теста!", "ERROR")
        UpdateStatus("Цель не найдена", Color3.fromRGB(255, 100, 100))
        return
    end

    Log(string.format("🚀 Отправляем: %s:InvokeServer(Player: %s)...", rf.Name, target.Name), "KILL")
    UpdateStatus("InvokeServer по " .. target.DisplayName .. "...", Color3.fromRGB(255, 140, 50))

    local startTime = tick()
    local ok, res = pcall(function()
        return rf:InvokeServer(target)
    end)
    local ms = math.floor((tick() - startTime) * 1000)

    if ok then
        Log(string.format("✅ [%d мс] InvokeServer выполнен! Ответ: %s", ms, SerializeArg(res)), "SUCCESS")
        UpdateStatus("RF ответ: " .. tostring(res), Color3.fromRGB(100, 255, 120))
    else
        Log(string.format("❌ [%d мс] InvokeServer ОШИБКА: %s", ms, tostring(res)), "ERROR")
        UpdateStatus("RF ошибка: " .. tostring(res):sub(1, 30), Color3.fromRGB(255, 80, 80))
    end
end

