local function UpdateVisualBox()
    if not PointA or not PointB then return end

    if not VisualBox then
        VisualBox = Instance.new("Part")
        VisualBox.Name = "ScannerVisualBox"
        VisualBox.Anchored = true
        VisualBox.CanCollide = false
        VisualBox.Material = Enum.Material.Neon
        VisualBox.Color = Color3.fromRGB(50, 200, 255)
        VisualBox.Transparency = 0.75
        VisualBox.Parent = Workspace
    end

    local minX = math.min(PointA.X, PointB.X)
    local maxX = math.max(PointA.X, PointB.X)
    local minZ = math.min(PointA.Z, PointB.Z)
    local maxZ = math.max(PointA.Z, PointB.Z)

    local baseHeight = PointA.Y
    local minY = baseHeight - 6
    local maxY = baseHeight + 15

    local size = Vector3.new(maxX - minX, maxY - minY, maxZ - minZ)
    local center = Vector3.new((minX + maxX) / 2, (minY + maxY) / 2, (minZ + maxZ) / 2)

    VisualBox.Size = size
    VisualBox.Position = center
end

