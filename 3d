ScanBtn.MouseButton1Click:Connect(function()
    if not PointA or not PointB then
        AddLog("Сначала установи Точки A и B!", Color3.fromRGB(255, 100, 100))
        return
    end

    LogScanResult("--- СКАНИРОВАНИЕ V2 ---", Color3.fromRGB(255, 200, 50))

    local minX = math.min(PointA.X, PointB.X)
    local maxX = math.max(PointA.X, PointB.X)
    local minZ = math.min(PointA.Z, PointB.Z)
    local maxZ = math.max(PointA.Z, PointB.Z)
    local baseHeight = PointA.Y
    local minY = baseHeight - 6
    local maxY = baseHeight + 15

    LogScanResult(string.format("REGION_MIN = Vector3.new(%.1f, %.1f, %.1f)", minX, minY, minZ), Color3.fromRGB(150, 150, 150))
    LogScanResult(string.format("REGION_MAX = Vector3.new(%.1f, %.1f, %.1f)", maxX, maxY, maxZ), Color3.fromRGB(150, 150, 150))

    local function IsInBox(pos)
        return pos.X >= minX and pos.X <= maxX and
               pos.Y >= minY and pos.Y <= maxY and
               pos.Z >= minZ and pos.Z <= maxZ
    end

    local foundItems = 0

    for _, gui in pairs(Workspace:GetDescendants()) do
        if gui:IsA("SurfaceGui") then
            local targetPart = nil
            if gui.Adornee and gui.Adornee:IsA("BasePart") then
                targetPart = gui.Adornee
            elseif gui.Parent and gui.Parent:IsA("BasePart") then
                targetPart = gui.Parent
            end
            
            if targetPart and IsInBox(targetPart.Position) then
                LogScanResult("НАЙДЕН СТЕНД: " .. gui.Name .. " (" .. gui:GetFullName() .. ")", Color3.fromRGB(50, 200, 255))
                for _, txt in pairs(gui:GetDescendants()) do
                    if txt:IsA("TextLabel") and txt.Text ~= "" and txt.Text ~= "Label" then
                        LogScanResult(" -> Текст: [" .. txt.Text .. "]", Color3.fromRGB(255, 255, 100))
                    end
                end
                foundItems = foundItems + 1
            end
        end
    end

    for _, tt in pairs(Workspace:GetDescendants()) do
        if tt:IsA("TouchTransmitter") then
            local targetPart = tt.Parent
            if targetPart and targetPart:IsA("BasePart") and IsInBox(targetPart.Position) then
                LogScanResult("НАЙДЕНА ПЛИТА: " .. targetPart.Name .. " (" .. targetPart:GetFullName() .. ")", Color3.fromRGB(255, 100, 100))
                foundItems = foundItems + 1
            end
        end
    end

    if foundItems == 0 then
        LogScanResult("В этой зоне интерфейсов и кнопок нет.", Color3.fromRGB(150, 150, 150))
    else
        LogScanResult("Сбор данных завершен. Можно копировать!", Color3.fromRGB(100, 255, 100))
    end
end)

