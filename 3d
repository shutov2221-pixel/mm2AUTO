local logCount = 0
local function AddLog(msg, color)
    logCount = logCount + 1
    local logLine = Instance.new("TextLabel", LogContainer)
    logLine.Size = UDim2.new(1, -10, 0, 0)
    logLine.BackgroundTransparency = 1
    logLine.Text = "["..logCount.."] " .. msg
    logLine.TextColor3 = color or Color3.fromRGB(200, 200, 200)
    logLine.Font = Enum.Font.Code
    logLine.TextSize = 11
    logLine.TextXAlignment = Enum.TextXAlignment.Left
    logLine.TextWrapped = true
    logLine.AutomaticSize = Enum.AutomaticSize.Y

    task.spawn(function()
        task.wait(0.05)
        if LogContainer and LogContainer.Parent then
            LogContainer.CanvasSize = UDim2.new(0, 0, 0, LogLayout.AbsoluteContentSize.Y + 10)
            LogContainer.CanvasPosition = Vector2.new(0, LogContainer.CanvasSize.Y.Offset)
        end
    end)
end

-- Функция для записи лога, которая также сохраняет его для буфера обмена
local function LogScanResult(msg, color)
    table.insert(lastScanLogs, msg)
    AddLog(msg, color)
end

