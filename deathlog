-- Отслеживание касаний частей тела
local recentTouches = {}
local function listenToTouches(char)
    table.clear(recentTouches)
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            part.Touched:Connect(function(hit)
                if not hit or not hit.Parent then return end
                -- Игнорируем свои же части тела
                if hit:IsDescendantOf(char) then return end

                local parentPlr = Players:GetPlayerFromCharacter(hit.Parent) or Players:GetPlayerFromCharacter(hit.Parent.Parent)
                table.insert(recentTouches, {
                    partName = hit.Name,
                    parentName = hit.Parent.Name,
                    fromPlayer = parentPlr,
                    partPos = hit.Position,
                    time = os.clock()
                })
                if #recentTouches > 15 then
                    table.remove(recentTouches, 1)
                end
            end)
        end
    end
end

-- Поиск игроков под картой (в пустоте)
local function getVoidPlayers()
    local voidList = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
            local pos = plr.Character.HumanoidRootPart.Position
            -- Обычно уровень пола в MM2 от -15 до 50. Все что ниже -30 — пустота/подвал
            if pos.Y < -30 or pos.Magnitude > 1500 then
                table.insert(voidList, {plr = plr, pos = pos})
            end
        end
    end
    return voidList
end

local function trackCharacter(char)
    local hrp = char:WaitForChild("HumanoidRootPart", 5)
    local hum = char:WaitForChild("Humanoid", 5)
    if not hrp or not hum then return end

    listenToTouches(char)

    hum.Died:Connect(function()
        local deathPos = hrp.Position
        local voidPlayers = getVoidPlayers()

        -- Даем игре 0.2 сек переключить спектатор на убийцу
        task.wait(0.25)

        -- 1. Считываем, на кого переключилась камера (Spectator Target)
        local killerPlayer = nil
        if Camera.CameraSubject and Camera.CameraSubject:IsA("Humanoid") then
            local targetChar = Camera.CameraSubject.Parent
            killerPlayer = Players:GetPlayerFromCharacter(targetChar)
        end

        -- 2. Анализируем последние касания ножом перед смертью
        local knifeTouch = nil
        for i = #recentTouches, 1, -1 do
            local t = recentTouches[i]
            local name = string.lower(t.partName)
            local pName = string.lower(t.parentName)
            if name:find("handle") or name:find("knife") or name:find("blade") or pName:find("knife") then
                knifeTouch = t
                break
            end
        end

        -- Вывод вердикта
        local killerName = killerPlayer and killerPlayer.Name or (knifeTouch and knifeTouch.fromPlayer and knifeTouch.fromPlayer.Name) or "Не определен"
        local killerDist = "Неизвестно"
        local killerInVoid = false

        if killerPlayer and killerPlayer.Character and killerPlayer.Character:FindFirstChild("HumanoidRootPart") then
            local kPos = killerPlayer.Character.HumanoidRootPart.Position
            killerDist = string.format("%d studs (Y: %d)", math.floor((kPos - deathPos).Magnitude), math.floor(kPos.Y))
            if kPos.Y < -30 then
                killerInVoid = true
            end
        end

        if killerInVoid or (killerDist ~= "Неизвестно" and tonumber(killerDist:match("%d+")) > 25) then
            addLog(
                "⚡ SILENT KILL (FireTouch / Aura)",
                string.format(
                    "Убийца: %s\nДистанция до него: %s\nСтатус: Находится в пустоте/под картой!\nМетод: Фантомное касание лезвием без сближения.",
                    killerName, killerDist
                ),
                Color3.fromRGB(255, 60, 60)
            )
        elseif knifeTouch then
            addLog(
                "🗡️ УДАР НОЖОМ",
                string.format(
                    "Убийца: %s\nДеталь удара: %s (%s)\nКамера переключена на: %s",
                    knifeTouch.fromPlayer and knifeTouch.fromPlayer.Name or killerName,
                    knifeTouch.partName, knifeTouch.parentName, killerName
                ),
                Color3.fromRGB(255, 170, 0)
            )
        else
            -- Если читер убил через скрытый RemoteEvent
            local voidReport = ""
            if #voidPlayers > 0 then
                voidReport = "\nПодозрительные игроки под картой: "
                for _, vp in ipairs(voidPlayers) do
                    voidReport = voidReport .. vp.plr.Name .. " (Y: " .. math.floor(vp.pos.Y) .. ") "
                end
            end

            addLog(
                "💀 УДАЛЕННЫЙ KILL (Remote / Damage)",
                string.format(
                    "Убийца по камере: %s\nДистанция: %s%s",
                    killerName, killerDist, voidReport
                ),
                Color3.fromRGB(200, 100, 255)
            )
        end
    end)
end

