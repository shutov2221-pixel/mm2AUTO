-- === ПРОВЕРКА УДАЛЕНИЯ МОНЕТЫ (PING-SYNC) ===
local function isCoinCollectedByServer(coin)
    if not coin then return true end
    if coin.Parent == nil then return true end
    if not coin:IsDescendantOf(Workspace) then return true end
    if coin:IsA("BasePart") and coin.Transparency >= 1 and not coin:FindFirstChildWhichIsA("TouchTransmitter") then return true end
    if not coin:FindFirstChildWhichIsA("TouchTransmitter") then return true end
    return false
end

-- === ПЕРЕДВИЖЕНИЕ ===
local function moveToPositionPhysically(targetPosition, targetCoin, bv, bg)
    local char = rt:Character()
    if not char or not char.PrimaryPart then return false end

    local hrp = char.PrimaryPart
    local finalPosition = targetPosition + Vector3.new(0, 0.5, 0)

    local startPos = hrp.Position
    local lookAtPos = Vector3.new(finalPosition.X, startPos.Y, finalPosition.Z)
    if (lookAtPos - startPos).Magnitude > 0.1 then
        bg.CFrame = CFrame.new(startPos, lookAtPos) * CFrame.Angles(math.rad(-90), 0, 0)
    end

    local flyStart = tick()

    while not IsTerminated and SETTINGS.AutoFarmEnabled and char and char.PrimaryPart and CurrentState == State.Action do
        -- Защита от зависания: если летим дольше 6 секунд или персонаж погиб
        if tick() - flyStart > 6 then break end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum and hum.Health <= 0 then break end

        -- Если монету уже подобрал другой игрок — прекращаем полет к ней
        if not targetCoin or not targetCoin.Parent or isCoinCollectedByServer(targetCoin) then
            break
        end

        local currentPos = hrp.Position
        local distance = (finalPosition - currentPos).Magnitude

        if distance < 1.5 then
            bv.Velocity = Vector3.zero

            local waitStart = tick()
            local collected = false

            repeat
                -- Основной метод: программный триггер касания
                pcall(function()
                    if targetCoin and targetCoin.Parent then
                        firetouchtransmitter(hrp, targetCoin, 0)
                        task.wait()
                        firetouchtransmitter(hrp, targetCoin, 1)
                    end
                end)

                -- Физический fallback: подтягивание персонажа прямо в центр монеты
                if targetCoin and targetCoin.Parent then
                    local toCoinCenter = targetCoin.Position - hrp.Position
                    if toCoinCenter.Magnitude > 0.05 then
                        bv.Velocity = toCoinCenter.Unit * math.min(10, SETTINGS.Speed)
                    else
                        bv.Velocity = Vector3.zero
                    end
                end

                if isCoinCollectedByServer(targetCoin) then
                    collected = true
                    break
                end

                task.wait(0.05)
            until (tick() - waitStart > 1.5) or IsTerminated

            return collected
        end

        local direction = (finalPosition - currentPos).Unit
        bv.Velocity = direction * SETTINGS.Speed

        RunService.Heartbeat:Wait()
    end
    return false
end

-- === ЛОГИКА ФАРМА ===
local function ChangeState(newState) CurrentState = newState end

local function CollectCoins()
    Working = true
    CurrentRoundCoins = 0
    BagIsFull = false

    local map = rt:Map()
    if map then
        rt.coinContainer = map:FindFirstChild("CoinContainer")
        PopulateCoins()

        -- Подписка на уничтожение контейнера: обнуляем ссылку, чтобы
        -- rt.coinContainer не указывал на мёртвый Instance между раундами
        if rt.coinContainer then
            local ancestryConn
            ancestryConn = rt.coinContainer.AncestryChanged:Connect(function(_, parent)
                if not parent then
                    rt.coinContainer = nil
                    if ancestryConn then ancestryConn:Disconnect() end
                end
            end)
            RegisterConnection(ancestryConn)
        end
    end

    local char = rt:Character()
    local hrp = char and char.PrimaryPart
    local hum = char and char:FindFirstChild("Humanoid")

    if not char or not hrp then return end
    
    updateBodyPartsCache() 
    
    if hum then hum.PlatformStand = true end

    local bv = hrp:FindFirstChild("FarmVelocity") or Instance.new("BodyVelocity")
    bv.Name = "FarmVelocity"
    bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
    bv.Velocity = Vector3.zero
    bv.Parent = hrp

    local bg = hrp:FindFirstChild("FarmGyro") or Instance.new("BodyGyro")
    bg.Name = "FarmGyro"
    bg.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
    bg.P = 3000
    bg.Parent = hrp

    while not IsTerminated and CurrentState == State.Action and SETTINGS.AutoFarmEnabled and not BagIsFull and rt:CheckIfPlayerWasInARound() do
        char = rt:Character()
        if not char or not char.PrimaryPart then break end

        local targetCoin = GetNearestCoin()

        if targetCoin then
            UpdateStatus("Фарм: Лечу к монете", Color3.fromRGB(150, 255, 150))

            markCoinAsPending(targetCoin)

            local pickedUp = moveToPositionPhysically(targetCoin.Position, targetCoin, bv, bg)
            if not SETTINGS.AutoFarmEnabled or IsTerminated then break end

            if pickedUp and rt.touchedCoins[targetCoin] == "pending" then
                rt.touchedCoins[targetCoin] = "collected"

                if IsBagFull() then
                    UpdateStatus("Фарм: Сохранение последней монеты...", Color3.fromRGB(255, 200, 50))
                    task.wait(math.random(6, 12) / 10)
                    break
                end
            end
        else
            UpdateStatus("Фарм: Поиск монет...", Color3.fromRGB(200, 200, 100))
            bv.Velocity = Vector3.zero
            task.wait(0.1)
        end
    end

    if bv and bv.Parent then bv:Destroy() end
    if bg and bg.Parent then bg:Destroy() end
    if hrp then
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
    end
    if hum then hum.PlatformStand = false end

    AutoFarmCleanUp()
end

local roundKillsCompleted = false

local function ActionState()
    -- 1. Перед началом сбора монет ждем завершения разминки:
    -- В MM2 надежным признаком окончания разминки является появление монет в CoinContainer (#GetChildren() > 0) и выдача ножа
    UpdateStatus("Ожидание окончания разминки...", Color3.fromRGB(255, 200, 50))
    local warmupDone = false
    local warmupWaitStart = tick()
    while not IsTerminated and SETTINGS.AutoFarmEnabled and tick() - warmupWaitStart < 25 do
        local map = rt:Map()
        local cc = map and map:FindFirstChild("CoinContainer")
        local knife = GetKnife()
        if cc and #cc:GetChildren() > 0 and knife then
            warmupDone = true
            break
        end
        task.wait(0.2)
    end

    -- 2. Предварительная зачистка сервера в начале раунда (строго один раз за раунд)
    if warmupDone and not roundKillsCompleted and SETTINGS.AutoFarmEnabled and not IsTerminated and rt:CheckIfPlayerWasInARound() then
        PreRoundKillChain()
        roundKillsCompleted = true
    end

    -- 3. Основной сбор монет на пустой карте
    CollectCoins()

    if not SETTINGS.AutoFarmEnabled or IsTerminated then return end

    if BagIsFull then
        if SETTINGS.BagFullMode == "KillAll" then
            -- Режим Kill All: добиваем оставшуюся цель для победы
            FinishKillRemainingTargets()
            BagIsFull = false  -- Сброс: следующий раунд начнёт фарм с чистого состояния
            ChangeState(State.WaitingForRoundEnd)
        else
            -- Режим Reset: ресет персонажа (победа уходит твинку или второму игроку)
            ChangeState(State.WaitingForRoundEnd)
            local char = rt:Character()
            if char then
                local hum = char:FindFirstChild("Humanoid")
                if hum then
                    hum.Health = 0
                    hum:ChangeState(Enum.HumanoidStateType.Dead)
                end
                pcall(function() char:BreakJoints() end)
            end
        end
    elseif not RoundInProgress() then
        ChangeState(State.WaitingForRound)
    else
        ChangeState(State.WaitingForRoundEnd)
    end
end

local function WaitingForRound()
    Working = false
    BagIsFull = false
    roundKillsCompleted = false
    UpdateStatus("Фарм: Ожидание начала раунда", Color3.fromRGB(150, 150, 150))

    -- Fallback: если скрипт был инжектирован в середине уже идущего раунда —
    -- карта уже в Workspace и ChildAdded никогда не сработает. Проверяем сразу.
    if RoundInProgress() and rt:CheckIfPlayerWasInARound() then
        ChangeState(State.Action)
        return
    end

    -- Event-driven ожидание: подписываемся на появление новой карты в Workspace.
    -- Карта клонируется как прямой потомок Workspace, поэтому ChildAdded достаточно.
    local roundReady = false
    local mapConn
    mapConn = Workspace.ChildAdded:Connect(function(child)
        if not SETTINGS.AutoFarmEnabled or IsTerminated then return end
        -- Карта появилась — проверяем наличие CoinContainer
        -- (небольшая пауза: дерево объектов может реплицироваться не мгновенно)
        task.delay(0.1, function()
            if child:FindFirstChild("CoinContainer") and rt:CheckIfPlayerWasInARound() then
                roundReady = true
            end
        end)
    end)

    -- Опрос атрибута Alive остаётся: он устанавливается сервером чуть позже
    -- появления карты, поэтому без него возможен ложный старт в зрителях.
    repeat
        task.wait(0.3)
        -- Дополнительная проверка через rt:Map() на случай пропуска ChildAdded
        if RoundInProgress() and rt:CheckIfPlayerWasInARound() then
            roundReady = true
        end
    until roundReady or not SETTINGS.AutoFarmEnabled or IsTerminated

    mapConn:Disconnect()

    if not SETTINGS.AutoFarmEnabled or IsTerminated then return end
    ChangeState(State.Action)
end

local function waitForRoundEnd()
    Working = false
    UpdateStatus("Фарм: Сумка полна, жду конец игры", Color3.fromRGB(255, 150, 50))
    repeat
        task.wait(1)
    until not RoundInProgress() or not SETTINGS.AutoFarmEnabled or IsTerminated

    if not SETTINGS.AutoFarmEnabled or IsTerminated then return end
    ChangeState(State.WaitingForRound)
end

