-- === ФУНКЦИЯ ПОЛНОГО ЗАКРЫТИЯ (TERMINATE) ===
local function TerminateScript()
    if IsTerminated then return end
    IsTerminated = true
    
    -- 1. Выключаем все функции скрипта
    SETTINGS.AutoFarmEnabled = false
    SETTINGS.AutoVoteEnabled = false
    Working = false
    isKillRunning = false
    UnequipKnife()
    
    -- 2. Отключаем все активные RBXScriptConnection
    for _, conn in ipairs(ActiveConnections) do
        if conn and conn.Connected then
            pcall(function() conn:Disconnect() end)
        end
    end
    table.clear(ActiveConnections)
    
    -- 3. Очищаем соединения картофельного режима
    for _, conn in pairs(rt.potatoConnections) do
        if conn and conn.Connected then
            pcall(function() conn:Disconnect() end)
        end
    end
    table.clear(rt.potatoConnections)
    
    -- 4. Очищаем сборщик монет
    AutoFarmCleanUp()
    
    -- 5. Восстанавливаем персонажа и физику
    pcall(function()
        local char = LocalPlayer.Character
        if char then
            local hrp = char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart
            local hum = char:FindFirstChildOfClass("Humanoid")
            
            if hum then
                hum.PlatformStand = false
            end
            
            if hrp then
                local bv = hrp:FindFirstChild("FarmVelocity")
                if bv then bv:Destroy() end
                
                local bg = hrp:FindFirstChild("FarmGyro")
                if bg then bg:Destroy() end
                
                hrp.AssemblyLinearVelocity = Vector3.zero
                hrp.AssemblyAngularVelocity = Vector3.zero
            end
            
            -- Восстанавливаем коллизию тела
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                    part.CanCollide = true
                end
            end
        end
    end)
    
    -- 6. Восстанавливаем графику и настройки, если был Potato Mode
    pcall(function()
        setTargetFps(60)
        StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.All, true)
        RunService:Set3dRenderingEnabled(true)
    end)
    
    -- 7. Удаляем весь интерфейс ScreenGui
    if ScreenGui and ScreenGui.Parent then
        ScreenGui:Destroy()
    end
    
    print("[MM2 AIO] Скрипт полностью остановлен и выгружен из памяти.")
end

-- Привязываем клик крестика к завершению скрипта
BindClick(CloseBtn, TerminateScript)
