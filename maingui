-- === ПРОВЕРКА ЛИМИТА СУМКИ ===
local function IsBagFull()
    return BagIsFull
end

local function isCoinTouched(coin)
    return rt.touchedCoins[coin] ~= nil
end

local function markCoinAsPending(coin)
    if not rt then return end
    rt.touchedCoins[coin] = "pending"
    rt.cachedCoins[coin] = nil
end

-- === БЕЗОТКАЗНЫЙ ПОИСК МОНЕТ ===
local function PopulateCoins()
    table.clear(rt.cachedCoins)
    if not rt.coinContainer then return end

    if rt.Added then rt.Added:Disconnect() end
    if rt.coinRemovedConn then
        rt.coinRemovedConn:Disconnect()
        rt.coinRemovedConn = nil
    end

    local function checkAndAdd(node)
        if node:IsA("TouchTransmitter") and node.Parent and node.Parent:IsA("BasePart") then
            rt.cachedCoins[node.Parent] = true
        end
    end

    for _, desc in ipairs(rt.coinContainer:GetDescendants()) do
        checkAndAdd(desc)
    end

    rt.Added = rt.coinContainer.DescendantAdded:Connect(checkAndAdd)

    rt.coinRemovedConn = rt.coinContainer.ChildRemoved:Connect(function(child)
        local coin = child
        local data = rt.touchedCoins[coin]

        if not data and child:IsA("Model") then
            local primary = child.PrimaryPart or child:FindFirstChildWhichIsA("BasePart")
            if primary and rt.touchedCoins[primary] == "pending" then
                coin = primary
                data = "pending"
            end
        end

        if data == "pending" then
            rt.touchedCoins[coin] = "collected"
            if IsBagFull() then BagIsFull = true end
        end
    end)
end

local function GetNearestCoin()
    local char = rt:Character()
    if not char or not char.PrimaryPart then return nil end

    local pos = char.PrimaryPart.Position
    local nearestCoin = nil
    local minDist = math.huge

    for coin, _ in pairs(rt.cachedCoins) do
        if coin and coin.Parent and not isCoinTouched(coin) then
            local dist = (coin.Position - pos).Magnitude
            if dist < minDist then
                minDist = dist
                nearestCoin = coin
            end
        else
            rt.cachedCoins[coin] = nil
        end
    end

    return nearestCoin
end

local function BindClick(guiElement, callback)
    local debounce = false
    local function fire()
        if debounce or IsTerminated then return end
        debounce = true
        task.spawn(callback)
        task.wait(0.15)
        debounce = false
    end
    guiElement.Activated:Connect(fire)
    guiElement.MouseButton1Click:Connect(fire)
    guiElement.TouchTap:Connect(fire)
end

-- === УНИВЕРСАЛЬНЫЙ UI-ПАРСЕР СУМКИ ===
local function SetupBagParser()
    task.spawn(function()
        local playerGui = LocalPlayer:WaitForChild("PlayerGui", 15)
        if not playerGui then return end

        local function hookContainer(container: Instance)
            local function bindToCurrencyBag(bagFrame: Instance)
                if not bagFrame:IsA("GuiObject") then return end

                local currencyFrame = bagFrame:WaitForChild("CurrencyFrame", 5)
                local icon = currencyFrame and currencyFrame:WaitForChild("Icon", 5)
                local coinsLabel = icon and icon:WaitForChild("Coins", 5) :: TextLabel?
                local fullLabel = bagFrame:WaitForChild("Full", 5) :: TextLabel?

                if not coinsLabel or not fullLabel then return end

                local lastCount = tonumber(coinsLabel.Text) or 0

                local function checkFull()
                    if not bagFrame.Visible then return end
                    local count = tonumber(coinsLabel.Text) or 0
                    
                    -- Защита: в MM2 минимальная вместимость сумки составляет 40 монет.
                    -- Меньше 40 монет сумка ни при каких условиях не может быть полной!
                    if count < 40 then
                        BagIsFull = false
                        return
                    end

                    local isFull = false

                    -- 1. Проверяем плашку Full: она должна быть видима, непрозрачна и с текстом Full!
                    if fullLabel and fullLabel.Visible and fullLabel.TextTransparency < 1 and fullLabel.Text == "Full!" then
                        isFull = true
                    end

                    -- 2. Проверяем иконку полной сумки FullBagIcon
                    local fullBagIcon = bagFrame:FindFirstChild("FullBagIcon")
                    if fullBagIcon and fullBagIcon:IsA("ImageLabel") and fullBagIcon.Visible and fullBagIcon.ImageTransparency < 1 then
                        isFull = true
                    end

                    -- 3. Резервная проверка по лимиту вместимости
                    local isEvent = (bagFrame.Name ~= "Coin")
                    local maxLimit = 50
                    if isEvent then
                        maxLimit = 50 -- на ивентах лимит всегда 50 независимо от Elite
                    else
                        maxLimit = rt:IsElite() and 50 or 40
                    end

                    if count >= maxLimit then
                        isFull = true
                    end

                    BagIsFull = isFull
                end

                RegisterConnection(coinsLabel:GetPropertyChangedSignal("Text"):Connect(function()
                    if IsTerminated then return end
                    if not bagFrame.Visible then return end

                    local currentCount = tonumber(coinsLabel.Text) or 0
                    if currentCount > lastCount then
                        local gained = currentCount - lastCount
                        StatsData.CoinsCollected = StatsData.CoinsCollected + gained
                        BagCoinCount = currentCount
                        CurrentRoundCoins = currentCount
                        ActiveCurrencyName = bagFrame.Name
                    elseif currentCount < lastCount then
                        BagCoinCount = currentCount
                        CurrentRoundCoins = currentCount
                    end

                    lastCount = currentCount
                    checkFull()
                end))

                RegisterConnection(fullLabel:GetPropertyChangedSignal("Visible"):Connect(function()
                    if IsTerminated then return end
                    checkFull()
                end))

                RegisterConnection(fullLabel:GetPropertyChangedSignal("Text"):Connect(function()
                    if IsTerminated then return end
                    checkFull()
                end))

                RegisterConnection(bagFrame:GetPropertyChangedSignal("Visible"):Connect(function()
                    if IsTerminated then return end
                    if bagFrame.Visible then
                        ActiveCurrencyName = bagFrame.Name
                        BagCoinCount = tonumber(coinsLabel.Text) or 0
                        checkFull()
                    end
                end))

                if bagFrame.Visible then
                    ActiveCurrencyName = bagFrame.Name
                    BagCoinCount = tonumber(coinsLabel.Text) or 0
                    checkFull()
                end
            end

            for _, bag in ipairs(container:GetChildren()) do
                bindToCurrencyBag(bag)
            end

            RegisterConnection(container.ChildAdded:Connect(function(child)
                if IsTerminated then return end
                bindToCurrencyBag(child)
            end))
        end

        local function hookMainGui(mainGui: Instance)
            if mainGui.Name ~= "MainGUI" then return end
            local lobby = mainGui:WaitForChild("Lobby", 10)
            local dock = lobby and lobby:WaitForChild("Dock", 10)
            local coinBags = dock and dock:WaitForChild("CoinBags", 10)
            local container = coinBags and coinBags:WaitForChild("Container", 10)
            if container then
                hookContainer(container)
            end
        end

        local existingMain = playerGui:FindFirstChild("MainGUI")
        if existingMain then
            task.spawn(hookMainGui, existingMain)
        end

        RegisterConnection(playerGui.ChildAdded:Connect(function(child)
            if child.Name == "MainGUI" then
                task.spawn(hookMainGui, child)
            end
        end))
    end)
end

SetupBagParser()

-- === ДИНАМИЧЕСКИЙ ДОСТУП К ASSASSIN TARGET ===
local function GetTargetNameLabel(): TextLabel?
    local pGui = LocalPlayer:FindFirstChildOfClass("PlayerGui") or LocalPlayer:FindFirstChild("PlayerGui")
    if not pGui then return nil end

    -- 1. Точный путь из сканера интерфейса: MainGUI.Game.AssassinTarget.TargetName
    local mGui = pGui:FindFirstChild("MainGUI")
    if mGui then
        local gameObj = mGui:FindFirstChild("Game")
        if gameObj then
            local assassinTarget = gameObj:FindFirstChild("AssassinTarget")
            if assassinTarget then
                local label = assassinTarget:FindFirstChild("TargetName")
                if label and label:IsA("TextLabel") then
                    return label
                end
            end
        end
    end

    -- 2. Резервный поиск: AssassinTarget в любом месте PlayerGui
    local assassinTarget = pGui:FindFirstChild("AssassinTarget", true)
    if assassinTarget then
        local label = assassinTarget:FindFirstChild("TargetName")
        if label and label:IsA("TextLabel") then
            return label
        end
    end

    -- 3. Резервный поиск: любой TextLabel с именем TargetName
    local anyTargetName = pGui:FindFirstChild("TargetName", true)
    if anyTargetName and anyTargetName:IsA("TextLabel") then
        return anyTargetName
    end

    return nil
end

-- === ПОЛУЧЕНИЕ ТЕКУЩЕЙ ЦЕЛИ С ОЧИСТКОЙ СКОБОК И ПРЕФИКСОВ ===
local function GetCurrentTarget(): (Player?, string?)
    local label = GetTargetNameLabel()
    if not label then
        return nil, "UI TargetName не найден"
    end

    local rawName = label.Text
    if not rawName or rawName == "" or rawName == "Label" or rawName == "None" then
        return nil, "Текст цели пуст"
    end

    -- ВАЖНО: Очищаем текст от скобок [ ], кавычек, префиксов и пробелов!
    -- Сканер выдаёт строку вида "[shinysummit157]", поэтому квадратные скобки обязательно снимаем
    local targetName = rawName
    targetName = string.gsub(targetName, "%[", "")
    targetName = string.gsub(targetName, "%]", "")
    targetName = string.gsub(targetName, "[\"\'%(%)]", "")
    targetName = string.gsub(targetName, "^%s*[Tt]arget[:%s]*", "")
    targetName = string.gsub(targetName, "^%s*[Ee]liminate[:%s]*", "")
    targetName = string.gsub(targetName, "^%s*@?", "")
    targetName = string.gsub(targetName, "^%s*(.-)%s*$", "%1")

    if targetName == "" or targetName == "None" or targetName == "Label" then
        return nil, "Имя пусто после очистки"
    end

    -- 1. Точный поиск по Name (Username)
    local targetPlayer = Players:FindFirstChild(targetName)

    -- 2. Регистронезависимый поиск по Name и точный поиск по DisplayName
    if not targetPlayer then
        local lowerTarget = string.lower(targetName)
        for _, pl in ipairs(Players:GetPlayers()) do
            if pl ~= LocalPlayer then
                if string.lower(pl.Name) == lowerTarget or string.lower(pl.DisplayName) == lowerTarget then
                    targetPlayer = pl
                    break
                end
            end
        end
    end

    -- 3. Частичный поиск (если имя обрезано интерфейсом)
    if not targetPlayer then
        local lowerTarget = string.lower(targetName)
        for _, pl in ipairs(Players:GetPlayers()) do
            if pl ~= LocalPlayer then
                if string.find(string.lower(pl.Name), lowerTarget, 1, true)
                   or string.find(string.lower(pl.DisplayName), lowerTarget, 1, true) then
                    targetPlayer = pl
                    break
                end
            end
        end
    end

    if not targetPlayer then
        return nil, "Игрок '" .. targetName .. "' не в игре"
    end

    -- Проверяем персонаж цели
    local char = targetPlayer.Character
    if not char then
        return nil, "Персонаж " .. targetName .. " не загружен"
    end

    local hum = char:FindFirstChildOfClass("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso") or char.PrimaryPart
    if not hum or hum.Health <= 0 then
        return nil, targetName .. " мертв(а)"
    end
    if not hrp then
        return nil, "У " .. targetName .. " нет HRP/Torso"
    end

    return targetPlayer, targetName
end

-- === ПОИСК СЕТЕВЫХ СОБЫТИЙ (REMOTES) ===
local function FindRemoteEvent(name: string): RemoteEvent?
    local direct = ReplicatedStorage:FindFirstChild(name)
    if direct and direct:IsA("RemoteEvent") then return direct end
    local deep = ReplicatedStorage:FindFirstChild(name, true)
    if deep and deep:IsA("RemoteEvent") then return deep end
    for _, item in ipairs(ReplicatedStorage:GetDescendants()) do
        if item:IsA("RemoteEvent") and item.Name == name then
            return item
        end
    end
    return nil
end

-- === УПРАВЛЕНИЕ ОРУЖИЕМ (ПОИСК, ЭКИПИРОВКА И СКРЫТИЕ НОЖА) ===
local function GetKnife(): Tool?
    local char = LocalPlayer.Character or rt:Character()
    if char then
        for _, item in ipairs(char:GetChildren()) do
            if item:IsA("Tool") and (item.Name == "Knife" or string.find(string.lower(item.Name), "knife")) then
                return item
            end
        end
    end

    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack") or LocalPlayer:FindFirstChild("Backpack")
    if backpack then
        local knife = backpack:FindFirstChild("Knife") :: Tool?
        if knife and knife:IsA("Tool") then return knife end
        for _, item in ipairs(backpack:GetChildren()) do
            if item:IsA("Tool") and (item.Name == "Knife" or string.find(string.lower(item.Name), "knife")) then
                return item
            end
        end
    end
    return nil
end

local function EquipKnife(): Tool?
    local knife = GetKnife()
    if not knife then return nil end
    local char = LocalPlayer.Character or rt:Character()
    if char and knife.Parent ~= char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then pcall(function() hum:EquipTool(knife) end) end
        task.wait(0.02)
    end
    return knife
end

local function UnequipKnife()
    local char = LocalPlayer.Character or rt:Character()
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum then
        pcall(function() hum:UnequipTools() end)
    end
end

-- === ТУРБО-УДАР (DOUBLE-PULSE FIRETOUCH) ===
local function TurboKill(targetPlayer: Player, knife: Tool): boolean
    local targetChar = targetPlayer.Character
    if not targetChar then return false end

    local targetHRP = targetChar:FindFirstChild("HumanoidRootPart") or targetChar:FindFirstChild("Torso") :: BasePart?
    local targetHum = targetChar:FindFirstChildOfClass("Humanoid")
    local handle = knife:FindFirstChild("Handle") :: BasePart?

    if not targetHRP or not targetHum or targetHum.Health <= 0 or not handle then
        return false
    end

    pcall(function() knife:Activate() end)

    if firetouchinterest then
        pcall(function()
            firetouchinterest(targetHRP, handle, 0)
            firetouchinterest(targetHRP, handle, 1)
            firetouchinterest(targetHRP, handle, 0)
            firetouchinterest(targetHRP, handle, 1)
        end)
        return true
    end
    return false
end

-- === ПОДСЧЕТ ЖИВЫХ ИГРОКОВ В РАУНДЕ (ДЛЯ СОЛО РЕЖИМА) ===
local function CountAliveRoundPlayers(): number
    local count = 0
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr:GetAttribute("Alive") == true then
            local char = plr.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then
                count = count + 1
            elseif not hum and char then
                count = count + 1
            end
        end
    end
    return count
end

-- === ПРОВЕРКА НА ИСКЛЮЧЕНИЕ (ТВИНК) ===
local function IsExceptionTarget(targetName: string, targetPlayer: Player?): boolean
    if SETTINGS.TwinException == "" then return false end
    local lowerExp = string.lower(SETTINGS.TwinException)

    if string.lower(targetName) == lowerExp then return true end

    if targetPlayer then
        if string.lower(targetPlayer.Name) == lowerExp then return true end
        if string.lower(targetPlayer.DisplayName) == lowerExp then return true end
    end

    return false
end

local function FindPlayerByCleanName(cleanName: string): Player?
    if cleanName == "" or cleanName == "Label" or cleanName == "None" then return nil end

    local direct = Players:FindFirstChild(cleanName)
    if direct then return direct end

    local lower = string.lower(cleanName)
    for _, pl in ipairs(Players:GetPlayers()) do
        if pl ~= LocalPlayer then
            if string.lower(pl.Name) == lower or string.lower(pl.DisplayName) == lower then
                return pl
            end
        end
    end
    return nil
end

local function IsTargetVisible(label: TextLabel?): boolean
    if not label or not label.Visible then return false end
    local parent = label.Parent
    return parent ~= nil and parent:IsA("GuiObject") and parent.Visible
end

local function CleanNickname(raw: string): string
    if not raw then return "" end
    local cleaned = raw
    cleaned = string.gsub(cleaned, "%[", "")
    cleaned = string.gsub(cleaned, "%]", "")
    cleaned = string.gsub(cleaned, "[\"\'%(%)]", "")
    cleaned = string.gsub(cleaned, "^%s*[Tt]arget[:%s]*", "")
    cleaned = string.gsub(cleaned, "^%s*[Ee]liminate[:%s]*", "")
    cleaned = string.gsub(cleaned, "^%s*@?", "")
    cleaned = string.gsub(cleaned, "^%s*(.-)%s*$", "%1")
    return cleaned
end

-- === ПРЕДВАРИТЕЛЬНАЯ ЗАЧИСТКА В НАЧАЛЕ РАУНДА ===
local function PreRoundKillChain()
    if isKillRunning then return end
    isKillRunning = true
    UpdateStatus("Зачистка: старт фазы боя", Color3.fromRGB(255, 90, 90))

    local knife = EquipKnife()
    if not knife then
        isKillRunning = false
        return
    end

    local stopRequested = false
    local roundEndRemote = FindRemoteEvent("RoundEndFade")
    local changeTargetRemote = FindRemoteEvent("ChangeTarget")

    local endConn: RBXScriptConnection? = nil
    if roundEndRemote then
        endConn = roundEndRemote.OnClientEvent:Connect(function()
            stopRequested = true
        end)
    end

    local function CheckAndAttack(targetName: string, targetUserId: number?)
        if stopRequested or not isKillRunning or IsTerminated then return end

        local targetPlr: Player? = nil
        if targetUserId and targetUserId > 0 then
            targetPlr = Players:GetPlayerByUserId(targetUserId)
        end
        if not targetPlr and targetName ~= "" then
            targetPlr = FindPlayerByCleanName(targetName)
        end

        -- 1. Режим с Твинком: проверка ника исключения
        if SETTINGS.TwinMode and IsExceptionTarget(targetName, targetPlr) then
            stopRequested = true
            UpdateStatus("Зачистка: упёрся в Твинка -> старт фарма", Color3.fromRGB(100, 255, 120))
            UnequipKnife()
            return
        end

        -- 2. Режим Соло: проверка количества оставшихся игроков (оставляем 1 соперника)
        if not SETTINGS.TwinMode then
            local aliveCount = CountAliveRoundPlayers()
            if aliveCount <= 2 then
                stopRequested = true
                UpdateStatus("Зачистка: остался 1 соперник -> старт фарма", Color3.fromRGB(100, 255, 120))
                UnequipKnife()
                return
            end
        end

        -- 3. Атака цели
        if targetPlr and targetPlr.Character then
            knife = EquipKnife() or knife
            if knife then
                UpdateStatus("Зачистка: удар по " .. targetPlr.DisplayName, Color3.fromRGB(255, 80, 80))
                TurboKill(targetPlr, knife)
            end
        end
    end

    local netConn: RBXScriptConnection? = nil
    if changeTargetRemote then
        netConn = changeTargetRemote.OnClientEvent:Connect(function(tName: any, _, _, tId: any)
            local nameStr = typeof(tName) == "string" and tName or ""
            local idNum = typeof(tId) == "number" and tId or 0
            CheckAndAttack(nameStr, idNum)
        end)
    end

    -- Сразу атакуем текущую цель из UI (так как ChangeTarget мог прийти ещё до конца разминки)
    local initialLabel = GetTargetNameLabel()
    if initialLabel and IsTargetVisible(initialLabel) then
        local clean = CleanNickname(initialLabel.Text)
        if clean ~= "" and clean ~= "Label" and clean ~= "None" then
            CheckAndAttack(clean, nil)
        end
    end

    -- Watchdog цикла зачистки (до 15 секунд или до достижения условия остановки)
    local startT = tick()
    while not stopRequested and not IsTerminated and SETTINGS.AutoFarmEnabled and (tick() - startT < 15) do
        task.wait(0.06)

        if not rt:CheckIfPlayerWasInARound() or not rt:Map() then
            break
        end

        -- Проверка количества выживших в соло режиме
        if not SETTINGS.TwinMode and CountAliveRoundPlayers() <= 2 then
            stopRequested = true
            UpdateStatus("Зачистка: остался 1 соперник -> старт фарма", Color3.fromRGB(100, 255, 120))
            UnequipKnife()
            break
        end

        -- Резервная проверка UI (если таргет сменился, но ремоут не сработал)
        local label = GetTargetNameLabel()
        if label and IsTargetVisible(label) then
            local clean = CleanNickname(label.Text)
            if clean ~= "" and clean ~= "Label" and clean ~= "None" then
                if SETTINGS.TwinMode and IsExceptionTarget(clean, nil) then
                    stopRequested = true
                    UpdateStatus("Зачистка: в UI ник Твинка -> старт фарма", Color3.fromRGB(100, 255, 120))
                    UnequipKnife()
                    break
                else
                    local plr = FindPlayerByCleanName(clean)
                    if plr and plr.Character then
                        local hum = plr.Character:FindFirstChildOfClass("Humanoid")
                        if hum and hum.Health > 0 then
                            knife = EquipKnife() or knife
                            if knife then TurboKill(plr, knife) end
                        end
                    end
                end
            end
        end
    end

    if netConn then netConn:Disconnect() end
    if endConn then endConn:Disconnect() end

    UnequipKnife()
    isKillRunning = false
    task.wait(0.1)
end

-- === ДОБИВАНИЕ ОСТАВШЕЙСЯ ЦЕЛИ ПРИ ПОЛНОЙ СУМКЕ (РЕЖИМ KILL ALL) ===
local function FinishKillRemainingTargets()
    isKillRunning = true
    UpdateStatus("Сумка полна: добивание для победы...", Color3.fromRGB(255, 60, 60))
    local knife = EquipKnife()
    if not knife then return end

    local finishStart = tick()
    while not IsTerminated and (tick() - finishStart < 8) and rt:CheckIfPlayerWasInARound() and rt:Map() do
        knife = EquipKnife() or knife
        local label = GetTargetNameLabel()
        local raw = label and label.Text or ""
        local clean = CleanNickname(raw)

        local targetPlr = FindPlayerByCleanName(clean)
        if targetPlr and targetPlr.Character then
            if knife then TurboKill(targetPlr, knife) end
        end
        task.wait(0.08)
    end
    UnequipKnife()
    isKillRunning = false
end

